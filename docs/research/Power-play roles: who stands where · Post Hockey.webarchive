e",data:s,fill:"#ef4444",r:3})]})})}),(0,a.jsxs)("p",{className:"text-xs text-ink-faint mt-2",children:["Top ",200," skaters by Net Rating, ",(0,h.fmtSeason)(0x135057a),", at least ",20," GP. Goalies are not included."]})]})}var ey=s(16533),ew=(0,er.gu)({chartName:"BarChart",GraphicalChild:ey.y,defaultTooltipEventType:"axis",validateTooltipEventTypes:["axis","item"],axisComponents:[{axisType:"xAxis",AxisComp:el.W},{axisType:"yAxis",AxisComp:eh.h}],formatAxisMap:ec.pr});function ev(){let[e,t]=(0,n.useState)([]),[s,o]=(0,n.useState)(0),[r,i]=(0,n.useState)(!0);return(0,n.useEffect)(()=>{(0,l.Sc)({stat:"xgf_shooter_adj",season:0x135057a,strength:"5v5",sort_dir:"desc",limit:32}).then(e=>{let s=e.rows.map(e=>{var t;return{team_abbreviation:null!=(t=e.team_abbreviation)?t:"",xgf_per_gp:e.games_played>0&&null!=e.xgf_shooter_adj?e.xgf_shooter_adj/e.games_played:0}}).sort((e,t)=>e.xgf_per_gp-t.xgf_per_gp),a=s.length>0?s.reduce((e,t)=>e+t.xgf_per_gp,0)/s.length:0;t(s),o(a)}).finally(()=>i(!1))},[]),(0,a.jsxs)(h.Section,{title:"Per-team pace adjustment",id:"pace-adjustment",children:[(0,a.jsx)("p",{children:"Teams do not create chances at the same rate, so a player‚Äôs on-ice numbers are compared with what we would expect for his team as well as the league: half the league rate, half his team‚Äôs. Each bar is a team‚Äôs 5v5 xGF(sh) per game this season; the red line is the league average."}),r?(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}):0===e.length?(0,a.jsx)("p",{className:"text-ink-faint",children:"No team data available."}):(0,a.jsx)("div",{className:"w-full h-[600px]",children:(0,a.jsx)(eo.u,{width:"100%",height:"100%",children:(0,a.jsxs)(ew,{data:e,layout:"vertical",margin:{top:8,right:24,left:8,bottom:8},children:[(0,a.jsx)(ep.d,{strokeDasharray:"3 3",horizontal:!1}),(0,a.jsx)(el.W,{type:"number",dataKey:"xgf_per_gp",domain:["auto","auto"],tickFormatter:e=>e.toFixed(2),label:{value:"xGF(sh) per game (5v5)",position:"insideBottom",offset:-2,fontSize:11}}),(0,a.jsx)(eh.h,{type:"category",dataKey:"team_abbreviation",width:40,tick:{fontSize:11}}),(0,a.jsx)(eu.m,{formatter:e=>e.toFixed(3),labelFormatter:e=>e}),(0,a.jsx)(eg.e,{x:s,stroke:"#ef4444",label:{value:"League avg",fill:"#ef4444",fontSize:11}}),(0,a.jsx)(ey.y,{dataKey:"xgf_per_gp",fill:"#475569",radius:[0,2,2,0]})]})})}),(0,a.jsx)("p",{children:"A skater on a team near the top has a higher bar to clear before his on-ice numbers count as above average; a skater near the bottom has a lower one. This moves every player on a team together. The ice-time adjustment below is separate and individual."})]})}let ej={forwardPctPerMinute:2.11,defensemanPctPerMinute:1.25,creditSpreadPoints:5},ek={leakRemovedPct:"34",leakRemovedLoPct:"19",leakRemovedHiPct:"97",gameFoldPct:"16"};function e_(){return(0,a.jsxs)(h.Section,{title:"What we changed from Dom",id:"context-and-pace",children:[(0,a.jsx)("p",{children:"Two departures from the 2019 formula."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"We dropped the quality-of-competition and quality-of-teammates multiplier from our first version."})," We tested it against next-season predictions and it did no better than leaving it out. It also charged stars for having good linemates."]}),(0,a.jsxs)("p",{children:["We tested the idea again in September 2026, against a version built from an approach"," ","Dom Luszczyszyn shared with us directly",". It found real evidence of the effect for forwards, not defensemen ‚Äî but even for forwards it predicted next season slightly worse than leaving it out, so the rating still carries no quality-of-competition adjustment."]}),(0,a.jsxs)(h.Why,{summary:"Why we dropped it: the test and what it found",children:[(0,a.jsx)("p",{children:"Our first version carried a per-game context multiplier of our own construction: credit nudged up when a player‚Äôs opponents were more heavily used than his teammates, both measured by share of ice time, and trimmed when the opposite was true. It was our reading of the idea that some minutes are harder than others. It was not Dom‚Äôs own difficulty measure, which is built differently and rates players differently. We shipped it, flagged the coefficient as hand-set and provisional, and said we‚Äôd calibrate it properly. We did ‚Äî and it didn‚Äôt survive the test."}),(0,a.jsx)("p",{children:"Three separate tests, all pointing the same way. Dropping the multiplier equalled or beat keeping it on every individual predictive target we checked. It improved next-season team goal-differential prediction, .612 to .617, with a bootstrap confidence interval that excludes zero. And it moved the league mean of team rating sums from ‚àí5.5 toward the theoretical zero, landing at ‚àí2.1. Doubling the multiplier‚Äôs strength made every one of those numbers worse ‚Äî which is the signature of an adjustment that adds noise rather than signal, not one that‚Äôs merely under-tuned."}),(0,a.jsx)("p",{children:"It also failed on inspection. Teammate quality varies over a much wider range than competition faced, and a star‚Äôs linemates are fixed for stretches of a season while his opponents average out over it. Our multiplier scored difficulty as opponents‚Äô ice-time share minus teammates‚Äô. Nathan MacKinnon‚Äôs opponents were heavily used (the 76th to 97th percentile of forwards from 2021-22 to 2025-26), but his linemates were used even more (98th to 100th), so the multiplier ranked his job among the easiest: the bottom 1% of forwards in every season from 2021-22 to 2024-25, and the 5th percentile in 2025-26. It was charging him for having good linemates, a thing his rating already counts as their production, not a debt against his own. That is not a small edge case; it is what the multiplier does to exactly the players it is supposed to be fairest to. Today‚Äôs rating uses no such measure; the ice-time pace adjustment below replaced it."}),(0,a.jsxs)("p",{children:["That test was of our multiplier, not of the idea. So we tested the idea again, in September 2026, with a design written down before any result existed."," ",(0,a.jsx)(a.Fragment,{children:"Dom Luszczyszyn shared with us an updated weight set and his own context adjustment."})," ","The adjustment splits quality into offense and defense rather than using share of ice time, since a defensive-role player and an offensive-role player can log similar minutes against very different matchups. Teammate quality is measured against the teammate quality expected from how good the player and his team are, and only the difference is used, which strips out what the rating already carries from good linemates. The effects of competition and teammates are fitted game by game (a faint signal, over many games, that weaker competition raises a player‚Äôs Game Score) and applied as a per-game adjustment. For past seasons the ratings are run once unadjusted and once adjusted; during a season the adjustment is iterated."," ","We rebuilt that approach as closely as our data allowed. Our reconstruction does not yet reproduce the worked examples we were given, so what follows is a finding about our version of the idea, not about anyone else‚Äôs method."]}),(0,a.jsxs)("p",{children:["The updated weights lost: they read forwards slightly better and defensemen worse, and the defense cost was the larger. The context question was whether a player coming off a good situation, with strong linemates and soft opposition, is overrated the next season. For forwards he is; for defensemen we found no such effect. Our version of the adjustment rates each teammate and opponent from games without the player in question, and is iterated until the ratings settle. On our own weights it removed about"," ",ek.leakRemovedPct,"% of the forwards‚Äô carried-over credit (90% interval"," ",ek.leakRemovedLoPct,"% to ",ek.leakRemovedHiPct,"%). But it predicted next season slightly worse, for players and for teams, and it agreed slightly less with a competition-matched measure of how players did against opponents of similar quality. In the first round, on the updated weight set, a single-pass version built the other way, with context rated from other nights rather than other players, removed only about"," ",ek.gameFoldPct,"%, so the size of the effect depends on how context is measured. So the rating keeps the ice-time pace adjustment below and carries no quality-of-competition adjustment."]})]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"We added an ice-time pace adjustment, on defense only."})," A player who plays heavy minutes faces faster, stronger competition, so the chances we expect against him rise"," ",(0,a.jsxs)("strong",{children:[ej.forwardPctPerMinute,"%"]})," per extra minute of 5v5 ice time for a forward and ",(0,a.jsxs)("strong",{children:[ej.defensemanPctPerMinute,"%"]})," for a defenseman, above his position‚Äôs average. The idea is Dom‚Äôs; we measured it before adopting it. The worked example above shows it as its own line. It also means a player who slides down the lineup gets no credit for the easier minutes: the bar drops with the minutes, so the credit does too."]}),(0,a.jsxs)("p",{children:["The credit is real but small: about ",ej.creditSpreadPoints," points of Net Rating from best to worst in 2025-26, which is not enough to reorder the league."]}),(0,a.jsxs)(h.Why,{summary:"Why it holds up, and where it is weak",children:[(0,a.jsx)("p",{children:"A player‚Äôs expected on-ice chances against now scale with his own 5v5 ice time. That is distinct from the per-team pace blend above: that one anchors a player‚Äôs baseline to his team‚Äôs scoring rate; this one anchors his defensive baseline to his own deployment. Bigger minutes are faster minutes: top-line players face other top lines, fourth-liners face other fourth-liners, and the chances-against expectation should reflect that before we count what a player did about it."}),(0,a.jsxs)("p",{children:["The whole argument is that the effect being adjusted for is the environment, not the player. Using player fixed effects across those 9,423 player-seasons, when the"," ",(0,a.jsx)("em",{children:"same"})," player‚Äôs ice time changes, his on-ice xGA(sh)/60 relative to team moves by 88% (forwards) to 100% (defensemen) of the gap you‚Äôd see comparing different players at different ice times. An independent event study on the ~870 players whose ice time moved 1.5+ minutes within the same team gives 0.75‚Äì1.05 ‚Äî the same range, from a different design. The constant is measured from within-player variation, not inferred from comparing different players who might simply differ in ways the model doesn‚Äôt see."]}),(0,a.jsxs)("p",{children:["The chances-",(0,a.jsx)("em",{children:"for"})," side is deliberately left untouched. Only about two-thirds of the ice-time-vs-pace relationship on offense is environment; the rest is that better offensive players earn the bigger minutes in the first place. Adjusting for it would take away credit those players earned. Offense stays exactly as it was, bit for bit."]}),(0,a.jsx)("p",{className:"font-medium",children:"Caveats, stated plainly:"}),(0,a.jsxs)("ul",{className:"list-disc ml-6 space-y-1",children:[(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Defensemen come out slightly over-corrected."})," Their within-player slope is a shade steeper than the across-player one used to set the constant, and it shows: Def now correlates +0.13 with ice time for defensemen, versus 0.00 for forwards. That‚Äôs within noise, and we‚Äôre watching it rather than re-fitting on a single observation."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"The constant is refit annually on the pooled panel"}),", not per season ‚Äî a per-season refit adds more noise than it removes. Leaving any single season out of the panel moves the constant by about 10%, which is the honest size of its uncertainty."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Tied to the current xG model."})," 