s not its main cause. Defencemen take about 40% of their shots from 55 ft or beyond, and the 60‚Äì65 ft band still runs 7% high."})]})]}):(0,a.jsx)("p",{className:"text-ink-faint",children:"Calibration data unavailable."})]})}var tw=s(69386);function tv(){let[e,t]=(0,n.useState)(null),[s,o]=(0,n.useState)(!0);(0,n.useEffect)(()=>{(0,eV.W)("xg/feature_importance.json").then(t).catch(()=>t(null)).finally(()=>o(!1))},[]);let r=e?[...e.ablation].sort((e,t)=>t.delta_logloss-e.delta_logloss):[];return(0,a.jsxs)(h.Section,{title:"Feature ablation",id:"xg-ablation",children:[(0,a.jsx)("p",{children:"Each row drops one feature (or feature group) and re-scores the test set. Œî log-loss measures how much worse the model gets ‚Äî larger is more important. Negative values mean the model is marginally better without the feature (noise features that the L2 penalty doesn't fully suppress)."}),s?(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}):e?(0,a.jsxs)(a.Fragment,{children:[(0,a.jsx)("div",{className:"w-full h-[340px] mt-4",children:(0,a.jsx)(eo.u,{width:"100%",height:"100%",children:(0,a.jsxs)(ew,{data:r,layout:"vertical",margin:{top:8,right:40,left:8,bottom:8},children:[(0,a.jsx)(ep.d,{strokeDasharray:"3 3",horizontal:!1}),(0,a.jsx)(el.W,{type:"number",dataKey:"delta_logloss",tickFormatter:e=>e.toFixed(4),label:{value:"Œî log-loss (higher = more important)",position:"insideBottom",offset:-2,fontSize:11}}),(0,a.jsx)(eh.h,{type:"category",dataKey:"dropped",width:120,tick:{fontSize:11,fontFamily:"monospace"}}),(0,a.jsx)(eu.m,{formatter:e=>[e.toFixed(5),"Œî log-loss"],labelFormatter:e=>"Drop: ".concat(e)}),(0,a.jsx)(eg.e,{x:0,stroke:"#94a3b8"}),(0,a.jsx)(ey.y,{dataKey:"delta_logloss",radius:[0,2,2,0],children:r.map(e=>(0,a.jsx)(tw.f,{fill:e.delta_logloss>=0?"#3b82f6":"#f87171"},e.dropped))})]})})}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Full table"}),(0,a.jsxs)("table",{className:"w-full text-sm border border-rule",children:[(0,a.jsx)("