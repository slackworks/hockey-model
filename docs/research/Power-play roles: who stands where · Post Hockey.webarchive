,{className:"border-l-2 border-rule-strong pl-5 my-10",children:[(0,a.jsx)("div",{className:"dateline mb-2",children:"Credit"}),(0,a.jsx)("p",{className:"text-ink-soft",children:"None of this exists without Dom Luszczyszyn. Net Rating is his: the Game Score split, the position-specific weights, the per-team pace adjustment and the goals-above-average scale, first as GSVA and then in the 2019 formula. What we built is an implementation of his idea on our own data. Where we departed from him we say so and say why. The ice-time pace adjustment on the defensive side was his suggestion to us; we measured it and it held up. Dropping his quality-of-competition multiplier was our own call, after testing."})]}),(0,a.jsx)(h.Toc,{items:eT}),(0,a.jsx)(L,{}),(0,a.jsx)(Q,{}),(0,a.jsx)(en,{}),(0,a.jsx)(eb,{}),(0,a.jsx)(ev,{}),(0,a.jsx)(e_,{}),(0,a.jsxs)("section",{id:"limitations",className:"mb-12 scroll-mt-20",children:[(0,a.jsx)("p",{className:"dateline section-rule mt-12 mb-2",children:"What to be careful about"}),(0,a.jsxs)("ul",{className:"list-disc ml-6 space-y-2 my-3 text-ink-soft",children:[(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"The defensive half is the noisier half."})," Blocks and penalties are small numbers per game, and on-ice defense is noisier than offense at the season level."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Defensemen run slightly over-corrected"})," by the ice-time adjustment. It is within noise and we are watching it; the details are in the caveats above."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Part of the number travels with the team."})," When a player changes teams, Net Rating predicts his next season worse. For forwards, its correlation with next-season 5v5 goal differential (relative to team) is .39 for players who stayed and .29 for players who moved. The on-ice part of the rating never travels better than the individual part, and in three of the four comparisons it travels substantially worse, up to twice as badly (share of signal lost, on-ice against individual: next-season goal differential, forwards 41.5% against 19.7%, defencemen 37.0% against 28.5%; next-season points, forwards 15.5% against 15.4%, defencemen 26.3% against 13.4%). A player and his team never move apart while he stays, so a trade is the one natural experiment that separates them, and it says the on-ice part is the part that belongs partly to the team."]})]})]}),(0,a.jsxs)(h.Appendix,{title:"Formulas, weights and the April check",intro:"Reference material. Each drawer opens on its own.",children:[(0,a.jsx)(h.Why,{summary:"The formulas, step by step",children:(0,a.jsx)(q,{})}),(0,a.jsx)(h.Why,{summary:"Position weights",children:(0,a.jsx)(Z,{})}),(0,a.jsx)(h.Why,{summary:"Check against Dom's published ratings (April 2026, not the current formula)",children:(0,a.jsx)(eN,{})})]})]})}let eG=["CF/CA","Tango 2014","xG(sh)","xG(sh+sv)","wxG"],eF={offence:[.3484,.392,.4643,.4635,.4451],defence:[.2279,.2721,.2421,.2749,.2859]},eA={raw:[.2279,.2721,.2421,.2749,.2859],neutral:[.1975,.2199,.2347,.1967,.2309]},eW=["CF/CA","Goals","Tango 2014","xG(sh)","xG(sh+sv)","wxG"],eP=[["5v5 / offence",.872,.554,.861,.883,.88,.828],["5v5 / defence",.754,.373,.739,.671,.732,.624],["pp / offence",.604,.525,.613,.719,.713,.666],["pk / defence",.55,.345,.533,.422,.459,.456]],eM={raw:{corsi:.2098,tango:.215,flagship:.2063},neutral:{corsi:.2067,tango:.2086,flagship:.2083}},eE={corsi:0,tango:1,flagship:2,full:3,wxg:4},eO=e=>e.toFixed(2),eD=e=>e.toFixed(4),ez={raw:"Raw future goals",neutral:"Goalie removed from the target"},eR=Math.ceil(20*Math.max(...eA.raw,...eA.neutral))/20;function eI(e){return e.indexOf(Math.max(...e))}function eC(){let[e,t]=(0,n.useState)("raw"),s=eA[e],o=eI(s),r=eG[eI(eA.raw)],i=eG[eI(eA.neutral)],l=eA.raw[eE.full],h=eA.neutral[eE.full];return(0,a.jsxs)("figure",{className:"my-6 border border-rule rounded-sm p-4 bg-paper",children:[(0,a.jsxs)("div",{className:"flex flex-wrap items-center g