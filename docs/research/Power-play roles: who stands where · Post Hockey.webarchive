n input times a weight, in goals. The lines add to the subtotals; the subtotals, stretched to 84 games, are the rating. Nothing is left over."}),r&&(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}),!r&&(d||0===s.length)&&(0,a.jsx)("p",{className:"text-ink-faint",children:"Walk-through unavailable for current season ‚Äî try the leaderboard."}),!r&&s.length>0&&(0,a.jsx)("div",{className:"grid grid-cols-1 lg:grid-cols-2 gap-4",children:s.map(e=>(0,a.jsx)(et,{pick:e},e.label))}),m&&p?(0,a.jsxs)("p",{children:["Read them side by side. Off_RTG is ",es(m)," ",ea(m.last_name)," rating; it is ",es(p)," ",ea(p.last_name),". The forward is paid for what reaches the scoresheet. The defenseman is paid on the xGA(sh) line, where his position's weight is ",Math.abs(p.constants.onice_weights.xga)," against a forward's"," ",Math.abs(m.constants.onice_weights.xga),": a chance that never happened counts for more when preventing it is the job."]}):(0,a.jsx)("p",{children:"Forwards earn most of their rating on the scoresheet. Defensemen earn theirs on the xGA(sh) line, where the position weight is heaviest."})]})}var eo=s(26991),er=s(30390),ei=s(38156),el=s(47734),eh=s(73697),ed=s(95512),ec=s(36164),em=(0,er.gu)({chartName:"ScatterChart",GraphicalChild:ei.X,defaultTooltipEventType:"item",validateTooltipEventTypes:["item"],axisComponents:[{axisType:"xAxis",AxisComp:el.W},{axisType:"yAxis",AxisComp:eh.h},{axisType:"zAxis",AxisComp:ed.K}],formatAxisMap:ec.pr}),ep=s(68425),eu=s(23508),ef=s(7620),eg=s(48716);function ex(e){let{active:t,payload:s}=e;if(!t||!s||0===s.length)return null;let n=s[0].payload;return(0,a.jsxs)("div",{className:"bg-white border border-gray-200 rounded p-2 text-xs shadow",children:[(0,a.jsx)("p",{className:"font-semibold",children:n.name}),(0,a.jsxs)("p",{children:["Position: ",n.position]}),(0,a.jsxs)("p",{children:["Off_RTG: ",n.o_rating.toFixed(2)]}),(0,a.jsxs)("p",{children:["Def_RTG: ",n.d_rating.toFixed(2)]}),(0,a.jsxs)("p",{children:["Net_RTG: "