x-3 py-2 text-right font-medium",children:"Recall"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"Precision"})]})}),(0,a.jsx)("tbody",{className:"tabular-nums",children:n.per_slot.map(e=>(0,a.jsxs)("tr",{className:"border-b border-rule last:border-0",children:[(0,a.jsx)("td",{className:"px-3 py-1.5",children:e.slot}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:e.labelled}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(e.recall)}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(e.precision)})]},e.slot))})]})]}),(0,a.jsxs)(h.Section,{title:"The bar we set, and missed",id:"ppr-gates",children:[(0,a.jsxs)("p",{children:["Before fitting anything we wrote down what the model had to clear before we would publish it: the right top slot for at least ",a6(o.net_front_and_point)," of labelled net-front and point players, and the right side of the bumper-or-half-wall line for at least ",a6(o.bumper_vs_half_wall),". On the held-out half it managed"," ",a6(o.test_half.net_front_and_point)," of ",o.test_half.net_front_and_point_n," and"," ",a6(o.test_half.bumper_vs_half_wall)," of ",o.test_half.bumper_vs_half_wall_n,". It missed both."]}),(0,a.jsx)("p",{children:"We published it anyway, and said so here. It first ran as a panel on every player page; in October we moved it to team pages, unit by unit, because one label per player claims more than the model can back. The point and the half-walls are read well, and the percentages are honest about doubt (the confidence table above is the evidence). What does not clear the bar is the split between bumper and net-front, and which half-wall a player works. The unit grid shows that doubt rather than hiding it in a single word."})]}),(0,a.jsx)(h.Section,{title:"What it cannot do",id:"ppr-limits",children:(0,a.jsxs)("ul",{className:"list-disc pl-5 space-y-2",children:[(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"The bumper is the weakest slot."})," Its events overlap the net-front's in the low slot, and some units rotate the two. Several of the misses above are a bumper read as a net-front or the other way round, some of them players who alternate between the two."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"The side is often swapped."})," The half-wall share is reliable as a pair; which wall is less so. A one-timer from the right circle and a pass across from the left leave similar traces."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Events are not positions."})," A net-front player who steps out for a rebound shoots from the slot. The model reads where events cluster, not where a player stands between them."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Breakouts are invisible."})," Nothing in the data shows what happens between a faceoff and a shot, so drop passes and entries are not part of this. The roles describe the offensive-zone setup only."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Not every power play is a 1-3-1."})," An umbrella (two low, three high) still gets five slots from the model, the closest fit it can find."]})]})})]})}function a7(e){return"writeups"===e?"writeups":"glossary"}function ne(e){return"xg"===e?"xg":"archive"===e||"xg-star"===e||"wxg"===e?"archive":"ws"===e?"ws":"coefficients"===e?"coefficients":"a3z"===e?"a3z":"badges"===e?"badges":"goalie-forecast"===e?"goalie-forecast":"net-rating-forecast"===e?"net-rating-forecast":"blocked-shots"===e?"blocked-shots":"iwpa"===e?"iwpa":"game-score-plus"===e||"gs-plus"===e?"game-score-plus":"pp-roles"===e?"pp-roles":"net-rating"}function nt(){let e=(0,o.useRouter)(),t=(0,o.useSearchParams)(),[s,r]=(0,n.useState)(a7(t.get("tab"))),[i,l]=(0,n.useState)(ne(t.get("writeup")));function h(a){if(a===s)return;r(a);let n=new URLSearchParams(t.toString());"glossary"===a?(n.delete("tab"),n.delete("writeup")):n.set("tab",a);let o=n.toString();e.replace(o?"?".concat(o):"?",{scroll:!1})}return(0,n.us