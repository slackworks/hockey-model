py-1 px-1",children:[(0,a.jsx)(aQ,{g:e.grades.shutdown})," ",(0,a.jsxs)("span",{className:"font-mono tabular-nums text-xs",children:[aG(e.shut_R),", D ",aN(e.shut_top3_D)]})]}),(0,a.jsx)("td",{className:"py-1 pl-2 text-right font-mono tabular-nums",children:e.grades.points})]},e.code))})]})}),(0,a.jsxs)("figcaption",{className:"text-xs text-ink-faint mt-1 leading-snug",children:[s.games," games with official stars; ",s.shutdown_games," shutdown games (",s.shutdown_D_games," by defencemen), whose player the voters named a star ",aN(s.stars_named)," of the time (",aN(s.stars_named_D)," for defencemen). Settles: games until two samples agree at r = 0.7. Predicts: the grade is against the best of the three. Shutdown: top-three share over the voters' star share, and the share for defencemen alone."]})]})}let a1=[["gsp-number","The number"],["gsp-tests","Four tests"],["gsp-ours","Why not one of ours"],["gsp-fo-pen","Faceoffs and penalties"],["gsp-shutdown","The shutdown term"],["gsp-left-out","What we left out"],["gsp-test","The untouched season"],["gsp-card","On the card"],["gsp-offdef","Offence and defence"],["gsp-credits","Credits and limits"],["appendix","Appendix"]];function a3(){let{data:e,loading:t}=function(){let[e,t]=(0,n.useState)(null),[s,a]=(0,n.useState)(!0);return(0,n.useEffect)(()=>{let e=!0;return fetch("/data/game-score-plus/writeup.json").then(e=>e.ok?e.json():null).then(s=>{e&&t(s&&"post-hockey/game-score-plus-writeup/v1"===s.schema?s:null)}).catch(()=>e&&t(null)).finally(()=>e&&a(!1)),()=>{e=!1}},[]),{data:e,loading:s}}();return(0,a.jsxs)("article",{id:"game-score-plus-writeup",className:"prose-paper",children:[(0,a.jsxs)("header",{className:"mb-10",children:[(0,a.jsx)("div",{className:"dateline",children:"Writeups \xb7 Player value \xb7 The game card"}),(0,a.jsx)("h1",{className:"font-serif text-5xl font-bold tracking-tight mt-2 mb-3",children:"GS+: one number for one game"}),(0,a.jsx)("p",{className:"deck",children:"The game card needs a number that is ready at the final horn, means something after one night and agrees with the three stars. Dom Luszczyszyn built most of it in his Game Score. We changed four things."}),(0,a.jsx)(h.Byline,{})]}),(0,a.jsx)(h.Toc,{items:a1}),t&&(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}),!t&&!e&&(0,a.jsx)("p",{className:"text-ink-faint",children:"The writeup's data is unavailable."}),e&&(0,a.jsx)(a5,{d:e})]})}function a5(e){var t,s,n,o,r;let{d:i}=e,l=aA(i,"GS"),d=aA(i,"E1h"),c=aA(i,"NR"),m=i.stars_named_shutdown,p=i.tuning,u=i.k_star,f=i.k_readings,g=Object.values(f.local_quadratic),x=i.test_2223,b=x.rows.find(e=>"GS_plus"===e.code),y=x.rows.find(e=>"GS_noD"===e.code),w=x.rows.find(e=>"GS"===e.code),v=i.reliability,j=i.block_check,k=(r=i.xwpa_sweep.chosen_phase2,i.xwpa_sweep.points.reduce((e,t)=>Math.abs(t.w-r)<Math.abs(e.w-r)?t:e)),_=i.xwpa_sweep.points.find(e=>e.star_lines<6),N=i.shutdown_sweep,T=i.scorecard.rows.filter(e=>"GS"!==e.code&&6===e.star_lines).map(e=>e.label),S=i.scale,G=i.goal_scale,F=i.goalie,A=i.offdef,W=!!l&&i.scorecard.rows.every(e=>"GS"===e.code||e.first_star<l.first_star);return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)(h.Section,{title:"The number",id:"gsp-number",children:[(0,a.jsx)("p",{className:"drop-cap",children:"A hockey game leaves a box score and a shift chart. The game card has to turn them into one number per player before anyone has gone home, and the number has to survive the next morning's argument. In our tests the best starting point was not ours. It was Dom Luszczyszyn's Game Score, published at Hockey-Graphs in 2016: goals, assists, shots, blocks, penalties, faceoffs and the shot and goal differential while the player was on the ice, each with a fixed weight, in Dom's own unit, in which a goal scored is worth three quarters of a point."}),(0,a.jsx)("p",{children:"GS+ is that number with four changes. The faceoff term is replaced by what the player's draws are worth. The penalty term is replaced by the penalties he would be expected to draw and take. A shutdown term is added, which pays a skater for the opponents and the deployment he was handed. And part of his five-on-five credit is handed back to his team, below. Goalies get a line of their own. The two terms of Dom's that our changes replace were 0.01 (FOW ‚àí FOL) for faceoffs and 0.15 (PD ‚àí PT) for penalties. Then the whole thing is restated in goals."}),(0,a.jsx)(h.Formula,{lines:["GS+ = S \xf7 ".concat(S.divisor," + c t, in goals, where"),"","S = ".concat(S.dom.g," G + ").concat(S.dom.a1," A1 + ").concat(S.dom.a2," A2"),"  + 0.075 SOG + 0.05 BLK","  + 0.05 (CF ‚àí CA) + ".concat(S.dom.on_ice," (GF ‚àí GA)    5v5 on ice"),"  + ".concat(S.dom.g," (p ‚àí 0.5) Œ£ V                 faceoff value"),"  + 0.15 (ePD ‚àí ePT)                   GS+ penalty expectation","  + ".concat(S.dom.g," \xd7 ").concat(aF(u)," \xd7 D                    shutdown"),"  ‚àí \xbd B                                team line, 5v5","","Goalies: GS+ = T + k R, already in goals"]}),(0,a.jsxs)("p",{children:["Why ",S.divisor,": that is what a five-on-five goal with two assists hands out in Dom's units,"," ",S.dom.g," to the scorer, ",S.dom.a1," and ",S.dom.a2," to the assists and ",S.dom.on_ice," to each of the five skaters on the ice for it. Divide every weight by it and that goal is handed out as exactly one: ",aT(S.goals.g)," to the scorer, ",aT(S.goals.a1)," and"," ",aT(S.goals.a2)," to the assists, ",aT(S.goals.on_ice)," to each skater on the ice. A power-play goal or one with fewer assists hands out less, since Dom pays the on-ice credit at five-on-five only. The faceoff and shutdown terms, which we measure in goals, enter at a goal scored's weight, as in Dom's units; the expected-penalty term keeps his penalty weight; all are divided with the rest. Dividing every term by one number changes no ranking and none of the results below."]}),(0,a.jsx)("p",{children:"The team line is the last term. Dom's on-ice differentials pay a skater for every attempt and goal his team gets with him on the ice, and a good team gets plenty of those with anyone. So GS+ asks what his five-on-five minutes would have earned at the rate his team played that night with him on the bench, steadied by its rate over the season so far (forty minutes of it). That is B, his team baseline, on the same weights. Half of it is taken off him and kept as the team's line for the game: players and team line together add up to exactly what GS+ gave the players before. Each season's team lines are centred on the season before: c, in goals, is what last season's team lines came to per second of five-on-five, t is his five-on-five time, and adding c t back to every skater makes the lines net to about zero. It is small: a few hundredths of a goal in one game, one or two goals over a season, taken from players on good teams and given to players on bad ones."}),(0,a.jsxs)("p",{children:["Nothing forces a team's total to equal its goals. Shots, blocks, the on-ice shot and goal differentials, faceoffs and penalties all add or subtract, and the shutdown term sums to zero across a team. It comes close anyway. Over ",G.seasons,", the league's skaters and team lines added up to"," ",aG(G.league_ratio)," the league's goals. Game by game, a team's skaters and team line track its goals at r = ",G.r.toFixed(2),", missing by ",G.mean_abs_miss.toFixed(1)," goals on average: within one goal of the team's score in ",aN(G.within_1,0)," of ",G.n," team-games, within two in ",aN(G.within_2,0),". It is not a goal count: a team held scoreless still posts ",G.shutout_mean.toFixed(1)," on average, over"," ",G.shutout_n," such games.",G.players?(0,a.jsxs)(a.Fragment,{children:[" ","The skaters alone track the night's goals more closely, at r = ",G.players.r.toFixed(2),", within one goal in ",aN(G.players.within_1,0)," of team-games."]}):null]}),(0,a.jsxs)("p",{children:["The goalie is the exception to the division, because his line is measured in goals already. Dom's goalie formula pays every save and charges every goal, and one night of either is mostly shot noise. GS+ splits a goalie's night in two. T, his talent part, is what his record says he would save above expected on tonight's shots: his goaltending forecast, updated with this season's games before tonight and measured against the league's goalies so far this season. R is tonight's surprise, the goals he saved or allowed beyond that. He keeps a share k of the surprise, the share that one night's shots can tell apart from luck, which grows with how many shots he faced",F?(0,a.jsxs)(a.Fragment,{children:[" ","(a median of ",aN(F.k.median,0)," of it per game over ",F.seasons,", from"," ",aN(F.k.p5,0)," on a quiet night to ",aN(F.k.p95,0)," on a busy one)"]}):null,". The rest of the surprise goes to a remainder for the team and for luck, which is kept in the record but not drawn on the card. Within a season, the credited goalies are re-centred to add up to the league's goals saved above expected, so regressing a goalie never makes the league's goaltending better or worse than it was."]}),(0,a.jsx)("p",{children:"Every constant behind the new terms comes from the season before, and the team line reads only the season up to that night, so a game's number is fixed the night it is played and never revised by later games."})]}),(0,a.jsxs)(h.Section,{title:"Four tests",id:"gsp-tests",children:[(0,a.jsxs)("p",{children:["We asked for four things. ",(0,a.jsx)("strong",{children:"Quick"}),": computable at game end from what the night produces."," ",(0,a.jsx)("strong",{children:"Settles"}),": one game should mean something, so a player's number from one stretch of games should agree with another stretch. ",(0,a.jsx)("strong",{children:"Predicts"}),": a player's last ten games should say something about his goal results over the next month. ",(0,a.jsx)("strong",{children:"Agrees with the stars"}),": on the nights everyone saw, the number's top player should usually be the first star, a three-point night should not vanish, and a goalie who stole a game should be near the top."]}),(0,a.jsxs)("p",{children:["And one thing the stars get wrong. The shutdown player who spent the night against the other team's top line and kept them off the board is rarely a star. In ",i.scorecard.star_season,", the voters named him one in"," ",(0,a.jsx)("strong",{children:aN(m.all)})," of ",m.n_all," shutdown games, and in ",(0,a.jsx)("strong",{children:aN(m.D)})," of the"," ",m.n_D," played by defencemen. A good number should beat the voters there without losing them everywhere else."]}),(0,a.jsx)(aZ,{d:i}),l&&(0,a.jsxs)("p",{children:["Graded on all four, plus the shutdown test, Dom's Game Score came out on top of everything we have built or borrowed, with ",l.points," points (ties go to the better predictor). It passed every star line;",T.length?(0,a.jsxs)(a.Fragment,{children:[" the only other metric that did is ",T.join(", "),"."]}):(0,a.jsx)(a.Fragment,{children:" nothing else did."})," It settles in about ",Math.round(l.n70_F)," games for forwards and ",Math.round(l.n70_D)," for defencemen, predicts the next month at ",aS(l.p10)," against a best of ",aS(i.scorecard.best_p10),", and puts the shutdown player in the top three ",aG(l.shut_R)," as often as the voters name him a star."]}),(0,a.jsx)(h.Why,{summary:"How each test is graded",children:(0,a.jsx)("p",{children:"Settles: games until two independent samples of a player agree at r = 0.7, from the one-game intraclass correlation. Predicts (P10): the metric summed over a player's last ten games, correlated with his on-ice goal differential, the same relative to his team, and his share of his team's goals over the next 30 days, by position, weighted by minutes. Stars: six lines, each with a bar fixed before any metric was scored. Shutdown: the share of shutdown games the metric ranks in the game's top three, over the share the voters name a star. A shutdown game needs all four: a top-pair or top-four-forward minutes load, heavy exposure to the opponent's top line, hard deployment, and no goals against with chances against well under what those opponents and that deployment would produce."})})]}),(0,a.jsxs)(h.Section,{title:"Why not one of ours",id:"gsp-ours",children:[(0,a.jsx)("p",{children:"We tried. A season-scale search through everything we measure found nothing that beats Net Rating or Game Score on the trade that matters: credit for the goals that happened against prediction of the goals to come. Brute force on our own stats bought deployment, not play. A separate study of a goals-above-replacement build reached the same verdict against Net Rating."}),(0,a.jsx)(aK,{d:i}),(0,a.jsx)("p",{children:"The same trade holds one game at a time. The numbers that predict best carry no goals, so they cannot agree with the stars; the numbers that track a night's goals best are mostly noise from one night to the next. Game Score sits on the outer edge with both."}),(0,a.jsx)(aJ,{d:i}),d&&l&&(0,a.jsxs)("p",{children:["Settling speed is where our own card number lost most clearly. E1h, the handed-out goals number we had planned to use, needs about ",Math.round(d.n70_F)," forward games to reach the agreement Game Score reaches in ",Math.round(l.n70_F),". Much of Game Score's stability is ice time, which is fair: who plays is part of what happened."]}),(0,a.jsx)(aX,{d:i}),(0,a.jsxs)("p",{children:["And on intuition, the chart below is the whole argument. Up is agreeing with the voters on the first star. Right is rewarding shutdown nights more than they do.",l&&W&&(0,a.jsxs)(a.Fragment,{children:[" Game Score agrees with the first star more often than any other metric here (",aN(l.first_star),") and still rewards shutdown nights"," ",aG(l.shut_R)," as often as the voters do."]}),c&&(0,a.jsxs)(a.Fragment,{children:[" Net Rating gives more shutdown credit (",aG(c.shut_R),") and fails ",6-c.star_lines," of the six star lines."]})]}),(0,a.jsx)(aY,{d:i})]}),(0,a.jsxs)(h.Section,{title:"Faceoffs and penalties",id:"gsp-fo-pen",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Faceoffs."})," Dom pays 0.01 of a goal per net draw won. A draw is worth more in some places than others, and one night's wins are mostly luck. We price each draw by JP Gambatese's method: what a win is worth in goals in that zone and at that strength, times how far above even the player's win rate was last season, shrunk toward even by how many draws he took. The raw term's one-game reliability for forwards is ",(null==(t=v.fo_lin)?void 0:t.icc_F)!=null?aS(v.fo_lin.icc_F):"‚Äì","; the model's is ",(null==(s=v.fo_model)?void 0:s.icc_F)!=null?aS(v.fo_model.icc_F):"‚Äì",". It rewards the centre who is good at draws, not the one who was lucky at them."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Penalties."})," One game's penalty differential is close to pure noise: its one-game reliability is ",(null==(n=v.pen_diff)?void 0:n.icc_F)!=null?aS(v.pen_diff.icc_F):"‚Äì"," for forwards. In its place goes the differential he would be expected to produce: his minutes at each strength, times last season's league rate for his position, home or away, times his own shrunk rate from last season. That is mostly who the player is, so its reliability is"," ",(null==(o=v.xpen_diff)?void 0:o.icc_F)!=null?aS(v.xpen_diff.icc_F):"‚Äì",". We call it the GS+ penalty expectation, ePD ‚àí ePT. It is not the xPenD and xPenT on the Skater Stats page, which use the same season's league rate and no rate of the player's own."]}),(0,a.jsxs)("p",{children:["Both are the small robustness they were meant to be and no more: together they move prediction from"," ",p.gs.p10.toFixed(4)," to ",p.no_shutdown.p10.toFixed(4)," on the tuning seasons, and break nothing."]})]}),(0,a.jsxs)(h.Section,{title:"The shutdown term",id:"gsp-shutdown",children:[(0,a.jsx)("p",{children:"The term is the difficulty of a skater's minutes in expected goals. Each shift is priced at what the league conceded last season in the same spot: five-on-five or short-handed, the zone it started in, the score, and the strength of the opponents on the ice (the third of the league they fell in by last season's Net Rating). A skater's share of that is then measured against his own team's average that night, so the term sums to zero for each team. Hard minutes earn it; sheltered minutes pay for it."}),(0,a.jsxs)("p",{children:["At its plain expected-goals value the term is too small to move a ranking, so it gets a weight. The weight is a trade: more of it, more shutdown credit, less prediction. We chose it by a rule, not by eye. Sweep the weight from nothing to a hundred times the term's value; plot prediction against shutdown credit; scale both to run from the worst to the best value the sweep reached; take the weight where the curve's slope is ‚àí1, where one more unit of shutdown credit starts to cost more than one unit of prediction. That is"," ",(0,a.jsxs)("strong",{children:["k* = ",aF(u)]}),"."]}),(0,a.jsx)(a$,{d:i}),(0,a.jsxs)("p",{children:["The cost is not linear in the weight. On a log scale prediction traces an S: nearly flat at small weights, steepest in the middle, flat again once the term is most of the number. k* sits where the S starts to bend down hard. There, on the tuning seasons, prediction is ",aS(p.gs_plus.p10)," against ",aS(p.no_shutdown.p10)," without the term, ",6===p.gs_plus.star_lines?"every star line holds":"".concat(p.gs_plus.star_lines," of six star lines hold"),", and a shutdown defenceman lands in the game's top three"," ",aN(p.gs_plus.shut_D)," of the time, against ",aN(p.no_shutdown.shut_D)," without it."]}),(0,a.jsx)(h.Why,{summary:"How much the definition of k* matters",children:(0,a.jsxs)("p",{children:["The rule above is one of several honest ways to read ‚Äúslope ‚àí1,‚Äù and they disagree by a few points of weight. On the refined sweep the rule gives ",f.normalised_refined.toFixed(2),", rounded to"," ",aF(u),". The same rule on the coarse sweep alone gives ",f.normalised_coarse.toFixed(2),". Fitting a smooth curve locally, because shutdown credit is a count of ",N.n_shutdown_D_games," games and jumps in steps, gives ",g.map(e=>e.toFixed(2)).join(", ")," across four windows. On the raw, unscaled axes the slope reaches ‚àí1 at ",f.raw.toFixed(2),". Against the log of the weight (both scaled) it is ",f.log_normalised.toFixed(2),null==f.log_raw?"; unscaled, prediction never falls that fast per unit of log weight":"",". The readings run from ",Math.min(f.normalised_refined,...g).toFixed(2)," to ",f.raw.toFixed(2),"; across that range prediction moves by about ",aS(Math.abs(aW(i,Math.min(f.normalised_refined,...g)).p10-aW(i,f.raw).p10)),"."]})})]}),(0,a.jsxs)(h.Section,{title:"What we left out",id:"gsp-left-out",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Expected win probability added."})," xWPA was the strongest stabiliser inside our own numbers, so it was the obvious thing to add to Game Score. It does not make Game Score settle faster. At the weight our earlier study chose (",i.xwpa_sweep.chosen_phase2," of a win's value) it adds ",aS(k.p10-p.gs.p10)," of prediction and takes the number longer to settle",_&&(0,a.jsxs)(a.Fragment,{children:["; by ",aF(_.w)," it has started to cost star lines"]}),". One night's xWPA reads deployment more than play. Left out."]}),(0,a.jsx)(a0,{d:i}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Block value."})," We could pay a block for the expected goals of the shot it stopped instead of a flat 0.05. With the shutdown term in, it changes prediction by ",j.dp10[0]>=0?"+":"",j.dp10[0].toFixed(4)," (90% interval ",j.dp10[1].toFixed(4)," to ",j.dp10[2].toFixed(4),"), slightly lowers shutdown credit (",aN(j.without.shut_D)," to ",aN(j.with.shut_D),") and slows settling a little. That is noise, and our block values only exist from 2023-24 on, so the untouched season below could not even score it. Dom's flat rate stays. A block has to be an opponent's: since 2023-24 the feed also records a shot blocked by the shooter's own teammate, and GS+ counts that as a block for nobody, as the official count does not."]})]}),(0,a.jsxs)(h.Section,{title:"The untouched season",id:"gsp-test",children:[(0,a.jsxs)("p",{children:["Every choice above was made on ",i.scorecard.seasons,". The finished formula was then scored once on"," ",x.season_label,", beside plain Game Score and GS+ without the shutdown term. No choice was tuned on that season; one earlier version of GS+, with an xWPA term, had been scored on it once before."]}),(0,a.jsx)(a2,{d:i}),b&&y&&w&&(0,a.jsxs)("p",{children:["It held its shape and it showed its price. GS+ passed all six star lines and put shutdown defencemen in the top three ",aN(b.shut_top3_D)," of the time, against ",aN(w.shut_top3_D)," for Game Score. It settled about as fast. It predicted the next month worse: ",aS(b.p10)," against ",aS(w.p10),", a bigger cost than on the tuning seasons (",aS(p.gs_plus.p10)," against ",aS(p.gs.p10),"), and a drop from"," ",w.grades.predict," to ",b.grades.predict," on that test. The faceoff and penalty changes alone cost almost nothing there (",aS(y.p10),"). By the points rule registered before any of this, plain Game Score still wins the season, ",w.grades.points," to ",b.grades.points,". That is the trade we chose: a number that rewards the shutdown night, paid for in prediction."]})]}),(0,a.jsxs)(h.Section,{title:"On the card",id:"gsp-card",children:[(0,a.jsx)("p",{children:"The game card draws each player's GS+ as a dot in his team's colour, the way the player card draws a rating: forwards first, then defencemen, then goalies, each group in GS+ order. Around each dot is a shaded band, darkest at the game and fading out at the edges of one game's noise, the range four in five of a player's games land in at his own level (skaters by ice time, goalies by shots faced), measured on the three seasons above. One game is a wide estimate, and the band says so. Every number on the card, the dots, the bands and the averages behind them, is in goals."}),(0,a.jsx)("p",{children:"The card does not wait for the overnight run. Every constant GS+ uses is fitted on the season before, so all it needs from the night is the game itself: as the league publishes the play-by-play and the shift chart, the same formula runs on them, and the card shows GS+ so far while the game is on and the game's figure once it ends, marked provisional. Overnight, GS+ is recomputed from the league's settled play-by-play and shift chart, and that figure replaces it, mark and all."}),(0,a.jsx)("p",{children:"Behind each group, a zone in the team's colour steps down through the average game of a first, second, third and fourth line forward (or a first, second and third pair defenceman), darkest between the first and second, with lines and pairs ranked by ice time within the game. The ruler under each group names the steps, so the line ruler sits between the forwards and the defencemen. The goalies' zone runs between the average starter's game and the average backup's, a starter being the goalie with the most starts on his team that season."}),(0,a.jsx)("p",{children:"The wide card shows both teams, so when it can it shows lines instead of players: one row per forward line and per pair, named for its members, the dot the line's GS+ (its members added up), the band a line's or pair's own one-game noise, the zone the average line or pair game. Both teams are shown by line or neither is: if either team's lines did not hold that night, both sides are shown by player."}),(0,a.jsx)("p",{children:"Each team gets its primary colour unless it is too faint on the page (under three-to-one contrast), in which case its secondary; when the two teams' colours are too alike to tell apart, one side moves to its other colour, or to plain ink."}),(0,a.jsx)(h.Why,{summary:"When lines count as well defined",children:(0,a.jsxs)("p",{children:["Daily Faceoff's lines must have been fetched that day or the day before, all eighteen projected skaters must have played, and every unit must actually have played together: the five-on-five time with all its members on the ice at once, over their average five-on-five time, at least"," ",aN(i.lines.F.threshold,0)," for a forward line and ",aN(i.lines.D.threshold,0)," for a pair. Those bars pass ",aN(i.lines.F.actual_pass,0)," and ",aN(i.lines.D.actual_pass,0)," of the lines and pairs that really played most together in ",i.lines_season,", and ",aN(i.lines.F.broken_pass)," and"," ",aN(i.lines.D.broken_pass)," of the same units with one member swapped out."]})})]}),A&&(0,a.jsxs)(h.Section,{title:"Offence and defence",id:"gsp-offdef",children:[(0,a.jsx)("p",{children:"Above the card, a switch turns the interval into offence and defence. Each row becomes a stack from zero: the offence half solid in the team's colour, the defence half hatched, a tick where they add up. They add up to the GS+ printed beside them, exactly, so no number on the card moves. On the wide card the goalies get a ruler of their own, on a single team's card the skaters', and a goalie's whole line is defence."}),(0,a.jsxs)("p",{children:["Every term goes to one side. Goals, assists, shots, the five-on-five shot attempts and goals for while he was on the ice and the expected penalties he drew are offence. Blocks, the shutdown term, the attempts and goals against and the expected penalties he took are defence. A faceoff goes by where it was taken, seen from the taker's own team: an attacking-end draw is offence, an own-end draw defence, and a neutral-zone draw is split half and half, a rule fixed by choice because nothing in the data decides it. Neutral-zone draws carry about ",aN(A.nz_share_of_fo_value,0)," of the faceoff value."]}),(0,a.jsxs)("p",{children:["The on-ice and penalty terms are counted against the league. Left raw, each half carries a count that grows with ice time; the two cancel in GS+ but not apart, so a heavy-minutes player would show a big offence and a big negative defence for his minutes alone. So the league's rate per second, from the season before, comes out of both halves of each pair: each half counts what happened above or below that rate in his minutes, and GS+ itself is untouched. Averaged over a calendar year's games (twenty or more), a player's two halves correlate at ",A.corr_player_season.toFixed(2).replace("-","‚àí")," over"," ",A.seasons,": close to independent."]}),(0,a.jsxs)("p",{children:["The band stays on the total, and that is deliberate. One night's defence half is mostly role. It settles in about ",A.n70.def.toFixed(0)," games, faster than offence (",A.n70.off.toFixed(0),"), but nearly all of that comes from the shutdown term, which is built from whom a player faced and how he was deployed, so it repeats with his deployment. Without it, the defence half needs about"," ",A.n70.def_no_shutdown.toFixed(0)," games to settle. Read one game's defence as how he was used more than how he played; a band for each half would be a new claim about uncertainty, and the card makes none."]})]}),(0,a.jsxs)(h.Section,{title:"On the Skater Stats table",id:"gsp-table",children:[(0,a.jsxs)("p",{children:["The Standard tab of Skater Stats sums GS+ over a player's games, with GS+/GP beside it, and splits the sum the two ways the card does. ",(0,a.jsx)("strong",{children:"GS+ Off"})," and ",(0,a.jsx)("strong",{children:"GS+ Def"})," are the two halves above, added up game by game, so they add to GS+. Under ",(0,a.jsx)("strong",{children:"GS+ parts"})," in the column picker, hidden until asked for, are the card's eight stacked segments: Scoring (goals and both assists), Shots, Blocks, On-ice (the five-on-five attempt and goal differentials), Faceoffs, Penalties (exp.), the ePD ‚àí ePT expectation, Shutdown, and Team line, minus the share of his team's five-on-five baseline that GS+ hands to the team. They add to GS+ as well. All of them are regular season only, follow the date window, and scale with the rate toggle on GS+'s own games and minutes."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"By strength."})," Every game's GS+ is also stored in five parts by game state, from the player's own side: five-on-five, four-on-four and three-on-three, the power play, the penalty kill, and the rest: a net empty, a state the feed does not record, and the odd goal, assist, shot or block the play-by-play and the official count disagree on. A sixth part holds the share of Shutdown that only All situations shows (below). The six add back to the game's GS+ exactly, so under Even strength, 5v5, Power play and Penalty kill each column shows the part earned in that state, and the parts add up to the All situations number. Any other single state reads ‚Äú-‚Äù: a part pools several states and cannot be taken apart again. Scoring, Shots and Blocks go where the official count files each goal, assist, shot and block, so the power-play Scoring is his power-play goals and assists at Game Score's weights. On-ice is five-on-five already. Faceoffs follow each draw's state, and the penalty expectation his minutes in each. Shutdown at five-on-five compares his minutes with his teammates' five-on-five minutes. On the penalty kill it only compares how tough his kill minutes were with his teammates'; credit for killing more penalties than them counts under All situations. The Team line is all five-on-five. Under a strength filter GS+/GP and the rate toggle's per-game basis still count all his games, so the filters add up; its per-minute basis counts his minutes at that strength."]})]}),(0,a.jsxs)(h.Section,{title:"Credits and limits",id:"gsp-credits",children:[(0,a.jsx)("p",{children:"Game Score is Dom Luszczyszyn's (Hockey-Graphs, ‚ÄúMeasuring Single Game Productivity: An Introduction to Game Score‚Äù). The faceoff values follow JP Gambatese's method (‚ÄúWhat is a faceoff win worth?‚Äù). Expected goals are our own shooter-adjusted model, xG(sh)."}),(0,a.jsx)("p",{children:"The limits. The star tests use one season of official stars per test. The shutdown test leans on on-ice expected goals against, so any metric with a defensive on-ice term is favoured by construction; that is its point, but it is not neutral. The faceoff value table was fitted on seasons that include the untouched one. And k* is a weight we chose by a stated rule, not one the data handed us: the rule is written down so that it can be argued with."})]}),(0,a.jsx)(h.Appendix,{intro:"The study tables behind the charts.",children:(0,a.jsx)(h.Why,{summary:"The tuning seasons, side by side",children:(0,a.jsxs)("ul",{className:"list-disc ml-5 space-y-1",children:[(0,a.jsxs)("li",{children:["Dom's Game Score: prediction ",p.gs.p10.toFixed(4),", shutdown D top three ",aN(p.gs.shut_D),", first star ",aN(p.gs.first_star),", settles in ",p.gs.n70.toFixed(1)," games."]}),(0,a.jsxs)("li",{children:["Without the shutdown term: ",p.no_shutdown.p10.toFixed(4),", ",aN(p.no_shutdown.shut_D),", ",aN(p.no_shutdown.first_star),", ",p.no_shutdown.n70.toFixed(1),"."]}),(0,a.jsxs)("li",{children:["GS+: ",p.gs_plus.p10.toFixed(4),", ",aN(p.gs_plus.shut_D),", ",aN(p.gs_plus.first_star),", ",p.gs_plus.n70.toFixed(1),"."]})]})})})]})}let a4=[["ppr-what","What a slot is"],["ppr-how","How it is read"],["ppr-left-out","What we left out, and why"],["ppr-accuracy","How often it is right"],["ppr-gates","The bar we set, and missed"],["ppr-limits","What it cannot do"]],a6=e=>null==e?"‚Äì":"".concat(Math.round(100*e),"%");function a8(){let[e,t]=(0,n.useState)(null),[s,o]=(0,n.useState)(!0);return(0,n.useEffect)(()=>{fetch("/data/pp_roles/accuracy.json").then(e=>e.ok?e.json():null).then(t).catch(()=>t(null)).finally(()=>o(!1))},[]),(0,a.jsxs)("article",{id:"pp-roles-writeup",className:"prose-paper",children:[(0,a.jsxs)("header",{className:"mb-10",children:[(0,a.jsx)("div",{className:"dateline",children:"Writeups \xb7 Player roles \xb7 The power play"}),(0,a.jsx)("h1",{className:"font-serif text-5xl font-bold tracking-tight mt-2 mb-3",children:"Power-play roles: who stands where"}),(0,a.jsx)("p",{className:"deck",children:"Every power-play unit puts five skaters in five places, and the play-by-play never says which is which. We read it off where their events happen and publish the split as percentages."}),(0,a.jsx)(h.Byline,{})]}),(0,a.jsx)(h.Toc,{items:a4}),s&&(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}),!s&&!e&&(0,a.jsx)("p",{className:"text-ink-faint",children:"The writeup's data is unavailable."}),e&&(0,a.jsx)(a9,{d:e})]})}function a9(e){let{d:t}=e,s=t.test_half,n=t.all_teams,o=t.gates;return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)(h.Section,{title:"What a slot is",id:"ppr-what",children:[(0,a.jsx)("p",{className:"drop-cap",children:"Most NHL power plays set up as a 1-3-1. One skater works the blue line: the point. Two work the half-walls, one on each side, usually the shooters and passers the unit is built around. One sits in the middle of the zone, between the circles: the bumper. One lives at the net, screening and tipping: the net-front. Five skaters, five slots, one of each."}),(0,a.jsx)("p",{children:"Post Hockey shows this on each team's page, unit by unit. For a team's most-used five-man power-play units, the grid gives each player's share of the unit's five-on-four time in each slot. Every row adds to 100%, and so does every column: within a unit each slot is somebody's, all of the time. The rink seats the five in the unit's most likely arrangement; a player under half in his seat rotates, and the grid shows where. Left and right are the attacker's, looking at the net: the left half-wall is the one Alex Ovechkin shoots from."})]}),(0,a.jsxs)(h.Section,{title:"How it is read",id:"ppr-how",children:[(0,a.jsx)("p",{children:"Nothing in the NHL's data records where a player stands. It records where each player's events happen: shots that reach the net or miss it, shots that are blocked (only the angle survives those, since the coordinates are the blocker's), giveaways and takeaways in the offensive zone, penalties drawn and hits taken in the opponent's end. Each slot has its own map of where those events come from and how often they happen, and the maps are fitted, not drawn by us: we seeded them with five boxes on the rink and let the data move them."}),(0,a.jsx)("p",{children:"The read is joint. A unit holds exactly one of each slot, so all five skaters on the ice are placed at once, over every way of assigning five players to five slots. That is what separates the bumper from the net-front when their rebounds land in the same place, and the point from a half-wall man walking down the wall: if the point is obviously the defenceman, the other four have to be somewhere else. The model is fitted on every five-on-four stretch from 2021-22 on, and a player's previous season is the starting guess for the next. A unit is shown when its five played at least five minutes of five-on-four together, up to three per team-season, and its grid is the fit's own reading of those minutes, pooled."})]}),(0,a.jsx)(h.Section,{title:"What we left out, and why",id:"ppr-left-out",children:(0,a.jsx)("p",{children:"Faceoffs and assists are not inputs. Both were in the first version, and both say who a player is rather than where the player is. The centre takes the draw wherever the centre then sets up, so with faceoffs in, the model decided that ‚Äúbumper‚Äù meant ‚Äúthe centre‚Äù, and every first-unit centre came out as the bumper, including the ones who run the half-wall. An assist records that a player passed, not from where. With both removed, the centres went back to where they actually play, and the score against hand-labelled units went up. Neither appears anywhere in the number."})}),(0,a.jsxs)(h.Section,{title:"How often it is right",id:"ppr-accuracy",children:[(0,a.jsxs)("p",{children:["We hand-labelled the first power-play unit of every team we could in 2024-25, before fitting anything: who played the point, the half-walls, the bumper and the net. Half of those teams were used to choose the two settings we were unsure of. The other half, ",s.teams.join(", "),", was scored once, at the end. The table compares the model's top slot for each labelled player with the label, alongside three ways of guessing without it."]}),(0,a.jsxs)("table",{className:"text-sm border border-rule my-4 w-full max-w-xl",children:[(0,a.jsx)("thead",{children:(0,a.jsxs)("tr",{className:"border-b border-rule-strong text-ink-faint text-[11px] uppercase tracking-wider",children:[(0,a.jsx)("th",{className:"px-3 py-2 text-left font-medium",children:"Top slot right, of five"}),(0,a.jsxs)("th",{className:"px-3 py-2 text-right font-medium",children:["Held-out half (",s.n,")"]}),(0,a.jsxs)("th",{className:"px-3 py-2 text-right font-medium",children:["All labelled (",n.n,")"]})]})}),(0,a.jsxs)("tbody",{className:"tabular-nums",children:[(0,a.jsxs)("tr",{className:"border-b border-rule font-semibold",children:[(0,a.jsx)("td",{className:"px-3 py-1.5",children:"The model"}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(s.five_way.model)}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(n.five_way.model)})]}),(0,a.jsxs)("tr",{className:"border-b border-rule",children:[(0,a.jsx)("td",{className:"px-3 py-1.5",children:"Where most of the player's shots came from"}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(s.five_way.seed_region_table)}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(n.five_way.seed_region_table)})]}),(0,a.jsxs)("tr",{className:"border-b border-rule",children:[(0,a.jsx)("td",{className:"px-3 py-1.5",children:"Position only: defencemen at the point"}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(s.five_way.position_only)}),(0,a.jsx)("td",{className:"px-3 py-1.5 text-right",children:a6(n.five_way.position_only)})]}),(0,a.jsxs)("tr",{children:[(0,a.jsx)("td",{className:"px-3 py-1.5",children:"A random slot"}),(0,a.jsx)("td",