unction I(e){var t,s;return null!=(s=null==(t=D.find(t=>{let[s]=t;return s===e}))?void 0:t[1])?s:e}function C(){var e,t,s,o,r,u,f,g;let[x,b]=(0,n.useState)(null),[y,w]=(0,n.useState)([]),_=function(){let[e,t]=(0,n.useState)(null);return(0,n.useEffect)(()=>{fetch("/data/luck/methods.json").then(e=>e.ok?e.json():null).then(e=>t(e)).catch(()=>t(null))},[]),e}();return(0,n.useEffect)(()=>{(0,l.Nm)().then(b).catch(()=>b(null)),(0,m.Y6)().then(w)},[]),(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)("header",{className:"mb-10",children:[(0,a.jsx)("div",{className:"dateline",children:"Methods \xb7 Glossary"}),(0,a.jsx)("h1",{className:"font-serif text-5xl font-bold tracking-tight mt-2 mb-3",children:"What every column means"}),(0,a.jsx)("p",{className:"deck",children:"Every metric on the site: formulas, choices and fit statistics, updated live."}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft",children:[(0,a.jsx)("a",{href:"/changelog",className:"text-accent hover:underline",children:"Model changelog"})," ","\xb7"," ",(0,a.jsx)("a",{href:"/contribute",className:"text-accent hover:underline",children:"Submit your research"})]}),(0,a.jsx)(h.Byline,{})]}),(0,a.jsx)(E,{items:D}),(0,a.jsxs)(h.Section,{title:I("corpus"),id:"corpus",children:[(0,a.jsx)("p",{children:"Everything on the site is computed from the same raw substrate. Here is what's currently loaded:"}),x?(0,a.jsx)(h.DefinitionList,{items:[["Games",x.corpus.games.toLocaleString()],["Play-by-play events",x.corpus.events.toLocaleString()],["Shifts (nonzero duration)",x.corpus.shifts_nonzero.toLocaleString()],["Shift summaries",x.corpus.shift_summaries.toLocaleString()],["computed_stats rows",x.corpus.computed_stats_rows.toLocaleString()]]}):(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}),(null==x?void 0:x.corpus.latest_game_date)&&(0,a.jsxs)("p",{className:"text-sm mt-3",children:[(0,a.jsx)("span",{className:"dateline",children:"Data through"})," ",(0,a.jsx)("strong",{children:x.corpus.latest_game_date}),x.corpus._updated_at&&(0,a.jsxs)("span",{className:"text-ink-faint",children:[" ","\xb7 last rebuilt"," ",new Date(x.corpus._updated_at).toLocaleDateString("en-CA")]})]}),(0,a.jsx)("p",{className:"text-sm text-ink-soft mt-3",children:"Data comes from the public NHL API. Regular season and playoffs are kept apart: every table opens on the regular season, and the Playoffs switch shows the postseason on its own, never pooled into the season line. Playoff shots are scored by the same xG model, which is fitted on regular-season shots only, and they feed the talent estimates. Net Rating and GSAx+ are regular-season measures and read ‚Äú-‚Äù for playoff games. A nightly timer scrapes and recomputes the games played so far, so the date above is the honest extent of what is loaded -- not necessarily last night, if the timer skipped a night or a game feed lagged."}),(0,a.jsx)("h3",{id:"seasons",className:"font-serif text-xl mt-6 mb-2 scroll-mt-24",children:"Which seasons, and why 2023-24 still draws a line"}),(0,a.jsxs)("p",{children:["The skater and team tables, a skater‚Äôs page and a team‚Äôs page go back to ",(0,a.jsx)("strong",{children:"2010-11"}),". Everything else ‚Äî goalies, badges, Success Above Expected, iWPA, linemates, matchups, shift performance, the forecasts ‚Äî starts at ",(0,a.jsx)("strong",{children:"2023-24"}),". The database holds every season from 2010-11 and the models are fit over all of it; the line is about measurement, not storage."]}),(0,a.jsxs)("p",{children:["The boundary is 2023-24, but not because the chips went in then. The NHL puts puck-and-player tracking at fully operational in"," ",(0,a.jsx)("strong",{children:"2021-22"}),", and our own shot coordinates show no break at 2023-24 to contradict that ‚Äî the number of distinct coordinate values and the average shot distance both drift rather than jump."]}),(0,a.jsxs)("p",{children:["What changes in 2023-24 is what the league ",(0,a.jsx)("em",{children:"records"}),". Missed shots go from a steady ~27% of all attempts through 2021-22 to 30.5% in 2023-24, 33.1% the year after and 33.7% now ‚Äî and the extra ones are not systematically longer or shorter, so it is a matter of more attempts being written down rather than a different kind of attempt. That changes the population a shot model is fit on, which is reason enough to split it, and it is the honest reason rather than a tidier one about telemetry. So there are two base models: the chip-era one scores 2023-24 onward, and a ",(0,a.jsx)("strong",{children:"pre-chip"})," one, trained only on earlier shots, scores 2010-11 through 2022-23. Success Above Expected inherits the boundary directly ‚Äî it is defined on"," ",(0,a.jsx)("code",{children:"xgf_shooter_adj ‚àí xga_shooter_adj"}),", the headline xG pairing, and its cutoffs were calibrated on chip-era shifts, so"," ",(0,a.jsx)("code",{children:"compute_sae.py"})," refuses to compute it for earlier seasons."]}),(0,a.jsx)("p",{children:"Sort a skater table across the line if you like; counts are counts. But a 2014-15 xG and a 2024-25 xG come from different models fit on differently recorded shots, which is why pages that show the older seasons say so."})]}),(0,a.jsxs)(h.Section,{title:I("cf-gf"),id:"cf-gf",children:[(0,a.jsx)("p",{children:"The classic on-ice possession proxies. While a player is on the ice at 5v5, every shot attempt the team takes is a Corsi-for (CF), every attempt the opponent takes is a Corsi-against (CA). Goals-for and goals-against (GF / GA) are the actual outcomes."}),(0,a.jsx)(h.Formula,{lines:["CF% = CF / (CF + CA)","GF% = GF / (GF + GA)"]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Implementation note:"}),' a shift\'s "for" / "against" attribution uses the half-open interval'," ",(0,a.jsx)("code",{className:"text-accent",children:"(start, end]"}),". A shift ending exactly at the moment of an event still counts as the outgoing line on for that event; an incoming line starting at the same instant does not. This avoids double-counting at line-change boundaries, which matters most for goals: a goal stops play, so its timestamp is at once the last second of the shifts of everyone on the ice and the recorded first second of the shifts of everyone coming over the boards. Measured against an independently-built on-ice matrix, league goals-for and goals-against each match truth to within 0.1%."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("em",{children:"Strength state"})," is parsed from the NHL situation code (4-digit string: away goalie, away skaters, home skaters, home goalie). Empty-net states are excluded from 5v5 and the special- teams buckets."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("em",{children:"Even strength"})," (ES) means equal skaters with both goalies in net: 5v5, 4v4, 3v3. Time with a goalie pulled (6v5, 5v6) is not ES here, though Natural Stat Trick and the NHL's official scoring count it. Through Oct. 17, 2026, McDavid's ES on-ice goals read 19‚Äì2 here and 22‚Äì3 there; the gap is his 3‚Äì1 at 6v5 and 5v6."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("em",{children:"All situations"})," leaves empty-net and extra-attacker play out of the on-ice shots and goals, so GF and xGF describe the same shots; ice time keeps every second, and a player's own goals and assists still count every one. ",(0,a.jsx)("em",{children:"All situations (including ENG)"})," puts that play back, and its GF and GA count the goals scored with a net empty."]})]}),(0,a.jsxs)(h.Section,{title:I("individual"),id:"individual",children:[(0,a.jsx)("p",{children:"The Standard tab of Skater Stats opens on the player's own line before the on-ice numbers: what he did with his own stick and body, not what happened around him. Each is a count, so the Total / Per 60 / Per 84 toggle scales it, and each follows the strength filter from his side of the ice (a hit he took on the kill counts under PK)."}),(0,a.jsx)(h.DefinitionList,{items:[["A1, P1","Primary assists, the last pass before a goal, and P1 = G + A1. Secondary assists are the noisiest points in the box score; P1 leaves them out."],["iSF, iCF","His shots on goal (goals included) and his shot attempts: shots, misses and blocked attempts (a teammate's block included, as Corsi counts it)."],["ixG, ixG(sh)","The expected goals of his own unblocked attempts, raw and shooter-adjusted. The suffix names the model, as on the on-ice columns."],["iBLK","Opponent shots he blocked, as the NHL box score counts them. Since 2023-24 the feed also logs a teammate's shot hitting him; that is a miss, not a block, and is left out."],["iHF, iHA","Hits he made and hits he took. Recorded by each rink's scorer, and rinks differ, so read them within a team before across the league."],["PenT, PenD, Pen+/-","Penalties taken, penalties drawn and the difference, counted as in the penalties section below: regular season, 2023-24 on."],["PP TOI, EV TOI, PK TOI","His ice time on the power play, at even strength (5v5, 4v4, 3v3) and on the kill, whatever the strength filter. Hidden by default under Columns."]]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"xG incl. blocked shots."})," Every xG on the site counts unblocked attempts. The switch of that name on the Standard tab, off by default, adds the attempts an opponent blocked to ixG(sh), xGF(sh) and xGA(sh), and so to xGF%(sh) and xG\xb1(sh), each valued where the shot was likely released: the blocked-shots model, accepted but not validated, and the same value as the Extras tab's Blk xG(sh). Only the (sh) model has that value, so the raw, (sv) and (sh+sv) columns and GAx(sh) do not move. Regular season, 2023-24 on; it is greyed out for any selection reaching earlier, for playoffs, and with score-and-venue adjustment or a danger filter on."]})]}),(0,a.jsxs)(h.Section,{title:I("box-score"),id:"box-score",children:[(0,a.jsx)("p",{children:"The counting stats the NHL's own scorers record, as the league publishes them. We print them because a reader expects them, not because they settle anything."}),(0,a.jsx)(h.DefinitionList,{items:[["GP","Games played"],["TOI","Time on ice, minutes"],["G / A / P","Goals, assists, points (G + A)"],["A1 / P1","Primary assists; goals plus primary assists"],["S / SOG","Shots on goal"],["SFT","Shifts"],["HIT","Hits delivered"],["BLK","Shots blocked"],["GV / TK","Giveaways / takeaways, a scorer's judgement call"],["FOW / FOL / FO%","Faceoffs won / lost; won as a share of taken"],["PIM","Penalty minutes"],["+/-","Even-strength and shorthanded goals for minus against while on the ice"],["SA / SV / SV%","Goalies: shots against, saves, saves as a share of shots"],["W / L / OTL","Wins, regulation losses, overtime and shootout losses"]]})]}),(0,a.jsxs)(h.Section,{title:I("score-venue"),id:"score-venue",children:[(0,a.jsxs)("p",{children:["A team that trails shoots more and a team that leads sits back, and the home team takes a little more than half the attempts whatever the score. A raw shot share therefore mixes how a team played with the states it happened to play in. The ",(0,a.jsx)("strong",{children:"Score & venue"})," ","toggle on the stats tables reweights every attempt, shot, goal and xG by the state it was taken in: the home team's score differential before the attempt (seven cells at 5v5, from three or more down to three or more up; trailing, tied or leading at 4v4, 3v3 and on the power play), the venue, and the strength. After weighting, the home team's share of each metric in every state is one half (on the power play, the power-play side's share is the season's pooled share, so the power play keeps its advantage). Each state's league total is preserved exactly; only the split between the two teams moves. Column headers do not change; the toggle's state and the caption under the toolbar say the table is adjusted and which date the weights run through, and a column the adjustment does not reach is marked raw."]}),(0,a.jsxs)("p",{children:["The textbook version is Micah Blake McCurdy's (Hockey-Graphs, 2014): with ",(0,a.jsx)("em",{children:"f"})," the league's home share of a metric in a state, home attempts are weighted \xbd/",(0,a.jsx)("em",{children:"f"})," and away attempts \xbd/(1‚àí",(0,a.jsx)("em",{children:"f"}),"). Evolving-Hockey (Luke and Josh Younggren) publish their on-ice metrics on that method with a weight table per metric. We depart from it at 5v5. The team that is leading is, on average, the better team, so the raw home share in a lead state mixes the score effect with talent and understates it. We fit, per season, a binomial model of each game's home share in each state on state effects plus team-season strengths, and use the state effect alone as ",(0,a.jsx)("em",{children:"f"}),"; the cell is then rescaled so its total is preserved. In the pre-registered tests the talent-controlled weights beat McCurdy's on predicting the other half's goal share for every metric, twenty splits of twenty. Other strengths use the textbook weights."]}),(0,a.jsx)(h.Formula,{lines:["home attempt weight  =  \xbd / f*        away attempt weight  =  \xbd / (1 ‚àí f*)","f* = logistic(state effect), from  logit P(attempt is home's) = state + Œ∏_home ‚àí Œ∏_away","then rescaled so  Œ£_home w\xb7x + Œ£_away w\xb7x  =  Œ£ x   in every (season, strength, state)"]}),(0,a.jsxs)("p",{children:["Weights are fitted ",(0,a.jsx)("em",{children:"per season"}),", the season in progress on its games to date, refit weekly: the effects drift from year to year and all but vanished in the no-crowd 2020‚Äì21 season, and the previous season's weights, tested, do not level the current one. A state with too few attempts in a season borrows the two seasons before it for its share; at even strength the cell is then rescaled to this season's total, and on the power play the weights are normalised so that the power-play side's and the shorthanded side's season totals are each preserved exactly. There is no time-of-game term: a period split was tested and added nothing we could detect for Corsi, goals or any xG variant, which is what McCurdy found in 2014. Eric Tulsky's 2012 score-adjusted weighting and his earlier \"score-close\" filter (keep only the close minutes) are the ancestors; score-close tested worse than raw, because it removes most of the sample along with the bias."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Goals are adjusted too."})," The gain is small and real (the table), and the column is there because a toggle should be all-or-nothing on a table, not because adjusted goals are a better headline than goals. ",(0,a.jsx)("strong",{children:"Not adjusted"}),", and shown greyed under the toggle: individual counts (a player's own attempts, goals, assists, points), which are not a share between two teams; the win-probability family (iWPA, shift WPA, implied purpose, xG impact), which is already conditioned on score, venue and time; the linemates' expected xGD, whose context model has a score term; and Net Rating, which is team-relative and stays on raw inputs. Goalie danger-split columns follow in a later phase."]}),(0,a.jsx)(R,{})]}),(0,a.jsxs)(h.Section,{title:I("xg"),id:"xg",children:[(0,a.jsxs)("p",{children:["A logistic regression fit on every Fenwick shot in the corpus. Target is goal vs. not-goal. Features are geometric and contextual: distance and signed angle to net ‚Äî signed because a shot from behind the goal line is not the mirror image of one from the slot ‚Äî their interaction, a 26-column tensor-spline surface over distance and angle (danger is a surface over the two, not a line in each), one-hot shot type, skater-pair strength state with its own geometry deviations, and prior-event context (93 features total: 67 base features plus the 26-column spline block). The fit gives a base logit per shot; on top of it sits ",(0,a.jsx)("code",{className:"text-accent",children:"E"}),", the league scoring environment for that season, and then the four xG flavors layer player identity on via Extended Kalman Filter talent posteriors. ",(0,a.jsx)("code",{className:"text-accent",children:"E"}),' is not optional garnish ‚Äî it is the anchor that keeps the shooter- and goalie-adjusted variants honest, and it is present in all four. "Unadjusted" means no talent adjustment, not no environment: raw xG is shot quality for an average shooter against an average goalie in that season\'s environment, which is why raw alone runs a few percent under the power play ‚Äî power-play shooters are not average, and only the shooter-adjusted variant knows that.']}),(0,a.jsx)(h.Formula,{lines:["xg_unadjusted   = sigmoid(base_logit + E)","xg_shooter_adj  = sigmoid(base_logit + E + Œº_shooter)","xg_goalie_adj   = sigmoid(base_logit + E ‚àí Œº_goalie)","xg_fully_adj    = sigmoid(base_logit + E + Œº_shooter ‚àí Œº_goalie)"]}),(0,a.jsxs)("p",{children:["Base model diagnostics: test log-loss 0.2271, Brier 0.0612, ROC AUC 0.740, ECE 0.0069. Empty-net shots ‚Äî which convert at roughly 55% and are trivially easy to separate from a shot facing a goaltender ‚Äî are excluded from the model entirely, so this AUC reflects only the hard part of the problem rather than being inflated by the easiest calls. For the complete walk-through ‚Äî features, calibration curves, feature ablation, EKF equations, and cross-site validation ‚Äî see the"," ",(0,a.jsx)("a",{href:"?tab=writeups&writeup=xg#xg-writeup",className:"text-accent hover:underline",children:"Expected Goals writeup"})," ","on the Writeups tab."]})]}),(0,a.jsxs)(h.Section,{title:I("talent"),id:"talent",children:[(0,a.jsxs)("p",{children:["Per-player latent talent is tracked over time as a posterior on the logit scale, walked forward alongside the league environment term described above. After every shot the base model was trained on (the ",(0,a.jsx)("code",{className:"text-accent",children:"is_fenwick_for_xg"})," mask ‚Äî empty-net goals, shootout attempts and penalty shots do not update anyone, since the base model never saw them either) we update the shooter, the goalie, and ",(0,a.jsx)("code",{className:"text-accent",children:"E"}),"together. Block events are excluded from talent updates (a block never reaches the goalie). Between updates, variance inflates by a small per-shot drift to model real-world talent change. We call the goalie side of this goalie-and-context talent, not goalie talent: it is estimated from the shots a goalie faces, so it also picks up the team in front of him. About half of it is shared by both of a team's goalies in a season, and in our out-of-sample tests it added no measurable predictive value."]}),(0,a.jsx)(h.Formula,{lines:["Prior:   Œ≤‚ÇÄ ~ Normal(Œº‚ÇÄ, œÉ\xb2‚ÇÄ)","Walk:    Œ≤_t ~ Normal(Œ≤_{t‚àí1}, œÉ\xb2_walk)","Update:  p = sigmoid(base_logit + E + Œº_shooter ‚àí Œº_goalie)","         w = p \xb7 (1 ‚àí p)","         œÉ\xb2_new = 1 / (1/œÉ\xb2 + w)","         Œº_new = Œº + œÉ\xb2_new \xb7 (y ‚àí p)"]}),(0,a.jsxs)("p",{children:["Update for the goalie uses the opposite sign so positive",(0,a.jsx)("code",{children:" goalie_talent"})," means a better save-rate. Once per season boundary, shooter and goalie-and-context talent are re-centred ‚Äî chance-weighted, in the odds domain, over the trailing year of shots ‚Äî so the league's active shooters and goalies each net to zero. Whatever that centring removes is not discarded; it moves into ",(0,a.jsx)("code",{className:"text-accent",children:"E"}),", so every already-computed probability is unchanged at the instant of the re-frame. Within a season the frame is fixed, so a player's in-season trajectory reflects only their own shots."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Hyperparameters"}),(0,a.jsx)(h.DefinitionList,{items:[["Œº‚ÇÄ (shooter)","‚àí0.05 (a little below the chance-weighted average of active shooters)"],["œÉ\xb2‚ÇÄ (shooter)","0.02 (SD ‚âà 0.14 logits)"],["œÉ\xb2_walk (shooter)","1e-5 per shot taken"],["Œº‚ÇÄ (goalie)","‚àí0.05 (replacement level, relative to the chance-weighted active league)"],["œÉ\xb2‚ÇÄ (goalie)","0.0025 (SD ‚âà 0.05 logits)"],["œÉ\xb2_walk (goalie)","3e-7 per shot faced (treats goalie-and-context talent as near-static across seasons)"],["œÉ\xb2_max","0.5 (variance cap)"]]}),(0,a.jsxs)("p",{children:["The goalie prior anchors to the environment term"," ",(0,a.jsx)("code",{className:"text-accent",children:"E"})," rather than an arbitrary zero, so Œº‚ÇÄ = ‚àí0.05 describes replacement level relative to the chance-weighted active league, not an absolute save rate. Prior mean, prior variance and walk are swept together, chosen on the pre-chip-tracking era and confirmed on the chip-tracking era, and tuned to maximize next-season predictive calibration ‚Äî how well a season-end posterior forecasts next season's realized conversion rate ‚Äî rather than only year-over-year rank stability. That is why both variances sit tight and both walks are small: a Bayesian posterior should be smoother than the raw rate it is drawn from, not noisier."]}),(0,a.jsx)("p",{children:"At each offseason boundary the raw posterior mean also shifts by a measured age-drift curve ‚Äî fit from within-player season-over-season conversion deltas in the pre-chip era and checked against the chip era ‚Äî applied at full strength for goalies and at half strength for shooters, since the filter already tracks a shooter's decline from their own shots and the full curve would double-correct. The shift lands before the offseason variance bump, so it moves a posterior that is still as tight as it was in April, not one already widened for the summer."})]}),(0,a.jsxs)(h.Section,{title:I("wxg"),id:"wxg",children:[(0,a.jsx)("p",{children:"Our headline shot-value stat, and ‚Äî after three seasons of trying to improve on it ‚Äî the plainest thing in the lineup. It is not a weighted blend of anything. It is expected goals, scored two different ways depending on which side of the ice you're looking at:"}),(0,a.jsx)(h.Formula,{lines:["xGF = shooter-adjusted xG   (credit for your own shooters)","xGA = shooter-adjusted xG   (debit for their shooters)","xG% = xGF / (xGF + xGA) \xb7 100"]}),(0,a.jsxs)("p",{children:["Those are variant selections, not coefficients ‚Äî xGF and xGA each pick a different one of the underlying xG model's outputs, rather than summing several of them together. Both sides are shooter-adjusted, symmetric. The alternative ‚Äî leaving the defensive side unadjusted, on the theory that adjusting xGA for opponents' shooter talent mostly imports strength of schedule rather than measuring defence ‚Äî does not hold up empirically: shooter-adjusting the defensive side performs about the same at all situations and 5v5, and meaningfully better on the penalty kill. It also has a real hockey story behind it ‚Äî a good defence works to deny dangerous shooters good looks, so someone worse ends up shooting, and shooter-adjusted xGA is the version that credits that suppression. All four variants also carry the season's scoring environment on top of the base shot-quality model, so a season with more (or less) offense league-wide is reflected the same way in every variant ‚Äî the (sh) / (sv) / (sh+sv) suffixes describe talent adjustments only. Full numbers are in the"," ",(0,a.jsx)("a",{href:"?tab=writeups&writeup=xg-star#weighted-shots-writeup",className:"text-accent hover:underline",children:"writeup"}),"."]}),(0,a.jsx)("p",{children:"The choice of variant comes down to one question: whose personnel does this adjustment encode, and do they persist? Shooter adjustment on xGF encodes your own shooters; on xGA it encodes theirs. Goalie adjustment on xGA encodes your own goalie; on xGF it encodes theirs. For a predictive use, keep personnel that persists and drop personnel that turns over ‚Äî goalies stick with a team, shooters and opponents don't. All four xG variants (shooter-adjusted, goalie-adjusted, fully-adjusted, and plain) stay on the site as opt-in columns; which one is right depends on what you're asking. Never judge a shooter against a baseline that contains his own finishing, and never judge a goalie against one that contains that goalie ‚Äî both are circular."}),(0,a.jsx)("p",{children:"One caveat worth keeping in view: a skater's own xGF is not purely a shot-generation number. Shooter adjustment is applied at the shot level using whoever actually took it, so a top line whose finisher scores on low-quality chances lifts the whole line's on-ice xGF ‚Äî including the playmakers who never touched the puck after the entry. Some of what looks like shot creation is a linemate's finishing talent riding along."}),(0,a.jsxs)("p",{children:["The name is worth separating from the metric. Tom Tango proposed"," ",(0,a.jsx)("a",{href:"https://tangotiger.com/index.php/site/comments/introducing-weighted-shots-differential-aka-tango",className:"text-accent hover:underline",target:"_blank",rel:"noopener noreferrer",children:"weighted shots"})," ","in 2014 as goals plus a flat one-fifth credit for every other attempt ‚Äî no shot quality at all. What ships under xGF and xGA here is not that: it is plain expected goals, unweighted, which outperforms every weighted-shots-style blend tested against it, including talent-adjusted versions built on top of this same xG model. For the full accounting, see the"," ",(0,a.jsx)("a",{href:"?tab=writeups&writeup=xg-star#weighted-shots-writeup",className:"text-accent hover:underline",children:"writeup"})," ","on the Writeups tab."]})]}),(0,a.jsxs)(h.Section,{title:I("net-rating"),id:"net-rating",children:[(0,a.jsxs)("p",{children:["A per-game ",(0,a.jsx)("em",{children:"Goals Above Average"})," rating built directly from Dom Luszczyszyn's published 2019 formula plus his recent confirmation of the offense / defense scaling factors. For the full walk-through ‚Äî formula derivation, position weights, worked example, and live decomposition charts ‚Äî see the"," ",(0,a.jsx)("a",{href:"?tab=writeups#net-rating-writeup",className:"text-accent hover:underline",children:"Net Rating writeup"})," ","on the Writeups tab."]}),(0,a.jsx)("p",{children:"Goalies skip all of this. Their Net Rating is GSAx ‚Äî goals saved above expected on the shooter-adjusted xG model, all strengths ‚Äî summed per game and projected to 84 games, which is how Dom rates them too. It is on the same goals scale as the skater number but built from a different quantity, so a goalie's +20 and a centre's +20 are not the same claim."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Step 1 ‚Äî split Game Score"}),(0,a.jsx)("p",{children:"Standard Luszczyszyn Game Score components are split into offense and defense. Faceoff differential (0.01 weight) is left out. We record every faceoff with both participants and publish faceoff percentage, but the term needs each player's wins minus losses per game, and we do not compute that. At a 0.01 weight the omission is small. A flat 0.01 per draw treats an offensive-zone and a defensive-zone draw alike, which matters in principle. Faceoffs are not ignored on the site: the Quick Draw badge rates a centre's draws against the opponents he faced, weighted by what each draw was worth, and that rating still correlates 0.93 with raw faceoff percentage, reordering almost nobody."}),(0,a.jsx)(h.Formula,{lines:["individual_off_gs = 0.75\xb7G + 0.7\xb7A1 + 0.55\xb7A2 + 0.075\xb7SOG + 0.15\xb7iPenDrawn","individual_def_gs = 0.05\xb7iBLK ‚àí 0.15\xb7iPenTaken"]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Step 2 ‚Äî on-ice play-driving (5v5)"}),(0,a.jsxs)("p",{children:["The 2019 overhaul replaced the 0.05\xb7CF / 0.15\xb7GF on-ice differentials with much heavier xGF / GF / xGA / GA terms, ramped per position. We measure each as the player's actual count this game minus what we'd expect for that TOI under a 50/50 mix of league and team rates per 60 (",(0,a.jsx)("em",{children:"relative-to-average"})," + ",(0,a.jsx)("em",{children:"relative-to-team"}),"):"]}),(0,a.jsx)(h.Formula,{lines:["expected_xgf  = (0.5\xb7league_xgf60 + 0.5\xb7team_xgf60) \xb7 TOI/3600","rel_xgf       = on-ice xGF this game ‚àí expected_xgf       (and same for gf, xga, ga)"]}),(0,a.jsxs)("p",{children:["One asymmetry: ",(0,a.jsx)("code",{children:"expected_xga"})," and ",(0,a.jsx)("code",{children:"expected_ga"})," ‚Äî the against-side pair only ‚Äî carry a further ice-time pace factor on top of the team-pace blend above, raising the expectation for players who play heavier minutes than their position average. See ‚ÄúQoC/QoT, retired‚Äù below for the constants and why only the against side gets it."]}),(0,a.jsx)("p",{children:"Position-specific weights from the 2019 article (Forwards / Defensemen):"}),(0,a.jsxs)("table",{className:"w-full text-sm mt-2 mb-3 border border-rule",children:[(0,a.jsx)("thead",{children:(0,a.jsxs)("tr",{className:"border-b border-rule-strong text-ink-faint text-[11px] tracking-wider",children:[(0,a.jsx)("th",{className:"px-3 py-2 text-left font-medium",children:"Position"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"xGF"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"GF"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"xGA"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"GA"})]})}),(0,a.jsxs)("tbody",{children:[(0,a.jsxs)("tr",{className:"border-b border-rule",children:[(0,a.jsx)("td",{className:"px-3 py-2",children:"Forward"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"0.625"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"0.625"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"1.75"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"0.4375"})]}),(0,a.jsxs)("tr",{children:[(0,a.jsx)("td",{className:"px-3 py-2",children:"Defense"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"1.7"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"0.425"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"2.3"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:"0.575"})]})]})]}),(0,a.jsx)(h.Formula,{lines:["on_ice_off_gs(F) =  0.625\xb7rel_xgf + 0.625\xb7rel_gf","on_ice_def_gs(F) = ‚àí1.75 \xb7rel_xga ‚àí 0.4375\xb7rel_ga","on_ice_off_gs(D) =  1.7  \xb7rel_xgf + 0.425 \xb7rel_gf","on_ice_def_gs(D) = ‚àí2.3  \xb7rel_xga ‚àí 0.575 \xb7rel_ga"]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Step 3 ‚Äî QoC/QoT, retired"}),(0,a.jsxs)("p",{children:["Through 2026-08 this step was a per-game multiplier ‚Äî credit nudged up when a player's opponents were heavier-minute than their teammates, trimmed when the opposite was true. The 2026-09 calibration sweep tested it three ways and found it predictively inert to slightly harmful, plus a face-validity failure (it charged stars for having good linemates). It has been removed. Full writeup, including what replaced it ‚Äî a narrower ice-time pace adjustment folded into Step 2's ",(0,a.jsx)("code",{children:"expected_xga"})," ","above, not a separate multiplier here ‚Äî is in ‚ÄúQoC/QoT, retired‚Äù in the Net Rating writeup. That test was of our multiplier only. A second, pre-registered test in 2026-09, of an offense/defense context adjustment built a different way, is described in the same section of the writeup; the rating still carries no quality-of-competition adjustment."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Step 4 ‚Äî final scaling"}),(0,a.jsx)("p",{children:"Subtract the position baseline (mean GS per game across F or D skaters with ‚â•10 GP that season), divide by total-GS-per-total-goals (‚âà 2.6, computed per season), and apply Dom's offense / defense scaling factors:"}),(0,a.jsx)(h.Formula,{lines:["Off_RTG (per game)  = (off_gs_game ‚àí pos_off_avg) \xd7 0.75 / (totalGS/totalGoals)","Def_RTG (per game)  = (def_gs_game ‚àí pos_def_avg) \xd7 0.78 / (totalGS/totalGoals)","Net_RTG (per game)  = Off_RTG + Def_RTG","Off/Def/Net_RTG     = Œ£ per-game values over the games","per 84              = Œ£ per-game values \xb7 84 / GP"]}),(0,a.jsxs)("p",{children:["Per-game ratings live on ",(0,a.jsx)("code",{children:"computed_stats"}),' (strength="all" row), so a rating over any stretch of games is the SUM of its per-game values. On the Skater Stats table Off_RTG, Def_RTG and Net_RTG are all such sums, so in Total mode Off_RTG + Def_RTG = Net_RTG; the Per 84 and Per 60 toggles scale all three alike, Per 84 by',(0,a.jsx)("code",{children:" \xd784/GP"}),", the length of a season from 2026‚Äì27 under the new CBA. Every season Net Rating on the site, on player and team pages, the cards, the lineups and the front page, is quoted in the same unit, goals per 84 games, so for a skater's full season the table's Per 84 Net_RTG and his season Net Rating are the same number. Until 2026-10-14 the season figures were quoted per 82; from then every value on the site, past seasons included, was the per-82 figure times 84/82, which moves no ranking, and since the 2026-10-19 rebuild the model itself computes per 84 (Œ£ \xd7 84/GP), so nothing is converted on the way out."]}),(null==x||null==(e=x.nr_per_season)?void 0:e.length)?(0,a.jsxs)(a.Fragment,{children:[(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Per-season distribution"}),(0,a.jsxs)("table",{className:"w-full text-sm mt-3 border border-rule",children:[(0,a.jsx)("thead",{children:(0,a.jsxs)("tr",{className:"border-b border-rule-strong text-ink-faint text-[11px] tracking-wider",children:[(0,a.jsx)("th",{className:"px-3 py-2 text-left font-medium",children:"Season"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"Skaters"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"Net_RTG/84 mean"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"Net_RTG/84 SD"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"Min"}),(0,a.jsx)("th",{className:"px-3 py-2 text-right font-medium",children:"Max"})]})}),(0,a.jsx)("tbody",{children:x.nr_per_season.map(e=>{var t,s,n,o,r,i,l,d;return(0,a.jsxs)("tr",{className:"border-b border-rule last:border-b-0",children:[(0,a.jsx)("td",{className:"px-3 py-2 font-medium",children:(0,h.fmtSeason)(e.season)}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:e.n_skaters.toLocaleString()}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:null!=(r=null==(t=e.mean_nr)?void 0:t.toFixed(2))?r:"-"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:null!=(i=null==(s=e.sd_nr)?void 0:s.toFixed(2))?i:"-"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:null!=(l=null==(n=e.min_nr)?void 0:n.toFixed(2))?l:"-"}),(0,a.jsx)("td",{className:"px-3 py-2 text-right tabular-nums",children:null!=(d=null==(o=e.max_nr)?void 0:o.toFixed(2))?d:"-"})]},e.season)})})]}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft mt-3",children:["The mean sits below zero in every season, and that is an artifact of how the table is built rather than a finding about hockey: the population is ",(0,a.jsx)("em",{children:"unfiltered"})," ‚Äî every skater who recorded a shift is in it, including several hundred a year on call-up minutes, and marginal players sit well below average by construction. Across sixteen seasons it stays between ‚àí2.2 and ‚àí3.6, wandering rather than trending, and there is no step at 2023-24 where the puck-tracking data begins."]}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft mt-2",children:["The spread is the part worth reading, and it is stable: the SD runs 9‚Äì12 across sixteen seasons with no trend, and the tails are intact throughout. Restricted to skaters with at least 20 games the means are far closer to zero",function(e){let t=z.map(t=>{var s;return null==(s=e.find(e=>e.season===t))?void 0:s.mean_nr_gp20}).filter(e=>"number"==typeof e);if(t.length!==z.length)return"";let s=e=>(e<0?"‚àí":"+")+Math.abs(e).toFixed(2);return" ‚Äî ".concat(s(t[0]),", ").concat(s(t[1])," and ").concat(s(t[2])," for 2023‚Äì24, 2024‚Äì25 and 2025‚Äì26")}(x.nr_per_season),". We cannot show a minutes-based column here at all: ",(0,a.jsx)("code",{children:"player_ratings.toi_5v5_seconds"})," is unpopulated in every row of every season and nothing writes it, so the restriction above is on games played."]}),(0,a.jsx)("p",{className:"text-sm text-ink-soft mt-2",children:"Those figures are for the sixteen complete seasons. While a season is still being played its row comes last and runs wider, because every rating in it is a per-84 rate on a handful of games. Cut 2025‚Äì26 at each skater‚Äôs first few games and the SD is 18.2 at three games, 15.7 at five, 13.6 at ten, 12.3 at twenty and 11.5 at forty-one, against 11.4 for the full season: the row narrows into the range above as the games accumulate."})]}):(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Caveats"}),(0,a.jsxs)("ul",{className:"list-disc ml-6 space-y-1 my-3",children:[(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Defensemen run slightly over-corrected"})," by the ice-time pace adjustment on ",(0,a.jsx)("code",{children:"expected_xga"})," ‚Äî Def now correlates +0.13 with TOI for defensemen, versus 0.00 for forwards. Within noise; being watched, not yet re-fit."]}),(0,a.jsxs)("li",{children:[(0,a.jsx)("strong",{children:"Team pace"})," (a team's overall xG production) is handled by the team-relative half of the ",(0,a.jsx)("code",{children:"rel_*"})," ","calculation in Step 2. ",(0,a.jsx)("strong",{children:"Individual ice-time pace"})," ","(a player's own minutes) is the separate against-side factor described in Step 3. They are two different adjustments; don't conflate them."]})]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"In four parts"}),(0,a.jsxs)("p",{children:["The Standard tab of Skater Stats can break Net Rating into four columns that add up to it, under ",(0,a.jsx)("strong",{children:"Net Rating parts"})," in the column picker. ",(0,a.jsx)("strong",{children:"Individual"})," is his own Game Score terms: goals, assists, shots, penalties drawn and taken, blocks."," ",(0,a.jsx)("strong",{children:"On-ice for"})," and ",(0,a.jsx)("strong",{children:"On-ice against"})," are the 5v5 xGF(sh) and goals for, and xGA(sh) and goals against, each against expectation. ",(0,a.jsx)("strong",{children:"Context"})," is the ice-time pace credit plus the penalty-kill context term. Each part is measured against the average skater at his position for that part, so the position baseline is split among them rather than standing apart. They are season sums like Off_RTG and Def_RTG: at Totals they add to Net_RTG, at Per 84 to his season Net Rating. Whole regular seasons at All situations only. The worked example in the Net Rating writeup lists every line behind them."]})]}),(0,a.jsxs)(h.Section,{title:I("net-rating-forecast"),id:"net-rating-forecast",children:[(0,a.jsxs)("p",{children:["A forecast of a skater's Net Rating, made before the first game and moved by every game after it. It starts from the last three seasons (each aged to this one and weighted by its games), pulled toward the average of players with that much history, and it hands over to the season's own games at a rate set by how much talent actually moves between seasons. Two numbers come out of it, kept apart on purpose: the ",(0,a.jsx)("em",{children:"talent"})," (the per-game rate we think he produces at, times 84) and the ",(0,a.jsx)("em",{children:"year-end projection"})," (the games already played plus the talent for the rest). The cards and the lineup print the year-end number with its 80% band, and the band is the predictive one: it allows for the noise of the games still to come, and it was checked against realised seasons. For the derivation, the holdout against the obvious baselines, the level check and its known misses, see the"," ",(0,a.jsx)("a",{href:"?tab=writeups&writeup=net-rating-forecast",className:"text-accent hover:underline",children:"Estimated Net Rating writeup"}),"."]}),(0,a.jsxs)("p",{children:["Goalies are not forecast here; the lineup card gives them their"," ",(0,a.jsx)("a",{href:"?tab=writeups&writeup=goalie-forecast",className:"text-accent hover:underline",children:"next-season forecast"})," ","GSAx, scaled to 84 games at the league's measured shots faced per game."]})]}),(0,a.jsxs)(h.Section,{title:I("shooting"),id:"shooting",children:[(0,a.jsx)("p",{children:"The Snipers report puts a shooter's goals next to their individual expected goals on each model and takes the difference:"}),(0,a.jsx)(h.DefinitionList,{items:[["iXG","Individual expected goals: the sum of xG over the player's own shots. The suffix names the model, same as on-ice xG. None for raw shot quality, (sh) shooter talent, (sv) goalie-and-context talent, (sh+sv) both."],["GAx","Goals minus iXG on the raw model. Finishing above what shot quality alone predicts; a good shooter should run positive here for a career."],["GAx(sh)","Goals minus iXG(sh). Finishing above what the shooter's OWN talent posterior and shot quality predict. This is the regression column: a large positive is a hot streak the model does not believe in, a large negative is a slump on a shooter it still rates."],["GAx(sv), GAx(sh+sv)","The same difference against the goalie-adjusted and fully adjusted models, for readers who want the goalies faced accounted for."]]}),(0,a.jsxs)("p",{children:["GAx is not GSAx with the sign flipped: GSAx uses the on-ice xGA a goalie faced, GAx uses only the shots the skater took. The shooter's talent posterior itself, the thing GAx(sh) is measured against, is not a column on the Skaters table. It has its own dashboard,"," ",(0,a.jsx)(i(),{href:"/ph-pro/coefficients",className:"text-accent hover:underline",children:"Shooter/saver talent"}),", with its uncertainty and the year of shots behind it."]})]}),(0,a.jsxs)(h.Section,{title:I("shot-types"),id:"shot-types",children:[(0,a.jsx)("p",{children:"The extra columns on the Skaters table. Each entry below is the same text as the column's header help, read from the table itself."}),(0,a.jsx)("h3",{className:"font-semibold mt-4",children:"Shot types and usage"}),(0,a.jsx)(P,{columns:O.HI}),(0,a.jsx)("h3",{className:"font-semibold mt-4",children:"Turnovers"}),(0,a.jsx)(P,{columns:O.s_}),(0,a.jsx)("h3",{className:"font-semibold mt-4",children:"Blocked shots"}),(0,a.jsx)(P,{columns:O.qh}),(0,a.jsxs)("p",{children:["How a block is valued is in the"," ",(0,a.jsx)(i(),{href:"/glossary?tab=writeups&writeup=blocked-shots",className:"text-accent hover:underline",children:"blocked-shots writeup"}),"."]})]}),(0,a.jsxs)(h.Section,{title:I("luck"),id:"luck",children:[(0,a.jsxs)("p",{children:["PDO is the oldest luck stat in hockey: on-ice shooting percentage plus on-ice save percentage. The league's adds to 100 by construction, and a skater far from it is usually riding, or fighting, the bounces. Its trouble is that it lumps three people together: the player, the teammates shooting beside him and the goalie behind him. The"," ",(0,a.jsx)(i(),{href:"/skaters?view=luck",className:"text-accent hover:underline",children:"Luck tab"})," ","pulls him out of it, then asks what his points would have been had his teammates finished like everyone else."]}),(0,a.jsx)(h.DefinitionList,{items:[["oiSH%, oiSV%, PDO","100 \xd7 GF \xf7 SF and 100 \xd7 (1 ‚àí GA \xf7 SA) while he was on the ice; PDO is the sum. The traditional numbers, him included."],["Tm SH%","100 \xd7 (GF ‚àí his goals) \xf7 (SF ‚àí his shots). His teammates' shooting percentage with him on the ice, his own shots taken out."],["Tm xGF",'On-ice xGF minus his own iXG, on the raw model: what league-average finishers would have scored on his teammates\' shots. No suffix, because nothing has been adjusted for: these are "normal" linemates.'],["Tm GAx, Tm dFSh%","Teammates' goals minus Tm xGF, as a count and per 100 of their unblocked attempts."],["Tm xGF(sh), Tm GAx(sh)","The same on shooter-talent-adjusted xG: his teammates at their own finishing talent. A big Tm GAx with a small Tm GAx(sh) means his linemates can really shoot; big on both means they ran hot."],["Own GAx","His goals minus his own iXG on the raw model: his own finishing, the other source of luck, shown apart."],["xA1, xA2, xA","His primary and secondary assists had his teammates scored Tm xGF instead of Tm GF, at his own rate of assists per teammate goal."],["xPts, xPts ‚àí Pts","His points with his own goals kept and his assists replaced by xA. Above zero, his linemates' finishing cost him points."],["xPts(sh), xPts(sh) ‚àí Pts","The same with his teammates at their own talent: the luck out, their real shooting left in."]]}),(0,a.jsx)(h.Formula,{lines:["T_G  = GF ‚àí iG                       teammates' goals","T_X  = c \xd7 (xGF ‚àí ixG)               at league finishing, c = league goals \xf7 league xG","a1   = (A1 + k1 \xd7 m1) \xf7 (T_G + k1)   his primary assists per teammate goal, shrunk","a2   = (A2 + k2 \xd7 m2) \xf7 (T_G + k2)   the same for secondary assists","xA   = A1 + A2 + (a1 + a2) \xd7 (T_X ‚àí T_G)","xPts = Pts ‚àí A + xA"]}),(0,a.jsx)("p",{children:"With no shrinkage, xA is simply his assists scaled by his teammates' expected goals over their real ones. The shrinkage is there for the small seasons: m is his position's rate (forwards or defencemen) in the same season and situation, and k is how many teammate goals of that average stand behind his own, measured from the spread of real assist rates. A season with no teammate goals reads at the position's rate, not 0 \xf7 0. The scale c is the league's own finishing in that season and situation, so league-average finishing reads zero in a year when the whole league shot cold."}),(0,a.jsx)("p",{children:"At All the tab counts even strength, the power play and the penalty kill, and leaves empty-net play out, because an empty-net shot carries no xG. Empty-net points he did score are kept in Pts and xPts as they are."}),_?(0,a.jsx)(W,{data:_}):null,(0,a.jsx)("p",{children:"What is not tested: that he would have assisted on his teammates' missing goals at his usual rate. That is the method's assumption, and the reason xPts is an estimate, not a fact."})]}),(0,a.jsxs)(h.Section,{title:I("fo-value"),id:"fo-value",children:[(0,a.jsx)("p",{children:"FO% says how often a centre wins the draw. FO value says what those wins were worth, in goals. A won draw is worth more in some places than others: an end-zone draw at five on five, a power-play draw in the attacking zone, a draw with the goalie pulled."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"What a win is worth."})," For every regular-season faceoff we count goals for minus goals against, from the side that won, in the 20 seconds after the drop, cut short by the next faceoff or the end of the period. The value of a win in each zone and strength is the average for the side that won minus the average for the side that lost, over five regular seasons (2021‚Äì22 to 2025‚Äì26, 370,890 draws). At five on five an end-zone win is worth about one goal per 63 wins, and a neutral-zone win about one per 193. A power-play win in the attacking zone is about one per 33, and a win with an extra attacker about one per 19. An offensive-zone win and a defensive-zone win are the same draw seen from opposite sides, so they share one value. Rare states (four on three, six on four) count as draws but are worth nothing. The table is fitted once and changes only when we refit it on purpose."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"A centre's FO value."})," His win rate is shrunk toward 50%: wins plus ",(0,a.jsx)("em",{children:"a"}),", over draws plus 2",(0,a.jsx)("em",{children:"a"}),", where"," ",(0,a.jsx)("em",{children:"a"})," is fitted each season from how widely the takers with 300 or more draws are spread. In the first weeks of a season, before 100 takers reach 300 draws, the five seasons' prior is used instead. FO value is that rate minus 50%, times the value of each draw he took, summed over the season."]}),(0,a.jsx)(h.Formula,{lines:["rate = (wins + a) / (draws + 2a)","FO value = (rate ‚àí 0.5) \xd7 Œ£ value of each draw he took"]}),(0,a.jsx)("p",{children:"It is a count in goals, like FOW. Total is the season, and Per 84 scales it by 84 over games played, like every count. At a strength filter it counts only the draws he took at that strength, read from his side the way FOW and FOL are, with the season's one win rate. It is computed after each night's games are final. Regular season, whole seasons only: it is blank on playoff views, with a date window, and for anyone who took no draws."}),(0,a.jsx)("p",{children:"It does not adjust for the man across the dot. It also gives the taker the whole draw, as the play-by-play does, including when a winger won the puck after the drop. It measures what the draws were worth, not how good the centre is."}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft",children:["Method: JP Gambatese,"," ",(0,a.jsx)("a",{href:"https://njdevilsadvocates.substack.com/p/what-is-a-faceoff-win-worth-quantifying",className:"text-accent hover:underline",children:"‚ÄòWhat is a faceoff win worth?‚Äô"})," ","(NJ Devils Advocates, 2026), reimplemented on Post Hockey's play-by-play. On the same five seasons our value table matches every goal value he published to within 0.0001 of a goal."]}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft",children:["This stat came from outside research. Have yours?"," ",(0,a.jsx)("a",{href:"/contribute",className:"text-accent hover:underline",children:"Send it to /contribute"}),"."]})]}),(0,a.jsxs)(h.Section,{title:I("penalties"),id:"penalties",children:[(0,a.jsx)("p",{children:"Some skaters hand their team several more power plays a season than others, and some give several more away. The Penalties columns on the Skater Stats Extras tab count them and set them against what a league-average skater would have drawn and taken in the same minutes."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"What counts."})," PenD is penalties drawn, PenT penalties taken: minors (a double minor once), majors other than fighting, match penalties and penalty shots. Fights and misconducts are left out: they seldom put either team on the power play. A penalty counts whether or not he was on the ice when it was called. A delayed call counts at the strength the game was actually at, not at the six on five of the pulled goalie."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Expected."})," xPenD and xPenT are his minutes times the same season's league rate for a skater of his position, forward or defenceman, in the same circumstances: the strength, home or away, the score (leading, tied or trailing by one or by two or more) and the period. All three move the rate. At five on five a skater leading by two or more takes about 40% more penalties than one trailing by one, the home side takes fewer and draws more, and the second period has the most calls. The rate is the season's own: the league's rate moves five to ten percent from one season to the next, and last season's rate missed by that much. During a season it is the season so far, recomputed after each night's games."]}),(0,a.jsx)(h.Formula,{lines:["xPenD = Œ£ his seconds \xd7 league drawn rate (F/D, strength, venue, score, period)","PenD vs exp = PenD ‚àí xPenD          PenT vs exp = xPenT ‚àí PenT","Pen+/- vs exp = PenD vs exp + PenT vs exp      (positive is good on all three)"]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"No role term."})," Depth players take more penalties a minute than top-line players do (bottom-third minutes: about 13% more than expected; top third: about 6% fewer). We leave that in. It is a real difference between players, not a fault in the baseline, so PenT vs exp favours the players who play the most minutes, and is meant to."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"How much is skill."})," At five on five a skater's penalties against expected repeat from one season to the next: the correlation is 0.58 for PenD vs exp and 0.64 for PenT vs exp. On the power play or the penalty kill alone it is 0.14 to 0.22, so the PP and PK views are shown but are mostly noise. Read them at All, ES or 5v5."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Where it applies."})," Every strength aggregate (All, ES, 5v5, PP, PK); a single state such as 5v4 shows ‚Äú-‚Äù. It follows the date window and the rate toggle like any count, and rows that pool seasons add up. Regular season, 2023-24 on."]}),(0,a.jsx)("p",{className:"text-sm text-ink-soft",children:"These are not the penalty counts Net Rating and Game Score+ read, which take every penalty called while he was on the ice, fights and misconducts included. GS+ also has its own penalty expectation, from last season's league rates and the player's own record, which is a different number from xPenD and xPenT; the GS+ writeup calls it the GS+ penalty expectation."})]}),(0,a.jsxs)(h.Section,{title:I("goalies"),id:"goalies",children:[(0,a.jsxs)("p",{children:["The Goalie Stats table has seven reports: Standard, Contact, Efficiency, Volume, Side, Shot type and Rebound. Efficiency is the rates and Volume the counts; the danger cells and the save-talent tiers have no report and are switched on in the column picker. As with xG, the suffix says what has been adjusted for: ",(0,a.jsx)("code",{children:"(sh)"})," shooter talent controlled,",(0,a.jsx)("code",{children:"(raw)"})," nothing controlled."]}),(0,a.jsx)(h.DefinitionList,{items:[["GSAx(sh)","xGA on the shooter-adjusted xG model ‚àí GA. Positive = stopped more than the shot-quality-and-shooter-talent model expected. The headline goalie number."],["GSAx(raw)","xGA on the raw (unadjusted) xG model ‚àí GA. The same idea without controlling for who was shooting."],["GSAx+","IQ-scaled (mean 100, SD 15) version of GSAx(sh), computed across the full league of goalies for the season (‚â•10 GP). 100 is league average; useful for comparing goalies across seasons of different shot-quality environments."],["Save talent","Latest Bayesian posterior mean for the goalie ‚Äî goalie-and-context talent, see the Shooter & goalie-and-context talent entry above ‚Äî on logit scale, relative to the active league and re-centred each season. Positive = above-average save rate given shot quality."]]}),(0,a.jsxs)("p",{children:["Goalies also get a per-player profile chart (",(0,a.jsx)("em",{children:"Implied Save Talent"}),") analogous to the shooter version, plotting the posterior mean \xb11œÉ ribbon over the games they've faced."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Stop rate"}),(0,a.jsx)("p",{children:"Fenwick save percentage instead of the traditional shots-on-goal save percentage ‚Äî it counts missed shots along with shots on goal, which is the more stable denominator and the one the rest of the site's on-ice numbers already use."}),(0,a.jsx)(h.DefinitionList,{items:[["Fsv%","1 ‚àí GA/FA. Actual Fenwick save rate, no model involved."],["xFsv%(sh)","1 ‚àí xGA(sh)/FA. What the shooter-adjusted xG model expected the goalie's Fenwick save rate to be, given the shots and shooters faced."],["dFsv%(sh)","Fsv% ‚àí xFsv%(sh). The same signal as GSAx(sh), expressed as a rate instead of a count ‚Äî positive means outperforming the shot-and-shooter-quality model."],["Fsv%(raw), xFsv%(raw), dFsv%(raw)","The same three, built on the raw (unadjusted) xG model instead."]]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Tiers"}),(0,a.jsx)("p",{children:"The Save talent column is a posterior mean; the walker also carries a posterior SD, and the Posterior and Tier columns (under Distribution in the column picker) draw the two together. Each row gets a small graph on one shared logit axis: a thick bar for the mean \xb11œÉ, a hairline for \xb12œÉ, a dot at the mean and a vertical tick at zero, the league mean. The letter is read off the \xb11œÉ interval [lo, hi] against that tick, where ‚Äúmostly‚Äù means more than three-quarters of the interval on one side:"}),(0,a.jsx)(h.DefinitionList,{items:[["A","Interval entirely above the league mean: lo > 0."],["B","Mostly above: lo ‚â§ 0 but the mean sits more than half an SD above zero (mean ‚àí œÉ/2 > 0)."],["C","Straddles: the mean is within half an SD of zero (|mean| ‚â§ œÉ/2)."],["D","Mostly below: the mean sits more than half an SD below zero, but hi ‚â• 0."],["F","Interval entirely below the league mean: hi < 0."],["SD","The posterior standard deviation itself, on the same logit scale as Save talent."]]}),(0,a.jsx)("p",{children:"A letter is a statement about confidence as much as ability: a starter with a long record and a C is genuinely average; a call-up with a C is unknown. The graph is there so the two are not confused."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Splits"}),(0,a.jsx)("p",{children:"Every shot a goalie faces can be sliced four ways at once, and each slice carries the same stop-rate triple as above: FA (the Fenwick shots in the cell), Fsv% (his actual rate on them), xFsv%(sh) (what the shooter-adjusted model expected) and dFsv%(sh), the difference -- positive is stopping more than the shots in that cell predicted."}),(0,a.jsx)(h.DefinitionList,{items:[["By danger","HD is a raw xG of ".concat(p.Rd," or more, LD is below ").concat(p.nM,", MD is everything in between.")],["By side (goalie's view)","Left and Right are more than ".concat(p.WV," ft off the centre line -- from the GOALIE's own point of view, not the shooter's -- and Middle is within ").concat(p.WV," ft either way.")],["By shot type","Tip and Deflection are their own canonical shot types; Straight is everything else -- wrist, snap, slap, backhand, wrap-around, poke, bat and shots simply typed ‚Äúother.‚Äù"],["By play","Rebound is a shot within ".concat(p.rA,"s of the same team's previous unblocked shot -- the xG model's rebound flag. Other is any shot that is not a rebound.")]]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"xReb"})," is the number of rebounds a league-average goalie would have allowed on the same saves, from a model fitted once on every complete regular season since 2010-11 (distance, angle, raw xG, shot type, strength, period, score state and danger band), with each season's level recalibrated so that RebAx sums to zero league-wide within a season; it is a comparison with that season's goalies, not across eras -- the league rebound rate recorded in the feed stepped from about 7.5% to 12% after 2021-22. ",(0,a.jsx)("strong",{children:"RebAx"})," is rebounds allowed minus xReb -- positive means he gave up more rebounds than the chances in front of him predicted. ",(0,a.jsx)("strong",{children:"Reb GSAx(sh)"})," is GSAx(sh) restricted to rebound-chance shots only."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Contact %"}),(0,a.jsxs)("p",{children:["Contact % asks a different question of the same shots: how often did the goalie get a piece of the puck? A ",(0,a.jsx)("em",{children:"contact"})," is a save, or a miss that he froze within two seconds. A ",(0,a.jsx)("em",{children:"failure"})," is a goal, or a post or crossbar that he did not freeze. A frozen post is left out, as is any shot from outside the offensive zone; the denominator, shown as Contact shots, is contacts plus failures. C% is contacts over that denominator, xC%(sh) is what the shooter-adjusted xG model expected it to be, and dC%(sh) is the difference. CAx(sh), contacts above expected, is the same difference in counts: the contact failures the shots predicted (from shooter-adjusted xG) minus the ones he allowed, so positive is good, like GSAx. It counts posts, so it is not goals saved above expected. Posts counts the unfrozen posts, xPosts is what the shots predicted from a model fitted once on complete seasons and recalibrated within each season, and Posts over xP is the difference: positive means he was beaten to the post more often than the shots predicted, which is worse. Shots from outside the offensive zone are left out, a change suggested to us before the test was run: about one shot in forty, and almost never a goal, so the in-zone ledger matched the original on repeatability and was the form whose carry-over among goalies who changed teams cleared zero once adjusted for shot quality. Tips and deflections stay in; leaving them out made it less repeatable."]}),(0,a.jsxs)("p",{children:["The idea is Aaron Knodell's (Puck Over the Glass, August 2026), who proposed it. Our replication found that it repeats from one year to the next better than save percentage and better than dFsv%(sh). The signal is in the posts, and it follows the goalie when he changes teams. The frozen misses are scorer behaviour, a property of the rink or the team rather than the goalie, and add nothing. One test did not come out. We pre-registered whether the whole metric's carry-over, among goalies who changed teams, could be told apart from zero, and at our 207 such pairs it could not across all situations; at 5v5, the situation the original article used, it could. Contact % is published on the overall evidence, by decision, not by the rule. Posts over xP did clear its own test among the goalies who moved. The full numbers are in ",(0,a.jsx)("code",{children:"backend/research/goalie_contact_pct.md"})," and"," ",(0,a.jsx)("code",{children:"backend/research/goalie_contact_pct_followup.md"}),"."]}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft",children:["This stat came from outside research. Have yours?"," ",(0,a.jsx)("a",{href:"/contribute",className:"text-accent hover:underline",children:"Send it to /contribute"}),"."]}),(0,a.jsx)("p",{children:"A column marked with an asterisk (*) is not proven to be repeatable at this table's sample size: split a goalie's games into odd and even halves, and one half did not predict the other beyond chance. Hover the header for the split-half correlation, its confidence interval, and the full-season reliability behind the star."})]}),(0,a.jsxs)(h.Section,{title:I("standings"),id:"standings",children:[(0,a.jsxs)("p",{children:["The ",(0,a.jsx)(i(),{href:"/standings",className:"text-accent hover:underline",children:"Standings"})," page prints four tables, one at a time. The record is what happened. The deserved columns ask what should have happened, if goals and the chances behind them were all that counted. The ratings are six answers to ‚Äúwho‚Äôs number one?‚Äù, and they disagree on purpose: each one decides differently what a win, a margin or a schedule is worth. Colley, Keener, Markov and the offense-defense rating are from Amy Langville and Carl Meyer‚Äôs"," ",(0,a.jsx)("em",{children:"Who‚Äôs #1? The Science of Rating and Ranking"})," (Princeton, 2012), and so is Massey‚Äôs least-squares method, of which the Simple Rating System, Sports-Reference‚Äôs, is the version without home ice. Elo is the sixth. The Consensus column is the plain average of the six ranks, not a seventh opinion. Early in a season Markov, which ranks teams on a handful of results, is withheld, and Consensus is the average of the other five. The chances are the season simulation‚Äôs: what is still to come."]}),(0,a.jsx)(h.DefinitionList,{items:v.i.map(e=>[e,v.P[e]])}),(0,a.jsxs)("h3",{id:"cup-chance",className:"font-serif text-xl mt-6 mb-2 scroll-mt-24",children:["Cup chance ",(0,a.jsx)(k.A,{className:"ml-1"})]}),(0,a.jsx)("p",{children:j.iC})]}),(0,a.jsxs)(h.Section,{title:I("selke"),id:"selke",children:[(0,a.jsxs)("p",{children:["The Selke Trophy goes to the league's best defensive forward, and the case for a candidate is usually a mix of eyeball, faceoffs, and penalty-kill minutes ‚Äî three things a box score reports and none of which is actually a defensive-impact number. This preset puts those alongside the one column on the site that is: ",(0,a.jsx)("strong",{children:"Def_RTG"}),", the defensive half of Net Rating."]}),(0,a.jsx)("p",{children:"Forwards only, sorted by Def_RTG. Faceoff win % (FO%, now filed under Extras rather than Identity) is draws won over draws taken, counted from the play-by-play at the table's strength, with the counts themselves beside it as FOW and FOL (none of it derived from Def_RTG or any xG model) ‚Äî it is on this preset because voters look at it, not because we think it measures shutdown play. PK TOI is minutes played shorthanded, another usage signal rather than an impact one; it now sits right next to TOI and the new PP TOI column, since all three are the same kind of number (minutes played, sliced by strength) rather than a faceoff stat. PP TOI ‚Äî minutes played on the power play ‚Äî isn't part of the Selke case, but it's built the same way as PK TOI and lives in the same column group for symmetry. Def_RTG is the column that answers whether the ice actually tilted the right way while they were out there."})]}),(0,a.jsxs)(h.Section,{title:I("qoc-qot"),id:"qoc-qot",children:[(0,a.jsxs)("p",{children:["There are ",(0,a.jsx)("em",{children:"two"})," QoC/QoT measures on this site, and they answer different questions. Keep them apart."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Competition (usage) ‚Äî how heavily the opposition is played"}),(0,a.jsxs)("p",{children:["TOI-based: for each player, compute the average game-level TOI% of their on-ice teammates and opponents across all 5v5 shifts they played, weighted by shift TOI when rolling up to (player, season). This is a ",(0,a.jsx)("em",{children:"deployment"})," proxy ‚Äî it measures how much a coach trusts the players you are on the ice against, not how good they are."]}),(0,a.jsx)(h.Formula,{lines:["toi_pct[player, game] = player_5v5_toi / sum(team skaters' 5v5 toi in game)","shift_qoc = mean(toi_pct of opponents on ice)","shift_qot = mean(toi_pct of teammates on ice)","season    = TOI-weighted mean of shift values"]}),(0,a.jsxs)("p",{children:["This is the usage measure that used to be folded into Net Rating as a per-game context multiplier, from launch through 2026-08 ‚Äî see ‚ÄúQoC/QoT, retired‚Äù in the Net Rating writeup for why that stopped in 2026-09. The measure itself is unaffected and still exported as a CSV at"," ",(0,a.jsx)("code",{children:"backend/exports/qoc_qot_<YYYYMMDD>.csv"})," for offline analysis."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Competition (Net_RTG) ‚Äî how good the opposition is"}),(0,a.jsxs)("p",{children:["A ",(0,a.jsx)("em",{children:"talent"})," proxy, and the axis the Shift Performance dashboard slides along. For each shift, average the season Net Rating of the opposing skaters on the ice; do the same over the player's own skaters for teammates. Goalies are excluded from both."]}),(0,a.jsx)(h.Formula,{lines:["rating[player, season] = mu + (net_rating - mu) * gp/(gp + 20)","shift_qoc = mean(rating of opposing skaters on ice)","shift_qot = mean(rating of own skaters on ice)"]}),(0,a.jsxs)("p",{children:["The input is plain Net Rating. Until 2026-09 it was a second column, net_rating_unadj, holding Net Rating with the QoC/QoT multiplier divided back out ‚Äî defining QoC in terms of a number that already contained a QoC adjustment would have been circular. With that multiplier retired the two were the same number, so the second column is gone. Ratings are ",(0,a.jsx)("strong",{children:"shrunk toward the season mean"})," by gp/(gp+20) before being averaged, because season Net Rating is a full-season projection: without shrinkage a four-game call-up projects to an absurd value and swings the QoC of every shift they appear in. QoC and QoT are on the same per-84 scale as the Net Rating published everywhere else; until the 2026-10-19 rebuild they were per 82 and read 2.4% smaller."]}),(0,a.jsxs)("p",{children:["Stored per shift in ",(0,a.jsx)("code",{children:"shift_qoc_facts"})," (its 5v5 part only, ~12.4M rows), which is what lets the Shift Performance dashboard re-aggregate a whole stat line from an arbitrary slice of shifts instead of re-fitting a model. The dashboard filters these ratings by ",(0,a.jsx)("strong",{children:"decile"})," ‚Äî ten equal-count bands of the season's 5v5 shifts, 1 the softest competition (or weakest teammates), 10 the hardest ‚Äî while the xG impact and WP impact forecasts cut the same ratings into ",(0,a.jsx)("strong",{children:"terciles"}),"over every 5v5, power-play and penalty-kill shift; same numbers, two grains. Both the shrinkage constant and the ‚â•3-of-5 rated-opponent coverage rule are provisional."]})]}),(0,a.jsxs)(h.Section,{title:I("implied-purpose"),id:"implied-purpose",children:[(0,a.jsxs)("p",{children:["A coach does not send five players over the boards without a reason. Down one with four minutes left you get your scorers; up one with thirty seconds you get your checkers. ",(0,a.jsx)("em",{children:"Implied purpose"})," is an attempt to read that intent off the game state ‚Äî what the bench was trying to do ‚Äî so that a shift can be judged against its own brief rather than against a league-average one."]}),(0,a.jsxs)("p",{children:["It is the filter on the Shift Performance dashboard, and it is an"," ",(0,a.jsx)("strong",{children:"inference, not a record"}),". Nobody publishes what the coach intended. One observable thing stands in for it: how lopsided the stakes are at the moment the shift starts, and again whenever the strength changes while it is out there. A shift that runs into a power play is read twice, once at five-on-five and once on the power play."]}),(0,a.jsx)(h.Formula,{lines:["wp = (dwp_for - |dwp_against|) / (dwp_for + |dwp_against|)","score = wp + 0.05 * lineup tilt (z, clipped) + 0.03 * zone start (OZ +1, DZ -1)","top third of all shifts -> attack;  bottom third -> defend;  middle -> balanced"]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Leverage."})," From the win-probability model: how much a goal for would help, set against how much a goal against would hurt, given the score, the clock, the strength state and any penalty time still to run. Late and trailing, a goal for is worth far more than a goal against costs, and the score goes positive. Protecting a lead inverts it. Tied in the first period the two are nearly equal and the score sits near zero."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Tiebreaks."})," Tied, the leverage term is exactly zero ‚Äî for a third of all shifts ‚Äî and thirds of a number that is mostly zero would just be the sign of the score. So two small terms break the tie: who the bench sent (the lineup‚Äôs offensive-minus-defensive tilt, as a league z-score) and where the puck was dropped. Together they are worth at most eight hundredths against a leverage term that runs from minus one to one, so they settle the label only where the game state does not."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Terciles."})," The three labels are the thirds of that score over every shift we have, all seasons together. The two cutoffs are fixed once and stored, so an ",(0,a.jsx)("em",{children:"attack"})," shift in 2011 means the same thing as one in 2026, and any one season lands a little off a third each way depending on how many close games it had. An earlier version weighted lineup and zone start at 30 and 15 percent and thresholded at a fixed value that called nine shifts in ten"," ",(0,a.jsx)("em",{children:"balanced"}),"; line composition is a consequence of intent, not a cleaner measure of it, and zone start is mostly circumstance, so both are now tiebreaks rather than signals."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"What it is not."})," It is not a measure of what happened ‚Äî a shift labelled ",(0,a.jsx)("em",{children:"attack"})," that gets scored on is still a shift that got scored on. It is context for judging the result, not the result. No outside source publishes coaching intent, so there is nothing to validate this against. Treat it as a lens, and a soft one."]})]}),(0,a.jsxs)(h.Section,{title:I("expected-wpa"),id:"expected-wpa",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The naming convention."})," ",(0,a.jsx)("em",{children:"Ax"})," means ",(0,a.jsx)("em",{children:"above expected"}),". GSAx is the borrowed public name ‚Äî goals saved above expected ‚Äî and GAx and SAx follow it: goals and success, each above what the context said to expect. The two shift-value numbers carry plain names instead. "," ",(0,a.jsx)("strong",{children:"xG impact"})," is expected-goal differential above what the context predicted; ",(0,a.jsx)("strong",{children:"WP impact"})," is win probability added above it. They were labelled xGAx and WPAx until October 2026, so an old link or post that says either one means these."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"xg-impact",children:"xG impact"})," is the plainer of the two shift-value numbers. Over the selected shifts, take the on-ice shooter-adjusted xG for minus against, and subtract what the league produces in the same contexts ‚Äî its xGF and xGA per second for the shift‚Äôs season, strength, zone start, score state, and terciles of competition and teammate quality, times the shift‚Äôs length. Per 60 it reads as goals per hour above the league in those spots. It is the same forecast as fWPA below, on the same context cell with the same fallback, valued in goals rather than wins ‚Äî which is what lets the Shift Performance page‚Äôs competition filter be read straight: a player facing top-tercile competition is scored against what the league does against top-tercile competition, not against the league‚Äôs average shift."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"On a game‚Äôs Lines tab"})," the expected side comes from the Linemates context model instead (below, under Linemates): per 5v5 stint, what a league-average five would produce from that zone start, at that score, with that implied purpose, against those five opponents‚Äô ratings, with all five of the team‚Äôs own skaters left out. A unit‚Äôs xG impact is its xG (sh) for above that plus its xG (sh) against below it, summed over its stints. Leaving the whole five out is what lets every row and column of the tab add up to its total; the price is that a line‚Äôs figure includes whichever defencemen it played with, which the With-whom view breaks out beside it."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"wp-impact",children:"WP impact"})," asks the question a bench actually cares about: what did the shift do to the team‚Äôs chance of winning, over what a league-average shift in the same spot would have done? Three numbers, all in wins, all summed over whatever shifts you select on the Shift Performance dashboard. They are on-ice numbers, like on-ice xGF: the team‚Äôs expected change in win probability while the player was out there, not divided among the five skaters who shared it. A shift that changes strength partway (a penalty, its end, a pulled goalie) is valued in pieces, each from its own start at its own strength."]}),(0,a.jsx)(h.Formula,{lines:["WP0  = win probability at the start of the shift, from this bench","xWP  = expected WP at the end, integrating over every chance that occurred","fWP  = forecast WP at the end, integrating over the chances the context predicted","xWPA = xWP - WP0     fWPA = fWP - WP0     WP impact = xWPA - fWPA"]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"What WP0 knows and does not."})," The win probability behind these numbers reads the score, the clock, the strength and the penalty time, and nothing about who is on the ice, so that a shift‚Äôs value cannot come from the model having already priced the players in it."," ","During a power play it reads how much of the man advantage is left."," ","What it leaves out, by design, is the team: a side leading by two in the first period on the power play wins about"," ","five"," points more often than the state alone says, because that side is usually the better team, and that share belongs to the pre-game number on the Games page, not to the shift."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The chances, not the goals."})," Each Fenwick shot inside the shift is a coin weighted by its shooter-adjusted xG. The end of the shift depends only on how many of those coins came up for each side, so the expectation is exact: two Poisson-binomial counts and a double sum, no sampling, no first-order shortcut. A shift with no shots still moves WP, because the clock ran in whatever score state it ran in."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The forecast."})," fWP does the same integration with the league‚Äôs expected-goal rates for and against in the shift‚Äôs context ‚Äî season, strength, zone start, score state, and the terciles of competition and teammate quality ‚Äî over the shift‚Äôs actual length. That last choice matters: both halves are valued at the same moment, so the value of time passing cancels in WP impact and nobody is credited for how long the coach left them out."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Reading it."})," xWPA is leverage-weighted by design: a chance in a tied third period is worth more than the same chance in a 5‚Äì1 game, and the win-probability model behind it carries the score, the clock, penalty time still to run and home ice. WP impact is the part the player‚Äôs shifts added over what league-average shifts would have, and WP impact/60 puts it per hour of ice. Positive means the shifts beat their brief."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Plain WPA."})," The dashboard also offers WPA/60, the shift valued at what actually happened: the win probability at the end of the shift from the goals that were scored in it, every goal counted, minus WP0. Nothing is forecast and nothing is taken off, so the clock is in it: a player whose team led while he was out banks the time that ran. WPA minus xWPA is the shift‚Äôs goals over its expected goals, priced in wins."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"impact-columns",children:"On the player page and the game log"})," the same numbers are optional columns, at 5v5, summed over a season or a game, positive good on each. ",(0,a.jsx)("strong",{children:"xG impact O"})," is the offence side: on-ice xGF (sh) above the league‚Äôs in the same spots. ",(0,a.jsx)("strong",{children:"xG impact D"})," is the defence side: the league‚Äôs xGA there above his on-ice xGA (sh); O plus D is xG impact. ",(0,a.jsx)("strong",{children:"WPA"}),", ",(0,a.jsx)("strong",{children:"xWPA"})," ","and ",(0,a.jsx)("strong",{children:"WP impact"})," are the shift values defined above, summed the same way, in wins."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Error bars."})," Shift Performance shows each number with a standard error: the spread of the per-shift residuals divided by the square root of the shift count, rescaled to per 60 by the mean shift length (for SAx, the binomial error on the success share). It treats shifts as independent draws and the league baseline as known, so it measures sample noise, not repeatability."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Why the bars shrink."})," A raw standard error is only what a player‚Äôs own shifts can tell you, and 150 minutes of shifts cannot tell you much: the \xb12 band on a fourth-liner reached the league leaders. So the number the page shows is a posterior. The league is the prior ‚Äî the selection‚Äôs mean, and the spread of its raw values once sampling noise is subtracted out (œÑ\xb2 = var(raw) ‚àí mean(SE\xb2), floored at 1% of the raw variance) ‚Äî and each player is pulled toward it by B = œÑ\xb2/(œÑ\xb2 + SE\xb2), the share of his own number that survives. Posterior mean Œº + B(raw ‚àí Œº); posterior sd ‚àöB \xb7 SE. The standard normal-normal empirical-Bayes estimator, nothing cleverer. A full-season player keeps four fifths of his raw value; the 150-minute player keeps a third, and his band collapses toward average, because his shifts said little and the league said a lot. The prior is estimated separately for forwards and defencemen, each toward his own group‚Äôs mean and spread, from every skater in that group who faced the selected QoC/QoT/zone/score/purpose context with at least twenty shifts ‚Äî the whole context, not just the rows the page happens to be showing. Filtering to forwards, to one team, or raising the minutes floor changes which rows are on screen and never what a player‚Äôs own number is: those are population filters, not context, and they are applied only after the shrinkage. The tooltip keeps the raw number."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Status."})," New, and next to SAx on purpose: the two are meant to be compared, and SAx (Success Above Expected, formerly SAE) is under review. Every number inherits the win-probability model‚Äôs calibration, which is checked by score state, period, strength and home ice before anything here is published."]})]}),(0,a.jsxs)(h.Section,{title:I("linemates"),id:"linemates",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Together."})," The Linemates page counts a unit‚Äôs minutes from ",(0,a.jsx)("em",{children:"stints"}),": stretches of the clock with nobody changing on either side and the strength unchanged. Every second of a period belongs to exactly one stint, so a line‚Äôs time together is an exact sum of whole stints, and a shot counts for the unit that was on the ice when it happened, by the same"," ",(0,a.jsx)("em",{children:"start < t ‚â§ end"})," rule the shift summaries use, over the same shots: unblocked attempts the xG model scores, with penalty shots left out as play at no strength (so a unit‚Äôs goals exclude penalty-shot goals). The page keeps 5v5 by count ‚Äî five skaters and a goalie a side. A line is the three forwards of a unit with exactly three forwards and two defencemen; a pair is its two defencemen; a stint with four forwards out belongs to neither. The ",(0,a.jsx)("em",{children:"Pick players"})," view takes any two to five skaters and every stint with all of them on."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The context columns."})," OZ% is offensive-zone faceoff starts over OZ plus DZ starts (a stint starts in a zone when a faceoff falls within two seconds of its first second; the rest are on the fly, and neutral-zone starts are left out of the ratio). Attack% is the share of the unit‚Äôs minutes whose stint began in an ",(0,a.jsx)("em",{children:"attack"})," state by implied purpose, scored for that bench from the real five on each side. QoC% ranks the TOI-weighted mean shrunk Net Rating of the opposing skaters among the season‚Äôs 5v5 stint-seconds ‚Äî 90 means harder competition than nine-tenths of the league‚Äôs ice time. QoT% ranks the partners outside the unit ‚Äî the two defencemen behind a line, the three forwards ahead of a pair, the rest of the five for a pick ‚Äî among the season‚Äôs stint-seconds of units of that kind."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Expected xGD/60."})," Per season, two weighted least-squares fits over the regular season‚Äôs 5v5 stints, each stint weighted by its seconds:"]}),(0,a.jsx)(h.Formula,{lines:["xGF/60 = a + zone + score + purpose + b_own * OWN' + b_opp * OPP'","xGA/60 = a + zone + score + purpose + c_own * OWN' + c_opp * OPP'","OWN' = sum over the team's five skaters of (shrunk Net Rating - league mean)","OPP' = the same over the five opposing skaters"]}),(0,a.jsxs)("p",{children:["Zone is OZ, DZ or NZ against on the fly; score is the five score states against tied; purpose is attack or defend against balanced; the league mean is the TOI-weighted mean skater rating of the season, and an unrated skater counts as the mean. A unit‚Äôs Expected is that fit with the unit‚Äôs own ratings ",(0,a.jsx)("em",{children:"left out"})," of OWN‚Äô ‚Äî what a league-average unit would produce with those partners, against those opponents, from those starts. ",(0,a.jsx)("strong",{children:"xG impact"})," is the unit‚Äôs actual shooter-adjusted differential minus Expected, in goals over all its minutes together, and per 60 with one standard error that treats each stint as an independent draw. It is not shrunk toward the league; sort by the total to let minutes count, or raise the floor. A season with under 400 games borrows the previous season‚Äôs coefficients while using its own ratings and mean. The fitted coefficients are printed under the table."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"What is checked."})," The fit reproduces the season‚Äôs totals and the zone, score and purpose margins by construction. What can fail, and is checked before a season is shown (",(0,a.jsx)("code",{children:"research/linemates_level_check.py"}),", aggregates in ",(0,a.jsx)("code",{children:"data/linemates/level_check.json"}),"): the residual by tercile of competition and of teammates and by decile of the own side‚Äôs rating sum must sit within three standard errors of zero. The page prints each season‚Äôs verdict from that file, a failure included. A fourth pre-registered rule, that lines with 400 or more minutes together may not sit more than half a goal per 60 above all lines, was retired by owner ruling 2026-10-13 as mis-specified: Expected is what a league-average unit would do in the same minutes, so the lines coaches keep together are supposed to beat it, and a talent leak into Expected would shrink that gap, not widen it. The gap is still printed. In its place, and reported rather than gated, is the calibration of Expected itself: actual minus Expected summed over every forward line, for the season and by tercile of OZ% and of QoC, both as is and with the lines‚Äô own ratings put back. The split-half repeatability of line xG impact/60, and the slope of a line‚Äôs residual on its own members‚Äô ratings (which should be near the fit‚Äôs own-rating coefficient, since the unit‚Äôs talent is left out of Expected on purpose), are measured and reported, not gated. Sequence is not cause: a unit that beats Expected did so in those minutes; the number does not say it will again."]})]}),(0,a.jsxs)(h.Section,{title:I("iwpa"),id:"iwpa",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"iWPA"})," ‚Äî individual win probability added ‚Äî is an accounting, not a forecast. Every goal, penalty and unblocked shot moves a team‚Äôs chance of winning by an amount the win-probability model reads off exactly, and so does every stretch of clock in between. iWPA hands each of those moves to the players who were part of it, by a fixed rule, so the credits of one game add up to exactly what happened in it: from the chance at puck drop to the result. Only a shootout stays with the team. Units are wins."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Who gets what."})," A goal for is split by rungs: scorer 5, first assist 4, second assist 3, every other skater on the ice 1, forward or defenceman alike. A penalty charges the player who took it and credits the player who drew it. The clock between events ‚Äî protecting a lead, killing a penalty ‚Äî is shared equally by the skaters on the ice, once each position‚Äôs measured share of the game‚Äôs chances is paid and handed back to the team. A shot‚Äôs chance is credited to the shooter and debited from the goalie, or the blocker on a block, as soon as it is taken ‚Äî both at a weight of 5 against 1 for everyone else on the ice. On a miss or a save each side pays its share back equally out of its clock, so the team‚Äôs total is unchanged while the shooter keeps his larger share. Beyond the chance, a shot is priced in two more stages: reaching the net, which belongs to the defending skaters equally; and on net to goal, which is the goalie‚Äôs alone and comes to his goals saved above expected, priced in wins. A shot blocked by an opponent is a save by a skater: the blocker is credited the shooter-adjusted expected goals of the shot, averaged over where it most likely came from, times what a goal would have meant, paid out of his own bench‚Äôs clock. A shot blocked by a teammate counts as a miss."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Reading it."})," iWPA describes who was on the plays that moved the game and how far each play moved it. It is weighted by leverage: a goal in a tied third period is worth far more than one in a 5‚Äì1 game. It does not say who will move the next one, and it is not a talent estimate. For that, read xG impact and Net Rating."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"What is not in it yet."})," Where a blocked shot came from is estimated by a model that fell short of its own pre-registered test; the writeup gives the numbers. Seasons start at 2023‚Äì24, the span the win-probability model was trained on; playoffs are out. The number is printed without an interval: it is a sum of observed events priced by one model, so the model‚Äôs checks are shown in the"," ",(0,a.jsx)(i(),{href:"/glossary?tab=writeups&writeup=iwpa",className:"text-accent hover:underline",children:"iWPA writeup"})," ","instead."]})]}),(0,a.jsxs)(h.Section,{title:I("badges"),id:"badges",children:[(0,a.jsxs)("p",{children:["A badge is a claim, not a compliment: that on his last"," ",null!=(o=null==(t=y[0])?void 0:t.window_games)?o:250," games, the newest weighing most, the player is one of the top ten percent of forwards, defencemen or goalies at the thing named. He earns it by standing in the top",y[0]?" ".concat(Math.round(100*(null!=(r=y[0].thresholds.top_share)?r:.1)),"%"):" tenth"," ","of his position group on the posterior score, and only if the probability that he really is a top-decile player at it clears",y[0]?" ".concat(y[0].thresholds.keep.toFixed(2)):" the keep line"," ‚Äî so a badge is never awarded on evidence too thin to support it, and it is kept while that probability holds. Where the evidence is thinnest ‚Äî a score whose error comes from his own game-to-game spread over fewer than"," ",null!=(u=null==(s=y[0])?void 0:s.thresholds.thin_window_games)?u:20," games ‚Äî the line is"," ",y[0]?y[0].thresholds.earn.toFixed(2):"even odds",", to earn and to keep, so a hot fortnight is not enough. Because the window runs across seasons, a badge carries into October and a strong start counts at once; a seal shows how long it has been held."]}),(0,a.jsx)("p",{children:"It was a probability line before a rank: a badge went to anyone at better than even odds of being top-decile. The probabilities were right ‚Äî they sum to about a tenth of every group, in every season ‚Äî but the share who cleared even odds tracked how precise the badge was rather than how many players deserved it. Minute Muncher, measured at 0.99, named a tenth of the league; Motor, resting on a component that replicates at 0.6, named four in a hundred. Same claim, same calibration, a badge that appeared three times rarer for a reason that had nothing to do with hockey. The rank came first from 2026-09-23, the probability stayed as the floor under it, and the earlier line is recorded here rather than hidden."}),(0,a.jsx)("p",{children:"There are three kinds, and the difference is drawn on the seal itself, because they are not the same sort of statement:"}),(0,a.jsxs)("dl",{className:"my-4 space-y-3",children:[(0,a.jsxs)("div",{className:"flex gap-3",children:[(0,a.jsx)(c.A,{badgeKey:"finisher",name:"Skill",state:"earned",kind:"skill",size:28,className:"shrink-0 mt-0.5"}),(0,a.jsxs)("div",{children:[(0,a.jsx)("dt",{className:"font-semibold text-ink",children:"Skill \xb7 an ink disc"}),(0,a.jsx)("dd",{className:"text-sm text-ink-soft",children:"A repeatable ability: something he does, that he does again. Every component behind a skill badge replicates at 0.5 or better when a season‚Äôs games are split in half at random, and that is the only kind gated on it. It is a claim about the player. It is not a claim that the thing helps: Beanbag holders block a lot of shots, reliably, and blocking runs with shots against."})]})]}),(0,a.jsxs)("div",{className:"flex gap-3",children:[(0,a.jsx)(c.A,{badgeKey:"hardminutes",name:"Role",state:"earned",kind:"role",size:28,className:"shrink-0 mt-0.5"}),(0,a.jsxs)("div",{children:[(0,a.jsx)("dt",{className:"font-semibold text-ink",children:"Role \xb7 a slate plate"}),(0,a.jsx)("dd",{className:"text-sm text-ink-soft",children:"How he has been deployed lately, or how he played it. A fact about his recent games rather than a claim about the man, so it is not gated on replication, and it claims nothing about whether it works. The deployment ones are measured against his own bench, because deployment is a coach dividing one team‚Äôs ice: Hard Minutes, Minute Muncher, Spearhead, Sentry and Iron Man all ask what share of something his team gave him. Enforcer is the exception, and it is the one that is style rather than deployment ‚Äî fighting, hitting, sitting in the box and being big are things a player does and is on any roster, so they are scored against the league. Some of them point the wrong way on purpose: Enforcer holders are outscored the following season."})]})]}),(0,a.jsxs)("div",{className:"flex gap-3",children:[(0,a.jsx)(c.A,{badgeKey:"tilter",name:"Outcome",state:"earned",kind:"outcome",size:28,className:"shrink-0 mt-0.5"}),(0,a.jsxs)("div",{children:[(0,a.jsx)("dt",{className:"font-semibold text-ink",children:"Outcome \xb7 a hollow ring"}),(0,a.jsx)("dd",{className:"text-sm text-ink-soft",children:"What happened with him on the ice, luck included. Not what he did, and not what he can do. An outcome badge is not expected to repeat ‚Äî that is what makes it an outcome ‚Äî so it is not gated on replication either. Scorer counts the goals; Finisher, a skill, is the claim about whether he should have had them. Ledger and Ice Tilter are the same pair in goals and in expected goals, and the gap between them is the luck."})]})]})]}),0===y.length?(0,a.jsx)("p",{className:"text-ink-faint text-sm italic",children:"Badge definitions did not load. Nothing else on this page depends on them."}):(0,a.jsx)("div",{className:"space-y-6 my-4",children:y.map(e=>(0,a.jsxs)("div",{className:"border border-rule rounded-sm p-4",children:[(0,a.jsxs)("div",{className:"flex items-center gap-3",children:[(0,a.jsx)(c.A,{badgeKey:e.key,name:e.name,state:"earned",kind:e.kind,size:32}),(0,a.jsxs)("div",{children:[(0,a.jsx)("div",{className:"font-semibold text-ink",children:e.name}),(0,a.jsxs)("div",{className:"text-xs text-ink-faint uppercase tracking-wider",children:[e.groups.join(", ")," \xb7 ",e.kind]})]})]}),(0,a.jsx)("p",{className:"mt-2 text-sm text-ink",children:e.sentence}),(0,a.jsx)(h.DefinitionList,{items:e.components.map(e=>[e.label,"weight ".concat(e.weight.toFixed(2)," \xb7 ").concat("a3z"===e.source?"All Three Zones":e.source," \xb7 ").concat(e.unit)])}),"held"===e.status&&(0,a.jsxs)("p",{className:"text-sm text-ink-faint mt-2",children:["Held, not published. ",e.held_reason]}),"in_progress"===e.status&&(0,a.jsx)("p",{className:"text-sm text-ink-faint mt-2",children:"Outcome, in progress."}),(0,a.jsx)("p",{className:"mt-2 text-sm text-ink-soft",children:e.claims})]},e.key))}),(0,a.jsxs)("p",{children:["The full account, with the validation tables and the correlations between badges, is in the"," ",(0,a.jsx)(i(),{href:"/glossary?tab=writeups&writeup=badges",className:"text-accent hover:underline",children:"badges writeup"}),"."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"One state, no tiers."})," Earned or not, never a letter grade, never a percentile bar. The top three in each badge and position group wear gold, silver and bronze, which is a rank among holders, not a grade. A percentile compresses the tails and invites reading a rank into a number that doesn‚Äôt support one; a badge is a yes-or-no claim with the evidence attached, and the shrinkage does the ranking‚Äôs job honestly."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Thresholds."})," ",y[0]?"The top ".concat(Math.round(100*(null!=(f=y[0].thresholds.top_share)?f:.1)),"% of the group, and ").concat(y[0].thresholds.keep.toFixed(2)," of probability to earn and to keep (").concat(y[0].thresholds.earn.toFixed(2)," where that rests on his own game-to-game spread over fewer than ").concat(null!=(g=y[0].thresholds.thin_window_games)?g:20," games)"):"The share and the confidence floor"," ","are the only chosen numbers in the whole system. Everything upstream of them ‚Äî the shrinkage, the posterior, the sample floor ‚Äî is fit, not picked. The floor is where a player‚Äôs own evidence starts to outweigh the position-group prior: below it, the badge is mostly describing the league, not the player, so it stays off rather than claim more than the shifts support."]})]}),(0,a.jsxs)(h.Section,{title:I("burst"),id:"burst",children:[(0,a.jsx)("p",{children:"NHL EDGE publishes three counts per skater-season: bursts that peaked at 18 to 20 mph, 20 to 22, and over 22, plus the ten fastest speeds of the season. Those are the top three bars of a histogram we never see the rest of. The player page turns them into one curve: how many times per 60 minutes of ice time the skater exceeds a given speed. Height at the left is how hard he skates (sprints over 18 per 60); reach to the right is how fast he is."}),(0,a.jsx)("p",{children:"In one sentence: we fit a distribution to each player's bursts (his EDGE counts above 18, 20 and 22 mph plus his ten fastest speeds), with one shared shape per position and a fitted speed level for each player, shrunk toward his position's average. The headline is his implied hourly burst: the top speed he reaches about once per 60 minutes of ice time."}),(0,a.jsx)("p",{children:"Our own speed figures are given in rink terms, not miles an hour: the seconds a skater at that speed takes to cross the neutral zone, 50 feet from blue line to blue line. 18 mph is 1.89 seconds, 20 is 1.70, 22 is 1.55, 24 is 1.42. Lower is faster. It is a flying start, the time at that speed, not a timed skate from a standstill. EDGE's own numbers, its 18, 20 and 22 mph bins and its max speed, stay in the league's miles an hour, since they are the league's."}),(0,a.jsx)(h.DefinitionList,{items:[["Hourly burst","The speed at which the fitted curve crosses once per 60 minutes of ice time: the pace he reaches about once per hour on the ice, shown as seconds blue line to blue line. EDGE's own max speed is the pace he reached once all season, a single reading; this is the same idea read from the whole season, and it is far steadier year to year."],["Sprints over 18 per 60","The three bins added up, per 60 of all-situation ice time. A role and effort figure as much as a skating one: forwards who sprint most tend to be energy-line forwards with fewer minutes and less power play."],["The fit","Each skater's burst peak speeds are treated as draws from a reversed Gumbel distribution, a bell with a light upper tail, which is what a physical top speed looks like. One width per position, fitted on 2021-22 to 2025-26; the skater sets only where the distribution sits, read from the ratio of his bins and from his ten fastest speeds, shrunk toward his position's mean. The alternatives were tried and rejected on one test: predicting the season's max and tenth-fastest speed from the bins alone, by decile. A Gaussian tail put the max a third of a mile an hour too high for every skater. A Generalized Pareto over 18 mph, the textbook model for speeds over a threshold, and a Weibull were later run through the same test season by season; neither beat it."],["Typical burst","The fit's location: his most common burst peak, shown as seconds blue line to blue line (the hover gives the mph). It is inferred, because EDGE sees only the bursts over 18 mph, so for most skaters it sits below 18 and is read off the shape of what shows above. The hover gives an 80% range."],["Burst spread","The fit's scale: how spread out a skater's burst peaks are around his typical burst. It is not his own. Every forward shares one, 2.8 mph for forwards, and every defenceman another, 3.1 mph for defencemen, fitted on the league; the data do not support a width per skater. The standard deviation of his burst peaks is about 1.28 times the scale: 3.6 mph for a forward, 4.0 for a defenceman."],["What is drawn","His curve with an 80% band, his three bin rates as circles at 18, 20 and 22 mph, and his ten fastest speeds as small dots placed at the rate they imply: the k-th fastest speed of a season is, by definition, a speed exceeded k times that season, so it sits at k per hours of ice. The grey bands hold the middle 20, 50, 80 and 96 percent of skaters at his position that season."]]}),(0,a.jsx)("p",{children:"Fast is not the same as good, and the two dimensions mean different things by position. For forwards the top end predicts controlled zone entries, rush shots and individual expected goals, while sprint volume predicts deployment. For defencemen it is the reverse: the ones who sprint often are the ones who carry the puck. Neither feeds Net Rating. Shown for skaters with at least two hours of ice in the season; the current season updates nightly."})]}),(0,a.jsxs)(h.Section,{title:I("edge"),id:"edge",children:[(0,a.jsx)("p",{children:"NHL EDGE is the league's puck-and-player tracking. These columns take its published zone time, zone starts and speed counts, plus what we build on them: expected zone time and on-ice xG(sh) per minute in each zone. Each entry is the column's own header help."}),(0,a.jsx)("h3",{className:"font-semibold mt-4",children:"Zone time and zone rates"}),(0,a.jsx)(P,{columns:O.kX,only:["edge_oz_pct","edge_nz_pct","edge_dz_pct","edge_oz_start_pct","edge_xgf_oz60","edge_xga_dz60"]}),(0,a.jsx)("h3",{className:"font-semibold mt-4",children:"Expected zone time"}),(0,a.jsx)(P,{columns:O.jb}),(0,a.jsx)("h3",{className:"font-semibold mt-4",children:"Speed and bursts"}),(0,a.jsx)(P,{columns:O.kX,only:["edge_bursts_18_20","edge_bursts_20_22","edge_bursts_22","edge_sprints","edge_burst_mu","edge_burst_speed","edge_burst_speed_pct","edge_max_speed"]})]}),(0,a.jsxs)(h.Section,{title:I("a3z"),id:"a3z",children:[(0,a.jsxs)("p",{children:["Hand-tracked by Corey Sznajder for a sample of each season‚Äôs games (about a third, 2021-22 onward). Licensed to us; shown only to active patrons of his Patreon, on the"," ",(0,a.jsx)(i(),{rel:"nofollow",href:"/a3z",className:"text-accent hover:underline",children:"All Three Zones"})," page. Every count is 5v5 and per player."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Two families, and they answer different questions."})," The"," ",(0,a.jsx)("em",{children:"expected box score"})," predicts what a player‚Äôs real NHL line should look like, and is calibrated against it. Everything below it counts what Corey‚Äôs tracking recorded. The two are not interchangeable: a pass he did not record cannot be credited to anyone, so the tracking-derived ",(0,a.jsx)("em",{children:"xG created"})," columns sit about a third below real assist totals by construction. That is a property of the data, not a flaw in it, and it is why these are separate sections rather than one."]}),(0,a.jsx)(h.DefinitionList,{items:d.v0.map(e=>[e.label,e.description])}),(0,a.jsx)("p",{children:"The expected box score is a full-season projection, so it does not change with the tracked/estimated toggle. Each cell shows an 80% interval containing the player‚Äôs real total about four times in five; the point estimate is on hover and is what sorts. It is left blank below five tracked games, where it runs about 15% high ‚Äî an empty cell rather than a number we know to be wrong."}),(0,a.jsx)(h.DefinitionList,{items:d.$Y.map(e=>[e.label,e.description])}),(0,a.jsx)(h.DefinitionList,{items:d.if.map(e=>[e.label,e.description])}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Special teams"})," are Corey‚Äôs power-play and penalty-kill counts, added at his request. They are tracked sums only, the same number under both views: no estimate exists for the games he did not track, and a per-60 there divides by the player‚Äôs or team‚Äôs tracked power-play or penalty-kill time, never 5v5 time. On the team tables a team‚Äôs power-play columns ",(0,a.jsx)("em",{children:"for"})," are over its own power-play time and ",(0,a.jsx)("em",{children:"against"})," over its penalty-kill time; the penalty-kill columns the other way round."]}),(0,a.jsx)(h.DefinitionList,{items:d.Al.map(e=>[e.label,e.description])}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Tracked games"})," are Corey‚Äôs raw counts over the games he tracked; per-60 and per-84 there are the player‚Äôs pace over those games only, and the",(0,a.jsx)("em",{children:" Tracked"})," and ",(0,a.jsx)("em",{children:"Cov\xa0%"})," columns say how many that was."," ",(0,a.jsx)("strong",{children:"Estimated season"})," adds a model‚Äôs expectation for the untracked games and reports an 80% interval; sorting uses the point estimate. Method and validation are in the"," ",(0,a.jsx)(i(),{href:"/glossary?tab=writeups&writeup=a3z",className:"text-accent hover:underline",children:"tracking-data writeup"}),"."]})]}),(0,a.jsxs)(h.Section,{title:I("shifts"),id:"shifts",children:[(0,a.jsx)("p",{children:"One row per shift segment: a player's shift, cut wherever his team's strength changes, so a shift that runs from five-on-five into a power play is two rows. Strength is read second by second from who is on the ice (from the play-by-play's situation code where a shift chart is incomplete), the same reading our time-on-ice by strength uses, so a pulled goalie counts the moment he leaves. Seasons before 2026-27 still hold the old rows, one strength per shift taken at its start, until they are rebuilt. The substrate the on-ice metrics are built on, and the foundation for implied purpose and win-probability-added. The schema:"}),(0,a.jsx)(h.Formula,{lines:["shift_id, game_id, player_id, team_id, period,","start_seconds, end_seconds, toi_seconds,","strength_state, zone_start, score_diff_at_start,","teammates_on_ice[], opponents_on_ice[],","cf_for, ca, ff_for, fa, gf, ga,","xgf_fully, xga_fully, xgf_*adj, xga_*adj,","xgf_shooter_adj, xga_unadj,","implied_purpose?, net_rating_delta?  // future"]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("code",{children:"zone_start"})," resolves by matching the segment's start (\xb12s) to the nearest faceoff event; if no matching faceoff,"," ",(0,a.jsx)("code",{children:'zone_start = "fly"'}),". Offensive or defensive depends on which end the team is attacking that period, which is read game by game from the play-by-play (its own zone codes, then shot locations) rather than assumed from the period number."," ",(0,a.jsx)("em",{children:"On-the-fly"})," changes are the majority (~57%); the rest split roughly evenly across NZ/OZ/DZ."]}),(0,a.jsxs)("p",{children:["See ",(0,a.jsx)("code",{children:"backend/docs/shift-pipeline.md"})," for the remaining planned extensions (net_rating_delta)."]})]}),(0,a.jsxs)(h.Section,{title:I("history"),id:"history",children:[(0,a.jsxs)("p",{children:["The ",(0,a.jsx)("a",{href:"/history",className:"text-accent hover:underline",children:"History"})," page carries three numbers that run back to 1917-18, each with a provenance a reader can check. None of them is a Post Hockey model; the point is to put the record's own measures on one table before the models arrive."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"point-shares",children:"Point shares"})," follow Justin Kubatko's method, published at Hockey-Reference, and are recalculated here from NHL game records. A team's points are split into an offensive and a defensive margin against a league baseline (the 7/12 and 19/12 of his construction, from six players on the ice with the goalie counting on defence only). Offensive point shares credit the offensive margin by ",(0,a.jsx)("em",{children:"goals created"}),", goals plus half of assists scaled to the team's own goals, against the ice time or games a player's position would be expected to produce from. Defensive point shares split the defensive margin by ice time (games before 1998-99), a position weight of 10/7 for defencemen and 5/7 for forwards, the team's shots against where recorded (1983-84 on), and a plus-minus term where recorded (1967-68 on). Goalies take two sevenths of the defensive margin by minutes and goals against. Summed over a roster the shares come within a few points of the team's total, which is the method's own check; the agreement with Hockey-Reference's series and the three places the recalculation had to depart from the raw record are stated in the page's methods section, with the numbers read from the validation files rather than typed."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"adjusted-scoring",children:"Adjusted scoring"})," rescales goals, assists and points to the modern scoring level and an 84-game schedule, so a 1981-82 season and a 2003-04 season can sit on one table. It is a scoring-level adjustment only: no roster-size factor, which is where Hockey-Reference's adjusted totals differ from these before 1982-83. ",(0,a.jsx)("em",{children:"Goals created"}),", adjusted the same way, is the weighted points column, with assists weighted so that a goal and its assists carry equal total credit in every era."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"tango-plus-minus",children:"Tango plus-minus"})," is the published linemate-adjusted on-ice number: goals for and against while on the ice with the linemates' share removed, in goals. The share removed (k) is set by position; on goals for it moves with the era, higher before 1990 when lines were not sorted by quality, and on goals against it is the same in every era. From 1959-60 to 2008-09 it is built from Hockey-Reference's on-ice totals, from 2010-11 on from the play-by-play; no on-ice source covers 2009-10, so that season is blank. It is a different thing from the weighted shots that share Tom Tango's name under xGF above."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{id:"historic-net-rating",children:"Net Rating on the History page"})," is the published rating from 2010-11 on and, from 1959-60 to 2008-09, our rating carried back before the play-by-play. Offence is a model fitted on the seasons we can measure, reading goals, assists, shots and on-ice goals. Defence starts from on-ice goals against with the linemates' share removed, pooled across the player's career, adds his share of the team's penalty kill, and for forwards takes back the part of a clean goals-against record that comes from offensive usage. Goals against an average player at his position that season, in total or per 84 games."]})]}),(0,a.jsx)("p",{className:"dateline section-rule mt-12 mb-2",children:"Colophon"}),(0,a.jsx)("p",{className:"text-sm text-ink-soft max-w-2xl",children:"Built on FastAPI + PostgreSQL, with the shot model fit by a hand-rolled penalised regression rather than an off-the-shelf one, and Next.js + Recharts on the front. Type set in Lora and Inter, with JetBrains Mono for tabular figures. Source available; this glossary renders live from the database, so the numbers above are the same ones the leaderboards use."})]})}function L(){return(0,a.jsxs)(h.Section,{title:"How it is built",id:"formula-lineage",children:[(0,a.jsx)("p",{children:"Net Rating starts from Game Score, a box-score credit for goals, assists, shots, blocks and penalties. It is split into an offensive half and a defensive half. Each half then adds an on-ice term: the shot chances (xG(sh)) and goals that happened with the player on the ice, compared with what we would expect for his team over his minutes. Forwards and defensemen carry different weights."}),(0,a.jsxs)("p",{children:["Each half is measured against the average game played at the same position, converted into goals, and projected to 84 games. The formulas and weights are in the"," ",(0,a.jsx)("a",{href:"#appendix",className:"text-accent hover:underline",children:"appendix"}),"."]}),(0,a.jsxs)("p",{className:"text-sm text-ink-soft",children:["This follows Dom Luszczyszyn's 2019 overhaul of his Game Score system,"," ",(0,a.jsx)("a",{className:"text-accent hover:underline",target:"_blank",rel:"noreferrer",href:"https://www.nytimes.com/athletic/1042672/2019/06/14/improving-our-nhl-projection-model-ahead-of-the-2019-20-season/",children:"published in The Athletic"}),", with the changes described below."]})]})}function q(){return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsx)("h3",{className:"font-serif text-xl mt-2 mb-2",children:"Step 1: Game Score split"}),(0,a.jsx)("p",{children:"Each player's per-game Game Score is divided into offensive and defensive components before any further scaling. The split uses Dom's published weights:"}),(0,a.jsx)(h.Formula,{lines:["individual_off_gs = 0.75\xb7G + 0.7\xb7A1 + 0.55\xb7A2 + 0.075\xb7SOG + 0.15\xb7iPenDrawn","individual_def_gs = 0.05\xb7iBLK ‚àí 0.15\xb7iPenTaken"]}),(0,a.jsx)("p",{children:"One known difference from Dom's 2019 update: it replaced individual shots with individual expected goals. We still use 0.075 per shot on goal, the weight from the model he updated. We tested the swap and kept shots. Unadjusted expected goals, weighted to keep the term the same size, predicted next season's goal differential no better within a position, including for players who changed teams, and predicted next season's points slightly worse. The 2019 article's own weights did worse: they pulled team ratings out of line with team goals (a team-sum slope of 0.78, against 0.87 now) and cost defencemen about three times what they cost forwards on points."}),(0,a.jsx)("p",{children:"The 0.01 faceoff term in classic Game Score is left out. We record every faceoff with its winner and loser and publish faceoff percentage, but the term wants each player's wins minus losses in each game, and we do not compute that per-game differential. It is a small term at a 0.01 weight. A flat 0.01 per draw treats an offensive-zone and a defensive-zone draw alike, which matters in principle. Faceoffs are not ignored on the site: the Quick Draw badge rates a centre's draws against the opponents he faced, weighted by what each draw was worth, and that rating still correlates 0.93 with raw faceoff percentage, reordering almost nobody."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Step 2: On-ice play-driving (5v5)"}),(0,a.jsx)("p",{children:"On-ice shot-quality numbers are converted to residuals by subtracting an expected value that blends league average and team pace in equal measure:"}),(0,a.jsx)(h.Formula,{lines:["expected_xgf = (0.5\xb7league_xgf60 + 0.5\xb7team_xgf60) \xb7 TOI/3600","rel_xgf      = on-ice xGF(sh) this game ‚àí expected_xgf      (same form for gf, xga, ga)"]}),(0,a.jsx)("p",{children:"Using the 50/50 blend anchors each player's baseline to their team's actual pace rather than a league-wide constant, which satisfies Dom's third adjustment. The same residual form is computed for raw goals-for, expected goals-against, and raw goals-against. Position-specific weights are then applied to these four residuals to combine them into an on-ice contribution score."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("code",{children:"expected_xga"})," and ",(0,a.jsx)("code",{children:"expected_ga"}),", the against-side pair only, carry one further scaling beyond the team-pace blend: an ice-time pace factor described under ‚ÄúWhat we changed from Dom‚Äù, which raises the expectation for players who play heavier minutes than their position average. ",(0,a.jsx)("code",{children:"expected_xgf"})," and ",(0,a.jsx)("code",{children:"expected_gf"})," are untouched by it."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Step 3: Per-game scaling and season aggregation"}),(0,a.jsx)("p",{children:"Individual and on-ice components are merged into per-game offensive and defensive ratings, then projected to an 84-game season:"}),(0,a.jsx)(h.Formula,{lines:["Off_RTG/g = (off_gs_game ‚àí pos_off_avg) \xd7 0.75 / (totalGS / totalGoals)","Def_RTG/g = (def_gs_game ‚àí pos_def_avg) \xd7 0.78 / (totalGS / totalGoals)","Net_RTG/g = Off_RTG + Def_RTG","Net_RTG (season) = Œ£ Net_RTG/g \xb7 84 / GP"]}),(0,a.jsxs)("p",{children:["The position baseline (",(0,a.jsx)("code",{children:"pos_off_avg"}),", ",(0,a.jsx)("code",{children:"pos_def_avg"}),") is the mean per-game Game Score across all forwards or all defensemen with at least 10 games played that season, computed separately for each side. Subtracting it converts raw Game Score into a value above average. Dividing by the league's Game Score per goal (the worked example shows the current value) translates the result into goal-denominated units. Dom's 0.75 and 0.78 scalars are applied to the offensive and defensive sides respectively, reflecting his finding that the defensive side required a modest upward adjustment to balance contribution. Each per-game rating is summed over all games played and then multiplied by 84/GP to project the cumulative total to a full season, 84 games being the NHL season from 2026‚Äì27. The pipeline stores the season figure that way, past seasons included, and the site shows it as stored."]})]})}let B="#14130f",H="#8c8675",K={top:34,right:12,bottom:38,left:12};function U(e){let t=arguments.length>1&&void 0!==arguments[1]?arguments[1]:1,s=Math.abs(e).toFixed(t);return e<0?"‚àí".concat(s):"+".concat(s)}function V(e,t){return e[Math.min(e.length-1,Math.floor(t*e.length))]}function Q(){let[e,t]=(0,n.useState)(null),[s,o]=(0,n.useState)(null),[r,i]=(0,n.useState)(!1);(0,n.useEffect)(()=>{(0,l.Yl)("skaters",20).then(e=>{if(!e.seasons.length)