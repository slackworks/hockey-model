jsxs)("p",{children:["The heat all but stops at the blue line. Blocked shots are almost never released from the neutral zone: on the replays, ",n?s$(n.beyond_true,1):""," of true releases were beyond it. The earlier version of this page put an average of up to ",s$(i,0)," of a block's probability there, depending on its distance from the net; the model now puts at most ",s$(r,2)," on average in any band, by weighting every spot past the line by ",s.zone.leak," before the rest is scaled up to fill the ice."]})}function av(e){let{d:t}=e,s=t.context.frozen;return s?(0,a.jsxs)("p",{className:"mt-3 text-sm text-ink-soft border-l-2 border-accent pl-3",children:[(0,a.jsx)("span",{className:"dateline text-accent",children:"Correction"})," An earlier version of this page put"," ",s$(s.beyond_share_all_blocks.a11dp,1)," of all blocked shots' origin probability beyond the blue line, where almost none of them start. The editor spotted it. It is now"," ",s$(s.beyond_share_all_blocks.ii,1),", and each block's value now carries a factor checked against the replays."]}):null}function aj(e){let{d:t}=e,s=t.context.stick;if(!s)return null;let n=s.examples.find(e=>e.example.startsWith("D near")),o=s.examples.find(e=>e.example.startsWith("F at the point"));return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Stick on stick"}),(0,a.jsxs)("p",{children:["Near the net the heat has two peaks. One is where shots from that spot are usually released. The other sits almost on the block point: the shot struck a stick or a shin the moment it left the blade. The model calls that a stick block, with a typical gap of"," ",s.median_ft.toFixed(1)," ft between release and block, and its chance falls with distance from the net",n&&o?(0,a.jsxs)(a.Fragment,{children:[": ",(100*n.pi_stick).toFixed(0),"% for a block ",n.dist_ft.toFixed(0)," ft out,"," ",(100*o.pi_stick).toFixed(1),"% at the point, ",o.dist_ft.toFixed(0)," ft out"]}):null,". The second peak is clearest on a defenceman's shot blocked near the net, where the usual release is far back; on a forward's it is a shoulder ahead of a lane peak only a few feet behind the block."]}),(0,a.jsxs)("p",{children:["That peak rests on thin evidence. What pins it down is ",s.n_censored_fit," replays out of"," ",s.n_fit," in which the block came within a single frame of the release, so the gap between them could not be measured, only bounded. Fit the model without those"," ",s.n_censored_fit," and the stick component turns into something else entirely. Read the near-net peak as the right shape, held up by little."]})]})}let ak=[["what-it-is","What the number is"],["who-gets-what","Who gets what"],["shots","Shots, in two stages"],["not-in-it","What is not in it"],["checks","What checks it"],["interval","Why there is no interval"],["predict","Does it predict?"],["ranking","How the front page ranks it"],["what-changed","What changed from v1"],["appendix","Appendix: the rules in full"]];function a_(){return(0,a.jsxs)("article",{id:"iwpa-writeup",className:"prose-paper",children:[(0,a.jsxs)("header",{className:"mb-10",children:[(0,a.jsx)("div",{className:"dateline",children:"Writeups \xb7 Player value \xb7 Methods"}),(0,a.jsx)("h1",{className:"font-serif text-5xl font-bold tracking-tight mt-2 mb-3",children:"iWPA: who moved the game"}),(0,a.jsx)("p",{className:"deck",children:"Every goal, penalty, shot and stretch of clock moves a team‚Äôs chance of winning. iWPA hands each move to the players who made it: a box score in wins, not a forecast."}),(0,a.jsx)(h.Byline,{})]}),(0,a.jsx)(h.Toc,{items:ak}),(0,a.jsxs)(h.Section,{id:"what-it-is",title:"What the number is",children:[(0,a.jsx)("p",{children:"Read the win-probability model at the instant before a goal and the instant after it, and the difference is what the goal was worth. Do that for every goal, every penalty and every shot, blocked or not, and for the clock running between them, and you have accounted for every point of win probability a team gained or lost in a game, from puck drop to the final result. iWPA is that account, split among the players."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"It is an identity, not a model."})," The only modelled input is the win-probability function itself. Everything else is a fixed rule written down before any number was computed. A team‚Äôs credits in a game sum to its result minus its chance at puck drop, to nine decimal places; the pricer stops if they do not. Only a shootout is left with the team, because nobody on the ice in regulation or overtime took it."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The bar is descriptive."})," iWPA says who was on the plays that moved the game and how far each play moved it. It is weighted by leverage ‚Äî a goal in a tied third period is worth many times one in a 5‚Äì1 game ‚Äî and that is the point of it. It does not say who will move the next game. For that, read xG impact and Net Rating."]})]}),(0,a.jsxs)(h.Section,{id:"who-gets-what",title:"Who gets what",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Goals for"})," are split by rungs, one rung per role: scorer 5, first assist 4, second assist 3, every other skater on the ice 1 ‚Äî forward and defenceman alike. Every share in a goal has the same denominator, so the order holds on every goal, not just on average. A goalie shares in a goal for only if he picked up an assist."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Goals against"})," are split the way any shot‚Äôs chance is, below: the goalie carries the debit at the shooter‚Äôs weight, every other skater on the ice an equal share; the rest falls to the stages below."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Penalties"})," charge the player who took the penalty and credit the player who drew it. Penalties called at the same second are priced together, so coincidentals cancel to zero, as they do on the ice."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The clock"})," is credited. Time passing while a team leads, a penalty running down, the horn: each stretch between line changes goes to the skaters on the ice, in equal shares, once an expectation (next) is paid and handed back. That pays the penalty killers and the players who protect a lead. It also pays a player for time spent ahead, which WP impact was built to cancel; under a descriptive bar that is the account, not a flaw in it."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Every credit above is weighed against an expectation."})," Each position‚Äôs share of the chances and goals at each strength (five-on-five, power play, short-handed, other) is measured from a complete season‚Äôs own games; while a season is still being played, or live, the shares from the season before it are used instead. A player is credited what happened to him minus his position‚Äôs share of what was expected in that stretch, and the team is paid the expectation back ‚Äî so a team‚Äôs total never moves, and each position nets to about zero across a season even though the direct roles above carry the heaviest single-event rungs. The numbers are in ",(0,a.jsx)("a",{href:"#what-changed",className:"text-accent hover:underline",children:"What changed from v1"}),", below."]}),(0,a.jsxs)(h.Why,{summary:"Why fixed rungs and not fitted weights",children:[(0,a.jsx)("p",{children:"A fit needs a target for the credited share to track. The only records of involvement are the scoresheet and the shift chart, and the rungs already use both. Any other target ‚Äî future on-ice goals, repeatability ‚Äî is predictive, which is the bar set aside. Tuning toward a predictive target and then calling the result descriptive is the thing this site‚Äôs name warns against."}),(0,a.jsx)("p",{children:"An earlier version of this rule weighted a forward above a defenceman on every goal and chance, two shares to one on offence and the reverse on defence. That weighting is gone: everyone off the direct roles gets the same share now, and a position‚Äôs running total is pulled back toward zero by the measured expectation above, not by a rung guessed to produce the right answer."})]})]}),(0,a.jsxs)(h.Section,{id:"shots",title:"Shots, in two stages",children:[(0,a.jsxs)("p",{children:["Every unblocked shot gets a ",(0,a.jsx)("em",{children:"W"}),": what a goal on that shot, in that game state, would have been worth. Its chance is credited and debited first; then two more things can happen to it, each priced on its own."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The chance."})," The shooter is credited the shot‚Äôs chance of scoring ‚Äî",(0,a.jsx)("em",{children:"p"})," times ",(0,a.jsx)("em",{children:"W"})," ‚Äî by the same rungs a goal‚Äôs finish uses below: the shooter at 5, everyone else on the ice at 1. The defending side is debited the same amount, the goalie carrying 5 and every other skater 1. On a miss or a save, each side pays its share back equally out of its own clock for that stretch of play, so the team‚Äôs total is unchanged but the shooter keeps his larger share and his linemates pay theirs; on the defending side the goalie carries the larger debit. A goal keeps the chance and adds the finish ‚Äî the remaining ",(0,a.jsx)("em",{children:"1‚àíp"}),"‚Äî by the goal rungs."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Reaching the net."})," A miss is a small win for the defence; a shot on net is a small loss. That part belongs to the defending skaters as a unit, split equally; the shooter and the goalie carry none of it. In the first version it was split in equal thirds between the shooter, the defending skaters and the goalie."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"On net to goal."})," The goalie‚Äôs alone. A save credits him the chance that shot would have scored, times ",(0,a.jsx)("em",{children:"W"}),"; a goal charges him the rest. Over a game it is his goals saved above expected on the shots that reached him, priced in wins."]}),(0,a.jsx)("p",{children:"A save, a miss or an unscored shot‚Äôs chance credit moves no real win probability, so these credits are paid for out of each team‚Äôs own clock credit for that stretch of play. The account still balances to the ninth decimal."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"The on-net rate, and what it costs"}),(0,a.jsxs)("p",{children:["The second stage needs the chance that a shot ",(0,a.jsx)("em",{children:"on net"})," scores, and our expected-goals model gives the chance that an ",(0,a.jsx)("em",{children:"unblocked"})," shot scores. Dividing one by the other needs an on-net rate. A per-shot on-net model was built and failed both of its pre-registered checks, so this version uses one number per season and strength: the rate that makes the expected goals on net equal the goals actually scored on net. In 2025‚Äì26 that is .6829 at five-on-five, .7292 on the power play, .8587 short-handed and .7249 otherwise."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The cost, stated plainly."})," Centring on each season‚Äôs own goals removes any real league-wide goalie deviation. If goalies as a whole stop more shots than expected-goals implies in a season, this rule reads it as calibration and takes it away. Goalies are ranked against each other only. That stands until a model of the whole shot ‚Äî blocked, on net, in ‚Äî replaces it."]}),(0,a.jsx)(h.Why,{summary:"The leftover by strength, and why it is not removed",children:(0,a.jsx)("p",{children:"The first stage is centred only where expected goals is level, and by strength it is not quite. In 2025‚Äì26 the shooter-adjusted model ran 1.3% short of goals at five-on-five and over on special teams. That is the expected-goals model‚Äôs level by strength. It now lands on the defending skaters through the reaching-the-net part, equally, and it is reported rather than rescaled away. Under the earlier split in thirds the residuals sat at |z| 3.0 (five-on-five), 5.1 (short-handed) and 5.3 (power play)."})})]}),(0,a.jsxs)(h.Section,{id:"not-in-it",title:"What is not in it",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Blocked shots are priced, by a model that failed its own test."})," A shot blocked by an opponent is a save made by a skater. The blocker is credited ",(0,a.jsx)("em",{children:"W"})," times the chance the shot would have scored from where it was struck: our shooter-adjusted expected goals, averaged over where the shot most likely came from, never read off the spot where it hit the shin pad. The money comes out of his own bench‚Äôs clock credit, so no team total moves; the shooter is not charged, and nobody is paid for finding a lane. A shot blocked by a teammate counts as a miss."]}),(0,a.jsxs)("p",{children:["Where the shot came from is estimated by a model trained on puck-tracking replays: a stick-on-stick release within a few feet of the block, more likely the closer the block is to the net, or a shot from well back along the lane, almost never from beyond the blue line. Each block‚Äôs value is then scaled by a factor for the shooter‚Äôs position and how far the block was from the net, fitted so the values match the replays. None of it passed a clean test: the origin model failed its pre-registered checks, the replays from 2025‚Äì26 were looked at again and again while it was built, and it was adopted as the owner‚Äôs call, because some credit for a block, with its limits printed, beats none. It is now frozen, and its test on 2026‚Äì27 replays is written down before any of them exist. How the origins are estimated is in the"," ",(0,a.jsx)("a",{href:"/glossary?tab=writeups&writeup=blocked-shots",className:"text-accent hover:underline",children:"blocked-shots writeup"}),"."]}),(0,a.jsxs)("p",{children:["In 2025‚Äì26 it prices 36,890 opponent blocks, worth 207.87 wins across the league. A block is worth 0.48 of an average unblocked attempt in expected goals; the lowest group, shots by defencemen at four-on-four, three-on-three and the like, comes out at 0.321."," ",(0,a.jsx)("strong",{children:"These block values are carefully estimated, not measured, and they have known biases near the net: blocks close in, by defencemen most of all, are probably under-credited."})," ","Blocks move 19% of player-season iWPA, against 10% to 12% for any reasonable choice of goal-credit rungs, and they move defencemen most. Which of the candidate models prices them matters far less: the adopted one against the one before it moves 2.9%. Esa Lindell led the league with 1.47 wins of block credit from 179 blocks, before his share of the clock that pays for it."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Seasons start at 2023‚Äì24"}),", the span the win-probability model was trained on, and the regular season only: the model has not been checked on playoff overtime, which is twenty minutes of five-on-five, not five of three-on-three."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The current season"})," is priced with its on-net rates so far, recomputed every night, blended with last season‚Äôs. Early in a season this year‚Äôs rates rest on a handful of goals, so each strength‚Äôs rate leans on last season and gives way as games are played: this season carries half the weight after 200 games, and a finished season is priced on its own rates alone."]})]}),(0,a.jsxs)(h.Section,{id:"checks",title:"What checks it",children:[(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"It balances."})," Every event, every stretch of clock and every game balances to nine decimal places, or the pricer stops. The largest team residual over 2025‚Äì26 was 2.2e-16."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The shares obey the rule"})," on every goal priced: scorer over first assist over second over on-ice forward over on-ice defenceman."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"The win probabilities it reads are level where it reads them."})," At every goal of 2023‚Äì24 to 2025‚Äì26 the model‚Äôs post-goal chance was compared with how often the team actually won, by score, period and strength: no cell with at least 1,000 goals missed by more than 3 points."]}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"One corner of the model is not."})," In the first period, with the team on the power play already up two, the win-probability model misses its own level check. iWPA reads that corner in well under 1% of its credit, but a shift there moves some player-seasons by up to 0.187 wins, and that failed the threshold set before measuring."]}),(0,a.jsx)("p",{children:"The model was checked again in October, game by game, against a candidate fix that treats a power play as the sum of its possible endings. Every cell passed under both models except this one. There the team on the power play won 4.95 points more often than the model in use said, and 4.08 more than the fix said, against the fix‚Äôs tolerance of 3.86, over 297 games. The fix closed 0.87 of those points and moved every other early power-play cell further from what happened, though all stayed inside their tolerance. Repricing iWPA under the fix moved no player-season by more than 0.406 wins, and season rankings correlated 0.9939 or better; no pass mark was set for that comparison in advance, so it is reported, not judged. The in-game curve rebuilt on the fix passed its own check."}),(0,a.jsx)("p",{children:"Our reading, which is a reading and not a measurement, is that most of the miss is team quality: a side already up two on an early power play is usually the better team, and the model is blind to who is playing on purpose. iWPA uses the model in use and is not adjusted inside the corner. That corner, and only that corner, is exempted from the check. The exemption lapses if a rerun fails any other cell, or finds this one missing by more than 4.95 points."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"Nothing falls through."})," Under 0.1% of goals in any season put any credit on a team row instead of a player, against a stop rule of 2%."]})]}),(0,a.jsx)(h.Section,{id:"interval",title:"Why there is no interval",children:(0,a.jsx)("p",{children:"The pledge says models print with an interval. iWPA prints a point. It is a sum of observed events, each priced by one model, and there is no sampling question to put a band around: the goals happened, the penalties were called. The uncertainty that matters is whether the win-probability model is right, and that is answered by the checks above, not by an interval. It is the same exception expected goals takes."})}),(0,a.jsxs)(h.Section,{id:"predict",title:"Does it predict?",children:[(0,a.jsx)("p",{children:"It was never meant to, and we checked anyway. Within 2025‚Äì26, each team‚Äôs schedule was split in half, and first-half iWPA per 60 was set against second-half on-ice goal share and points, beside WP impact and xG impact on the same split, for the 584 skaters with 200 minutes in each half. The iWPA in this comparison is priced without the credit for blocked shots; the iWPA we publish includes it."}),(0,a.jsxs)("p",{children:[(0,a.jsx)("strong",{children:"It predicts about as well as the shift numbers, and worse than plain shot share."})," ","Against second-half on-ice goal share in all situations, the correlation is 0.481 for iWPA, 0.521 for WP impact, 0.471 for xG impact and 0.578 for on-ice expected-goal differential. At five-on-five the same four read 0.279, 0.289, 0.299 and 0.417. A player‚Äôs first-half iWPA rate repeats in the second half about as well as WP impact‚Äôs does: 0.675 against 0.672."]}),(0,a.jsxs)(h.Why,{summary:"The team-level check, and why it says little",children:[(0,a.jsx)("p",{children:"Summed to the team, first-half iWPA per game correlates 0.421 with second-half points share. First-half points share itself manages 0.429. That is no coincidence: a team‚Äôs iWPA over a game is its result less its chance at puck drop, so at team level iWPA is the standings with the schedule taken out, and it predicts like the standings. Thirty-two teams make every one of these numbers wide."}),(0,a.jsx)("p",{children:"iWPA here is all situations only. A player-game carries no strength split, and the clock that pays for the shot stages crosses strength states, so a five-on-five iWPA would be a new definition, not a filter. Every figure in this section was measured on the shift tables as they stand after the October 1 recompute."})]}),(0,a.jsxs)("p",{children:["The result is reported, never a gate. Leverage adds noise about ",(0,a.jsx)("em",{children:"when"})," things happened, and that is the price of describing the game the way it was decided."]})]}),(0,a.jsxs)(h.Section,{id:"ranking",title:"How the front page ranks it",children:[(0,a.jsxs)("p",{children:["Goalies touch every shot, so their raw iWPA swings far wider than a skater‚Äôs: ranked by the raw number, goalies would take 70% of each night‚Äôs top five. So the front page ranks a player by how unusual his night was ",(0,a.jsx)("em",{children:"for his position"})," ‚Äî forwards against forwards, defencemen against defencemen, goalies against goalies ‚Äî and prints his real iWPA beside it. Ranked that way, goalies take 3.2% of the nightly top five."]}),(0,a.jsx)("p",{children:"Early in a season the yardstick borrows from last season and hands over as games are played: after 200 games the current season carries half the weight."}),(0,a.jsx)("p",{children:"The game pages‚Äô three stars use the same yardstick: the game‚Äôs top three by it, goalies included, each printed at his real iWPA. While a game is on, the game page prices it as it goes, by the same rule, from the league‚Äôs live feed, blocked shots included: those numbers are provisional, carry no stars, and use last night‚Äôs shooter and league estimates for expected goals; the overnight run prices the final game and replaces them."})]}),(0,a.jsxs)(h.Section,{id:"what-changed",title:"What changed from v1",children:[(0,a.jsx)("p",{children:"The rule before this one ‚Äî v1 ‚Äî weighted every goal and chance by position: a forward counted two shares to a defenceman‚Äôs one on offence, a defenceman two to a forward‚Äôs one on defence. Over 2025‚Äì26 it put defencemen at ‚àí164.4 wins as a group, against forwards‚Äô +126.2 and goalies‚Äô +32.0 ‚Äî a gap CJ asked to close, not by tuning the rungs again but by rethinking what they were for."}),(0,a.jsx)("p",{children:"CJ‚Äôs ask had three parts: a defenceman running far below a forward in the same job is a defect in the rule, not a fact about defencemen; ixG should work the way a goal already does, with the player in the most direct role ‚Äî the shooter, the goalie, the blocker ‚Äî carrying the most credit and everyone else on the ice sharing the rest equally; and whatever is left of a position‚Äôs running total after that should be indexed back to zero by measurement, not by another guessed rung."}),(0,a.jsx)("p",{children:"This rule follows from all three: the position rungs are gone, the role rungs (scorer, assists, shooter, goalie, blocker) are kept and extended to every shot, and each position‚Äôs long-run total is pulled back toward zero by the measured-share expectation described above. Over 2025‚Äì26 the same three groups come out at forwards +28.0, defencemen ‚àí32.1 and goalies ‚àí1.9 wins ‚Äî and it repeats better than v1 from one season to the next: forwards‚Äô year-over-year correlation rises from 0.634 to 0.720, defencemen‚Äôs from 0.405 to 0.536."})]}),(0,a.jsxs)(h.Appendix,{intro:"The rules as the pricer applies them. Open the drawer you want.",children:[(0,a.jsx)(h.Why,{summary:"Prices",children:(0,a.jsx)(h.Formula,{lines:["goal       d = WP(after) - WP(before), same second, home bench","penalty    d = WP(with this second's penalties) - WP(without)","clock      each stint between line changes: WP(end) - WP(start)","shot       W = |WP(after a goal here) - WP(before)|","           p = xG(sh),  r* = on-net rate (season x strength),  g = min(1, p / r*)","chance     +p W attacking / -p W defending (role rungs); a block uses v for p;","           funded by the clock unless it scores","stage 1    miss: +p W to the defence;  on net: -(g - p) W","stage 2    save: +g W to the goalie;   goal: -(1 - g) W","block      v = xG(sh) averaged over the estimated origins (A14, frozen) x position/band factor","stage 0    opponent block: +v W to the blocker"]})}),(0,a.jsxs)(h.Why,{summary:"Splits",children:[(0,a.jsx)(h.Formula,{lines:["chance for      shooter 5 / everyone else on the ice 1 (p W, or v W blocked)","chance against  goalie, or the blocker on an opponent block, 5 / everyone else 1","goal for        the chance above, plus the finish (1 - p) W: scorer 5 / A1 4 /","                A2 3 / everyone else on the ice 1","goal against    the chance above, plus stage 1 (g - p) W equally over the conceding","                skaters and stage 2 (1 - g) W to the goalie","stage 1         the defending skaters, equally (on a save or a miss, through their clock)","stage 0         the blocker (no blocker: the defending skaters, equally)","teammate block  a miss: the chance v W only, the goalie 5 on the debit","expectation     each position's measured share of a piece's chance-for and chance-against;","                paid back to the team on its on-ice skaters and goalie","clock           equal among on-ice skaters, after the stage and expectation credits it funds","penalty         committer charged, drawer credited, by minutes in the group"]}),(0,a.jsx)("p",{children:"A goal whose swing is negative for the team that scored it (a power-play goal at a big lead, where the penalty ending costs more than the goal gains) leaves the shot stages and keeps the plain split, so a goalie is never credited for conceding."})]}),(0,a.jsx)(h.Why,{summary:"Where every rule was decided",children:(0,a.jsxs)("p",{c