nal. ",(0,a.jsx)("code",{children:"is_rebound"}),", ",(0,a.jsx)("code",{children:"dist_x_angle"}),","," ",(0,a.jsx)("code",{children:"is_home"}),", ",(0,a.jsx)("code",{children:"own_net_empty"}),", and ",(0,a.jsx)("code",{children:"shot_angle"})," ","all sit at or below zero ‚Äî dropping any one of them would not measurably hurt the aggregate test score ‚Äî but all are retained for interpretability."]})]}):(0,a.jsx)("p",{className:"text-ink-faint",children:"Ablation data unavailable."})]})}function tj(){return(0,a.jsxs)(h.Section,{title:"Bayesian skill adjustment (EKF)",id:"xg-bayesian",children:[(0,a.jsxs)("p",{children:["The base model assigns a probability to every shot independent of who took it or who was in net. The Bayesian layer tracks each player's latent shooting talent, or goalie-and-context talent, as a running posterior on the logit scale, alongside a third posterior ‚Äî the league scoring environment"," ",(0,a.jsx)("code",{children:"E"}),", one number per season ‚Äî then folds all three into the final xG variants."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Chronological walk"}),(0,a.jsxs)("p",{children:["The scorer walks every shot the base model was trained on (the"," ",(0,a.jsx)("code",{children:"is_fenwick_for_xg"})," mask) in strict chronological order from 2010-11 through today, in a single pass. Talent posteriors carry across season boundaries and across the 2023-10-10 chip-era boundary. For each shot:"]}),(0,a.jsxs)("ol",{className:"list-decimal ml-6 space-y-1 my-3 text-sm",children:[(0,a.jsxs)("li",{children:["Read the ",(0,a.jsx)("em",{children:"current"})," posterior (Œº, œÉ\xb2) for the shooter, the goalie and ",(0,a.jsx)("code",{children:"E"})," ‚Äî no leakage."]}),(0,a.jsx)("li",{children:"Compute all four xG variants using those priors."}),(0,a.jsxs)("li",{children:["Update shooter, goalie and ",(0,a.jsx)("code",{children:"E"})," together using the (goal ‚àí pÃÇ) residual via the EKF step below."]})]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"EKF update equations"}),(0,a.jsx)(h.Formula,{lines:["p    = sigmoid(base_logit + E + Œº_shooter ‚àí Œº_goalie)","w    = p \xb7 (1 ‚àí p)                           ‚Üê Fisher information weight","","Shooter update:","  œÉ\xb2_new = 1 / (1/œÉ\xb2 + w)","  Œº_new  = Œº + œÉ\xb2_new \xb7 (y ‚àí p)             ‚Üê y ‚àà {0, 1}","","Goalie update (opposite sign ‚Äî saves are good):","  œÉ\xb2_new = 1 / (1/œÉ\xb2 + w)","  Œº_new  = Œº ‚àí œÉ\xb2_new \xb7 (y ‚àí p)","","Environment update (same residual, its own gain):","  œÉ\xb2_E,new = 1 / (1/œÉ\xb2_E + w)","  E_new    = E + œÉ\xb2_E,new \xb7 (y ‚àí p)","","Between shots (variance drift):","  œÉ\xb2 ‚Üê min(œÉ\xb2 + œÉ\xb2_walk, œÉ\xb2_max)            ‚Üê talent can change over time"]}),(0,a.jsxs)("p",{children:["This is an extended Kalman filter applied to a Bernoulli observation model. The Fisher information weight ",(0,a.jsx)("code",{children:"w = p(1‚àíp)"})," is largest for 50/50 shots and smallest for near-certain outcomes (empty nets, point-blank tap-ins), which correctly downweights the talent signal from those events ‚Äî and, per the gate above, empty-net goals, shootout attempts and penalty shots do not reach this update at all, since the base model never trained on them either."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Season-boundary centring"}),(0,a.jsxs)("p",{children:["Once per season boundary, shooter and goalie talent are re-centred: chance-weighted (by raw xG, in the odds domain ‚Äî a headcount mean would centre on the marginal fourth-liner rather than the shots that actually happen) over the trailing 365 days, the league's active shooters and goalies are made to net to zero. Whatever the centring removes is not discarded ‚Äî it is added into ",(0,a.jsx)("code",{children:"E"}),", so every probability already computed is unchanged at the instant of the re-frame. Within a season the frame is fixed, so a player's in-season trajectory reflects only their own shots, not a moving league average."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Asymmetric priors"}),(0,a.jsx)(h.DefinitionList,{items:[["Shooter Œº‚ÇÄ","‚àí0.05 ‚Äî a little below the chance-weighted average of active shooters"],["Shooter œÉ\xb2‚ÇÄ","0.02 ‚Äî SD ‚âà 0.14 logits; tight enough to keep next-season calibration honest, wide enough for a debutant's own shots to move him"],["Shooter œÉ\xb2_walk","1 \xd7 10‚Åª‚Åµ per shot taken"],["Goalie Œº‚ÇÄ","‚àí0.05 ‚Äî replacement level, relative to the chance-weighted active league"],["Goalie œÉ\xb2‚ÇÄ","0.0025 ‚Äî SD ‚âà 0.05 logits; still tight, goalies are shrunk hard until they prove otherwise"],["Goalie œÉ\xb2_walk","3 \xd7 10‚Åª‚Å∑ per shot faced ‚Äî treats goalie talent as near-static within a season"],["œÉ\xb2_max","0.5 ‚Äî variance cap prevents variance from growing unboundedly on inactive players"]]}),(0,a.jsx)("p",{children:"The goalie prior anchors to the environment term rather than an arbitrary zero, so Œº‚ÇÄ = ‚àí0.05 describes replacement level relative to the chance-weighted active league. It is checked by regressing next season's realized conversion rate on this season's end-of-season posterior ‚Äî the slope should run toward 1; it falls short, and the residual reads as context that does not persist (linemates, team defence) rather than an unmodeled dynamic. A sweep over prior mean, prior variance and walk, chosen on pre-chip seasons and confirmed on chip-era ones, landed on ‚àí0.05 / 0.0025 / 3 \xd7 10‚Åª‚Å∑ for goalies (‚àí0.05 / 0.02 / 1 \xd7 10‚Åª‚Åµ for shooters, above, after a second shooter re-tune in October 2026); tightening every knob together improved that slope, year-over-year stability and log-loss at once, because a Bayesian posterior should be smoother than the raw rate it is drawn from, not noisier."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Why shooters and goalies start in different places"}),(0,a.jsxs)("p",{children:["The asymmetry ‚Äî shooters seeded at league-average, goalies seeded at replacement-level ‚Äî reflects what the position is ",(0,a.jsx)("em",{children:"for"}),"."]}),(0,a.jsxs)("p",{children:["For a skater, finishing is a small slice of overall value. Most of what makes a forward or defenceman valuable lives in zone exits, defensive coverage, transition play, faceoffs, the chain of events that ",(0,a.jsx)("em",{children:"creates"})," ","the chance ‚Äî none of which the shooter-talent term tries to estimate. So when we encounter a new shooter (a debutant under 100 shots), the empirical evidence is: they convert 4‚Äì8% below the chance-weighted average of established shooters. That translated to a prior mean (Œº‚ÇÄ = ‚àí0.05), a little below league-average, with variance (œÉ\xb2‚ÇÄ = 0.02) tight enough to keep the posterior meaningful in-season, wide enough for a debutant's own shots to move him as they accumulate."]}),(0,a.jsxs)("p",{children:["For a goalie, save skill ",(0,a.jsx)("em",{children:"is"})," the position. There is no ‚Äúrest of the game‚Äù to make up for poor saving ‚Äî puck-handling and rebound control are second-order. So a goalie selected into NHL games is making the lineup because their save talent has already separated from the AHL pool. The population we observe is therefore not centered on league-average; it's centered slightly below the average ",(0,a.jsx)("em",{children:"established starter"}),", because emergency callups and third-stringers exist disproportionately in the small-sample tail. Seeding at Œº‚ÇÄ = ‚àí0.05 with a tight prior (œÉ\xb2‚ÇÄ = 0.0025) makes those callups demonstrate they belong instead of inheriting starter-caliber estimates from no evidence. After ~2,000 shots faced the posterior has moved enough for a real goalie to separate; below that the prior dominates, which is correct ‚Äî 500 shots cannot establish save talent."]}),(0,a.jsx)("p",{children:"We call this term goalie-and-context talent, not goalie talent: it is estimated from the shots a goalie faces, so it also picks up the team in front of him ‚Äî shot suppression, screens, defensive structure. About half of it is shared by both of a team's goalies in a season, and in our out-of-sample tests it added no measurable predictive value. Read every posterior below as goalie-and-context, not pure goaltending."}),(0,a.jsx)("p",{children:"The walk variance follows the same logic. Goalie-and-context talent is empirically sticky season-to-season ‚Äî career save% for elite goalies barely drifts ‚Äî so we treat it as near-static (œÉ\xb2_walk = 3e-7) and let a goalie's end-of-season posterior carry forward. Shooter finishing is noisier and more dependent on linemates and role, so a small but nonzero walk (œÉ\xb2_walk = 1e-5) lets the posterior breathe across a season."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Offseason bump at season boundaries"}),(0,a.jsxs)("p",{children:["The per-shot walk above models intrinsic talent drift while a player is"," ",(0,a.jsx)("em",{children:"active"}),". By itself, it gives zero extra variance during a 4-month offseason gap ‚Äî a player who took 200 shots across two seasons would accumulate the same total walk variance as one who took 200 shots in one season. But real talent does drift across an offseason: linemate and team changes, age, summer training, role and system changes. So when a player's ",(0,a.jsx)("code",{children:"season"})," changes between consecutive observations we apply a one-time additive bump to œÉ\xb2:"]}),(0,a.jsx)(h.Formula,{lines:["if season(this shot) ‚â† season(last shot for this player):","    œÉ\xb2 ‚Üê min(œÉ\xb2 + OFFSEASON_BUMP[kind], œÉ\xb2_max)","","OFFSEASON_BUMP_SHOOTER = 1 \xd7 10‚Åª\xb3    (~100 shots-worth of within-season walk)","OFFSEASON_BUMP_GOALIE  = 1 \xd7 10‚Åª‚Å¥    (~333 shots-worth)"]}),(0,a.jsxs)("p",{children:["The bump is ",(0,a.jsx)("strong",{children:"instant, not decaying"}),": measurement precision didn't change over the summer, but the latent itself has drifted during 4 months of no observations, and that drift has already happened by the time the first October shot arrives. The clean model is an instant variance jump, then œÉ\xb2 shrinks naturally as Fisher information accumulates from new shots. No decay constant to tune ‚Äî only the bump magnitude."]}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"No special treatment at the chip-era boundary"}),(0,a.jsx)("p",{children:"The walk variance above is the same on every date, before and after the 2023-10-10 move to chip tracking. Until October 2026 the walker added a transient boost there: an extra walk-variance term about thirty times the default, decaying with a 30-day time constant, on the reasoning that posteriors built on noisier pre-chip coordinates should be loosened so the more precise chip-era data could pull them into place quickly. We removed it after measuring it. On regular-season shots from 2023-12-08 through 2025-26 (289,698 of them, every arm scored on identical rows), the walker with the boost gained 0.00020 of log loss per shot over a base model with no talent in it; the same walker without the boost gained 0.00036; the paired difference, 0.00016 per shot, carries the same sign in each of the three seasons (two-way game-and-shooter clustered z 5.4). Widening every posterior at once threw away most of what thirteen seasons had established about each player and re-learned it from a few weeks of shots, and because talent variances tighten back only slowly, the noise persisted through the following seasons rather than fading after two months. The boost had also been tuned on year-over-year talent rank stability across the very seasons later used to evaluate the walker, so the stability it bought was not an out-of-sample result. Nothing before 2023-10-10 changed when it was removed: the boost was zero on every earlier date by construction."}),(0,a.jsx)("p",{children:"The two eras are still treated differently where the data says they differ: the base model is fitted separately per era, the league-environment term resets at the opener, and the arena-scorer adjustment stops after 2021-22. The talents themselves did not need re-learning."}),(0,a.jsx)("h3",{className:"font-serif text-xl mt-6 mb-2",children:"Aging drift"}),(0,a.jsxs)("p",{children:["The offseason bump says a player's talent gets less certain over a summer; it says nothing about which way it moves. Aging drift adds the direction: at each offseason boundary the raw posterior mean shifts by"," ",(0,a.jsx)("code",{children:"drift(age)"}),", a curve fit from within-player season-over-season deltas in goals over raw xG (shooters) and raw xG over goals-against (goalies), estimated on pre-chip seasons and checked against the chip era. The shift lands before the offseason variance bump ‚Äî the drift has already happened by the time the first October shot arrives, so it is applied to a posterior that is still as tight as it was in April, not to one already widened for the summer."]}),(0,a.jsx)("p",{children:"Goalies carry the curve at full strength; shooters carry it at half strength, because the filter already pulls a declining veteran's mean down from his own shots across a season, and the full aging correction on top of that self-correction overshoots. Both scales are checked the way the priors above are: goals over adjusted xG by age bucket should run flat, and the veteran buckets that ran high (goalies) or low (shooters) without the correction flatten toward 1.0 once the right scale is applied."})]})}function tk(e){let t=String(e);return"".concat(t.slice(0,4),"-").concat(t.slice(6,8))}function t_(){let[e,t]=(0,n.useState)(null),[s,o]=(0,n.useState)(!0);(0,n.useEffect)(()=>{(0,eV.W)("xg/environment.json").then(t).catch(()=>t(null)).finally(()=>o(!1))},[]);let r=e?e.seasons.map(e=>({label:tk(e.season),env_end:e.env_end})):[],i=e?Number(e.chip_boundary.slice(0,4)):null,l=i?1e4*i+(i+1):null,d=l?tk(l):null;return(0,a.jsxs)(h.Section,{title:"The league scoring environment",id:"xg-environment",children:[(0,a.jsx)("p",{children:"Only one thing is identifiable from a made or missed shot: the gap between the shooter's talent and the goalie's. A shot that goes in tells you something about the shooter relative to the goalie in the crease ‚Äî it says nothing about whether the league, taken as a whole, is a higher- or lower-scoring place than it was last year. Fold that ambiguity into the talent terms and it has nowhere honest to go; it drifts, silently, into whichever posteriors happen to update on it. So it doesn't go there. It is booked to its own term."}),(0,a.jsxs)("p",{children:["We call that term ",(0,a.jsx)("em",{children:"E"}),", the league scoring environment on the logit scale. It is learned one season at a time, from that season's shots only ‚Äî no look-ahead, no borrowing from seasons not yet played. Shooter and goalie talent are then centred, each season, so that the league's shooters, weighted by the chances they actually take, add up to no net goals relative to average. What's left in the talent terms is talent; what moves the league's general run of scoring moves E instead."]}),s?(0,a.jsx)("p",{className:"text-ink-faint",children:"Loading‚Ä¶"}):e?(0,a.jsx)("div",{className:"w-full h-[320px] mt-4",children:(0,a.jsx)(eo.u,{width:"100%",height:"100%",children:(0,a.jsxs)(eQ.b,{data:r,margin:{top:8,right:16,bottom:36,left:16},children:[(0,a.jsx)(ep.d,{strokeDasharray:"3 3"}),(0,a.jsx)(el.W,{dataKey:"label",tick:{fontSize:10},label:{value:"Season",position:"insideBottom",offset:-20,fontSize:11}}),(0,a.jsx)(eh.h,{tick:{fontSize:10},tickFormatter:e=>e.toFixed(2),label:{value:"E (logit scale)",angle:-90,position:"insideLeft",offset:10,fontSize:11}}),(0,a.jsx)(eu.m,{formatter:e=>e.toFixed(3),labelFormatter:e=>String(e)}),(0,a.jsx)(eg.e,{y:0,stroke:"#94a3b8",strokeDasharray:"4 4"}),d&&(0,a.jsx)(eg.e,{x:d,stroke:"#4a463d",strokeDasharray:"3 3",label: