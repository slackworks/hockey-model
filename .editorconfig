root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_size = unset
indent_style = unset

[*.{tla,cfg}]
indent_size = unset

# A webarchive is a binary property list, so no text rule applies to it.
[*.webarchive]
charset = unset
end_of_line = unset
indent_size = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
